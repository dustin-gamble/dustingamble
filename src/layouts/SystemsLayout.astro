---
import fs from "node:fs";
import path from "node:path";
import { ClientRouter, fade } from "astro:transitions";

const {
  title = "Gamble Systems",
  description = "A systems lab for prototypes, dashboards, and applied engineering tools.",
  ogImage = "/og-default.svg",
  type = "website"
} = Astro.props;

const inlineCss = fs.readFileSync(
  path.resolve(process.cwd(), "src/styles/global.css"),
  "utf-8"
);

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="view-transition" content="same-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <style is:global set:html={inlineCss}></style>
    <style is:global>
      .systems-body {
        font-family:
          "Space Grotesk",
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        line-height: 1.45;
        font-size: 1rem;
        background:
          radial-gradient(circle at 22% 18%, rgba(0, 210, 255, 0.22) 0, transparent 44%),
          radial-gradient(circle at 80% 30%, rgba(96, 165, 250, 0.16) 0, transparent 46%),
          radial-gradient(circle at 75% 80%, rgba(16, 185, 129, 0.12) 0, transparent 48%),
          linear-gradient(160deg, #050a13 0%, #0b1220 65%, #0a0f1a 100%);
      }

      .systems-body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image:
          linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
        background-size: 62px 62px;
        opacity: 0.18;
        mask-image: radial-gradient(circle at 30% 10%, black 0, transparent 72%);
      }

      .systems-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        padding-block: 1.2rem 2.4rem;
      }
    </style>

    <ClientRouter fallback="animate" />

    <script is:inline>
      // Default to dark the first time, but respect any stored preference.
      const saved = localStorage.getItem("theme");
      const theme = saved || "dark";
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body class="systems-body">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <main id="main-content" class="container systems-shell" transition:animate={fade()}>
      <slot />
    </main>

    <script is:inline>
      const toggle = document.getElementById("theme-toggle");
      if (toggle) {
        toggle.addEventListener("click", () => {
          const root = document.documentElement;
          const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
        });
      }
    </script>
  </body>
</html>

