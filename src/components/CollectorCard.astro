---
// Requirement 2's collector's-card template.
//
// This is the troop's own printed template, hosted here so a Scout who loses
// the paper can get another one without asking. It replaced an HTML rebuild I
// had made from a screenshot — the real artefact is better, and having two
// slightly different templates in circulation would have been worse than
// having one.
//
// Served three ways on purpose: the PDF is letter-size and is what you want
// for printing, the PNG is what the page shows and what a phone will open,
// and the print button prints the template on its own without the site around
// it.
const PDF = "/handouts/space-exploration-collector-card-template.pdf";
const PNG = "/handouts/space-exploration-collector-card-template.png";
---

<div class="cc">
  <div class="cc-top no-print">
    <div>
      <p class="cc-kicker">Requirement 2 · printable template</p>
      <h3>Collector's card template</h3>
      <p class="cc-lede">
        Print it, cut along the dashed lines, fill it in. Front: a picture of your pioneer. Back: who they
        were, what they did, why you picked them, and a few facts. Hand-drawn scores exactly the same as
        printed &mdash; the requirement asks for a picture on the front and says nothing about how it got there.
      </p>
      <p class="cc-lede">
        There is also room on the back for the <strong>four other pioneers</strong> you can discuss, which is
        the half of requirement 2 people forget.
      </p>
    </div>
    <div class="cc-actions">
      <a class="cc-btn" href={PDF} download>Print-ready PDF ↓</a>
      <a class="cc-btn cc-btn-alt" href={PNG} download>PNG ↓</a>
      <button type="button" class="cc-btn cc-btn-alt" data-cc-print>Print</button>
    </div>
  </div>

  <figure class="cc-sheet">
    <a href={PDF} download>
      <img
        src={PNG}
        width="1103"
        height="1426"
        alt="The Troop 308 collector's card template: a letter-size sheet with a Scout name, date and counselor line across the top, then two cut-out cards side by side. The front card has a large empty picture box with lines beneath for the pioneer's name and an optional nickname. The back card has lines for full name, born and died, country, known for, major mission or achievement, why I chose this pioneer, and three interesting facts, then a reminder box and four numbered lines for other pioneers to discuss."
        loading="lazy"
        decoding="async"
      />
    </a>
    <figcaption class="no-print">
      Troop 308 template &mdash; click the sheet to download the print-ready PDF.
    </figcaption>
  </figure>
</div>

<style>
  .cc {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1rem 1.15rem 1.1rem;
  }

  .cc-top { display: flex; gap: 1.2rem; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
  .cc-top h3 { margin: 0.1rem 0 0.4rem; font-size: 1.1rem; }

  .cc-kicker {
    margin: 0; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em;
    font-weight: 700; color: var(--accent-strong);
  }

  .cc-lede { margin: 0 0 0.5rem; font-size: 0.9rem; line-height: 1.6; color: var(--muted); max-width: 66ch; }
  .cc-lede:last-child { margin-bottom: 0; }

  .cc-actions { display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; flex: none; }

  .cc-btn {
    font: inherit; font-size: 0.8rem; padding: 0.3rem 0.75rem;
    border-radius: 999px; border: 1px solid var(--accent);
    background: var(--accent); color: #fff; cursor: pointer; text-decoration: none;
    white-space: nowrap;
  }

  :root[data-theme="dark"] .cc-btn { color: #0f1623; }
  .cc-btn-alt { background: transparent; color: var(--accent-strong); }
  .cc-btn:hover { filter: brightness(1.08); }

  .cc-sheet { margin: 1.1rem 0 0; text-align: center; }

  .cc-sheet img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, 46rem);
    max-height: 90vh;
    margin-inline: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    /* The template is drawn on white. On a dark page an unbacked PNG would
       sit in a glowing rectangle, so give it a paper-coloured mount. */
    background: #fff;
  }

  .cc-sheet figcaption { margin-top: 0.5rem; font-size: 0.8rem; color: var(--muted); }

  @media print {
    /* Print the template alone — no site chrome, no buttons, full page. */
    .cc { border: none; padding: 0; background: none; }
    .no-print { display: none !important; }
    .cc-sheet { margin: 0; }
    .cc-sheet img { max-width: 100%; max-height: 100%; border: none; border-radius: 0; }
  }
</style>

<script is:inline>
  (function () {
    function init() {
      var b = document.querySelector("[data-cc-print]");
      if (!b || b.dataset.wired) return;
      b.dataset.wired = "1";
      b.addEventListener("click", function () { window.print(); });
    }
    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
