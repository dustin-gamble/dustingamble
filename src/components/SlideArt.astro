---
// Named diagram motifs for slides that would otherwise be text only.
// Each is a small inline SVG built from the badge's own subject matter — no
// clip art, no decoration for its own sake. Referenced by `art: "name"`.
const { name } = Astro.props;
---

<div class="sart" data-art={name} aria-hidden="true">
  {name === "four-reasons" && (
    <svg viewBox="0 0 560 150" class="sart-svg">
      {["HISTORY", "KNOWLEDGE", "BENEFITS", "COOPERATION"].map((t, i) => (
        <g>
          <rect x={8 + i * 138} y="34" width="124" height="76" rx="10" class="a-box" />
          <text x={70 + i * 138} y="66" class="a-num">1{["a", "b", "c", "d"][i]}</text>
          <text x={70 + i * 138} y="90" class="a-lab">{t}</text>
        </g>
      ))}
      <path d="M8 20 H 544" class="a-rule" />
      <text x="8" y="14" class="a-tiny">REQUIREMENT 1 — WHY WE GO</text>
    </svg>
  )}

  {name === "spinoff" && (
    <svg viewBox="0 0 560 160" class="sart-svg">
      <circle cx="90" cy="82" r="48" class="a-fill" />
      <text x="90" y="78" class="a-lab a-mid a-inv">SPACE</text>
      <text x="90" y="96" class="a-tiny a-mid a-inv">program</text>
      {[
        ["Phone camera", 26], ["Memory foam", 56], ["Cordless tools", 86],
        ["Lens coating", 112], ["Water filters", 140]
      ].map(([t, y]) => (
        <g>
          <path d={`M140 82 C 196 82, 216 ${y}, 262 ${y}`} class="a-line" />
          <circle cx="262" cy={y} r="4" class="a-dot" />
          <text x="276" y={y + 4} class="a-lab-sm">{t}</text>
        </g>
      ))}
    </svg>
  )}

  {name === "third-law" && (
    <svg viewBox="0 0 560 160" class="sart-svg">
      <rect x="180" y="62" width="180" height="34" rx="17" class="a-box a-fill-soft" />
      <path d="M360 79 l -18 -9 v 18 z" class="a-fill" />
      <path d="M176 79 H 96 M120 70 l -24 9 l 24 9" class="a-arrow-b" />
      <path d="M364 79 H 470 M446 70 l 24 9 l -24 9" class="a-arrow-a" />
      <text x="96" y="58" class="a-lab-sm">gas thrown backward</text>
      <text x="470" y="58" class="a-lab-sm a-end">rocket pushed forward</text>
      <text x="270" y="84" class="a-lab a-mid">ROCKET</text>
      <text x="280" y="132" class="a-tiny a-mid">equal force · opposite direction · no air required</text>
    </svg>
  )}

  {name === "cannonball" && (
    <svg viewBox="0 0 560 190" class="sart-svg">
      <circle cx="280" cy="300" r="150" class="a-planet" />
      <rect x="266" y="142" width="28" height="12" rx="3" class="a-fill" />
      <path d="M294 148 q 74 8 100 60" class="a-traj-a" />
      <path d="M294 148 q 134 6 172 106" class="a-traj-b" />
      <path d="M294 148 a 152 152 0 1 1 -26 2" class="a-traj-c" />
      <text x="404" y="196" class="a-lab-sm">too slow — falls back</text>
      <text x="30" y="60" class="a-lab-sm">fast enough — the ground curves away as fast as you fall</text>
      <text x="280" y="186" class="a-tiny a-mid">Newton's cannonball</text>
    </svg>
  )}

  {name === "robotic-vs-crewed" && (
    <svg viewBox="0 0 560 170" class="sart-svg">
      <rect x="8" y="20" width="264" height="132" rx="12" class="a-box" />
      <rect x="288" y="20" width="264" height="132" rx="12" class="a-box a-fill-soft" />
      <text x="140" y="46" class="a-lab a-mid">ROBOTIC</text>
      <text x="420" y="46" class="a-lab a-mid">CREWED</text>
      {[["cheap", "expensive"], ["patient — decades", "hours of consumables"], ["expendable", "irreplaceable"], ["follows the plan", "improvises when it breaks"]].map(([l, r], i) => (
        <g>
          <text x="140" y={72 + i * 20} class="a-lab-sm a-mid">{l}</text>
          <text x="420" y={72 + i * 20} class="a-lab-sm a-mid">{r}</text>
        </g>
      ))}
    </svg>
  )}

  {name === "base-subsystems" && (
    <svg viewBox="0 0 560 175" class="sart-svg">
      <path d="M120 130 a 110 70 0 0 1 220 0 z" class="a-box a-fill-soft" />
      <path d="M120 130 H 440" class="a-ground" />
      <circle cx="230" cy="98" r="16" class="a-fill" />
      {[
        ["7a", "ENERGY", 470, 42], ["7b", "BUILD", 470, 74],
        ["7c", "LIFE SUPPORT", 470, 106], ["7d", "PURPOSE", 470, 138]
      ].map(([n, t, x, y], i) => (
        <g>
          <path d={`M336 ${Math.min(120, 60 + i * 18)} H 396 V ${y} H ${x - 8}`} class="a-line" />
          <text x={x} y={y + 4} class="a-lab-sm">{t}</text>
          <text x={x - 34} y={y + 4} class="a-num-sm">{n}</text>
        </g>
      ))}
      <text x="230" y="160" class="a-tiny a-mid">every base needs all four, and one of them fails first</text>
    </svg>
  )}

  {name === "build-order" && (
    <svg viewBox="0 0 560 124" class="sart-svg">
      {["Inventory", "Body", "Fins", "Lug", "Recovery", "Mass", "Finish"].map((t, i) => (
        <g>
          <circle cx={44 + i * 79} cy="52" r="20" class="a-box a-fill-soft" />
          <text x={44 + i * 79} y="58" class="a-num a-mid">{i + 1}</text>
          <text x={44 + i * 79} y="94" class="a-lab-sm a-mid">{t}</text>
          {i < 6 && <path d={`M${68 + i * 79} 52 H ${99 + i * 79}`} class="a-arrow-a" />}
        </g>
      ))}
      <text x="44" y="20" class="a-tiny">dry-fit everything before glue touches anything</text>
    </svg>
  )}

  {name === "go-nogo" && (
    <svg viewBox="0 0 560 150" class="sart-svg">
      <rect x="8" y="26" width="252" height="106" rx="12" class="a-go" />
      <rect x="300" y="26" width="252" height="106" rx="12" class="a-nogo" />
      <text x="134" y="56" class="a-lab a-mid">GO</text>
      <text x="426" y="56" class="a-lab a-mid">NO-GO</text>
      {[["fins solid", "fin moves under thumb"], ["lug slides free", "lug binds on the rod"], ["chute shakes out", "chute stuck with paint"], ["cone pulls by hand", "cone needs two hands"]].map(([g, n], i) => (
        <g>
          <text x="134" y={80 + i * 17} class="a-lab-sm a-mid">{g}</text>
          <text x="426" y={80 + i * 17} class="a-lab-sm a-mid">{n}</text>
        </g>
      ))}
      <text x="280" y="18" class="a-tiny a-mid">five days to fix anything on the right</text>
    </svg>
  )}

  {name === "predicted-vs-measured" && (
    <svg viewBox="0 0 560 170" class="sart-svg">
      <path d="M60 140 H 530 M60 140 V 20" class="a-axis" />
      <path d="M60 140 L 300 20" class="a-ideal" />
      <text x="306" y="26" class="a-tiny">perfect prediction</text>
      {[[110, 122], [156, 116], [198, 104], [244, 100], [288, 78], [330, 74], [372, 58]].map(([x, y]) => (
        <circle cx={x} cy={y} r="5" class="a-dot" />
      ))}
      <text x="300" y="162" class="a-lab-sm a-mid">predicted altitude &rarr;</text>
      <text x="18" y="80" class="a-lab-sm a-rot">measured &rarr;</text>
      <text x="400" y="120" class="a-lab-sm">almost everyone flies LOW</text>
      <text x="400" y="136" class="a-tiny">drag, paint, wind, rod tip-off</text>
    </svg>
  )}

  {name === "gate" && (
    <svg viewBox="0 0 560 120" class="sart-svg">
      {["Show up", "Pioneer card", "Safety quiz 8/10", "Signed form"].map((t, i) => (
        <g>
          <rect x={8 + i * 122} y="34" width="106" height="52" rx="9" class="a-box a-fill-soft" />
          <text x={61 + i * 122} y="56" class="a-num a-mid">{i + 1}</text>
          <text x={61 + i * 122} y="76" class="a-lab-sm a-mid">{t}</text>
          {i < 3 && <path d={`M${116 + i * 122} 60 H ${128 + i * 122}`} class="a-arrow-a" />}
        </g>
      ))}
      <rect x="516" y="34" width="36" height="52" rx="9" class="a-go" />
      <text x="534" y="68" class="a-emoji a-mid">🚀</text>
      <text x="8" y="22" class="a-tiny">clear all four, then you may order a rocket</text>
    </svg>
  )}

  {name === "timeline-series" && (
    <svg viewBox="0 0 560 110" class="sart-svg">
      <path d="M30 62 H 530" class="a-axis" />
      {[["Aug 31", "Why we go"], ["Sep 28", "How rockets work"], ["Oct 26", "Missions"], ["Nov 16", "Readiness"], ["Nov 21", "LAUNCH"], ["Nov 23", "Debrief"]].map(([d, t], i) => (
        <g>
          <circle cx={40 + i * 96} cy="62" r={i === 4 ? 9 : 6} class={i === 4 ? "a-dot-hot" : "a-dot"} />
          <text x={40 + i * 96} y="38" class="a-lab-sm a-mid">{d}</text>
          <text x={40 + i * 96} y="88" class="a-tiny a-mid">{t}</text>
        </g>
      ))}
    </svg>
  )}

  {name === "checklist" && (
    <svg viewBox="0 0 560 130" class="sart-svg">
      <rect x="140" y="12" width="280" height="106" rx="10" class="a-box" />
      {[0, 1, 2, 3].map((i) => (
        <g>
          <rect x="160" y={26 + i * 23} width="15" height="15" rx="3" class="a-box" />
          <path d={`M163 ${34 + i * 23} l 4 5 l 8 -10`} class="a-check" />
          <path d={`M188 ${34 + i * 23} H ${300 + (i % 2) * 60}`} class="a-writing" />
        </g>
      ))}
      <text x="140" y="130" class="a-tiny">nothing leaves the room unfinished</text>
    </svg>
  )}

  {name === "telemetry-trace" && (
    <svg viewBox="0 0 560 160" class="sart-svg">
      <path d="M50 130 H 530 M50 130 V 16" class="a-axis" />
      <path d="M50 130 C 78 92, 96 44, 128 26 C 168 8, 210 60, 250 92 C 290 122, 330 128, 380 129" class="a-traj-c" />
      <circle cx="128" cy="26" r="5" class="a-dot-hot" />
      <text x="136" y="22" class="a-tiny">apogee — ejection</text>
      <path d="M100 130 V 20" class="a-ideal" />
      <text x="56" y="16" class="a-tiny">burnout</text>
      <text x="300" y="112" class="a-tiny">descent under chute</text>
      <text x="290" y="152" class="a-lab-sm a-mid">time &rarr;</text>
      <text x="18" y="80" class="a-lab-sm a-rot">altitude &rarr;</text>
    </svg>
  )}

  {name === "packing" && (
    <svg viewBox="0 0 560 130" class="sart-svg">
      {[["Rocket", "🚀"], ["Motors", "🔥"], ["Shoes", "👟"], ["Water", "💧"], ["Hat", "🧢"], ["Chair", "🪑"], ["Card", "📋"]].map(([t, e], i) => (
        <g>
          <rect x={8 + i * 79} y="26" width="64" height="56" rx="9" class="a-box a-fill-soft" />
          <text x={40 + i * 79} y="60" class="a-emoji a-mid">{e}</text>
          <text x={40 + i * 79} y="100" class="a-lab-sm a-mid">{t}</text>
        </g>
      ))}
      <text x="8" y="18" class="a-tiny">range opens 8:30 — arrive with the rocket finished</text>
    </svg>
  )}

  {name === "careers" && (
    <svg viewBox="0 0 560 150" class="sart-svg">
      <circle cx="80" cy="76" r="34" class="a-fill" />
      <text x="80" y="72" class="a-lab-sm a-mid a-inv">ONE</text>
      <text x="80" y="88" class="a-lab-sm a-mid a-inv">JOB</text>
      {[["Training + education", 26], ["What it costs", 52], ["Is anyone hiring", 78], ["What it pays", 104], ["What you do all day", 126]].map(([t, y]) => (
        <g>
          <path d={`M118 76 C 170 76, 186 ${y}, 232 ${y}`} class="a-line" />
          <circle cx="232" cy={y} r="4" class="a-dot" />
          <text x="246" y={y + 4} class="a-lab-sm">{t}</text>
        </g>
      ))}
      <text x="80" y="140" class="a-tiny a-mid">requirement 8</text>
    </svg>
  )}
</div>

<style>
  .sart { margin: 0.2rem 0 0.9rem; }
  .sart-svg { width: 100%; max-width: 42rem; height: auto; display: block; overflow: visible; }

  .a-box { fill: none; stroke: var(--line); stroke-width: 1.6; }
  .a-fill-soft { fill: var(--accent-soft); }
  .a-fill { fill: var(--accent); }
  .a-planet { fill: var(--accent-soft); stroke: var(--line); stroke-width: 1.6; }
  .a-ground { stroke: var(--muted); stroke-width: 2; }
  .a-rule, .a-axis { stroke: var(--line); stroke-width: 1.4; fill: none; }
  .a-line { fill: none; stroke: var(--muted); stroke-width: 1.3; opacity: 0.75; }
  .a-dot { fill: var(--accent); }
  .a-dot-hot { fill: #c8532b; }
  .a-arrow-a { stroke: var(--accent); stroke-width: 1.8; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .a-arrow-b { stroke: var(--muted); stroke-width: 1.8; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .a-traj-a { fill: none; stroke: var(--muted); stroke-width: 1.8; stroke-dasharray: 4 4; }
  .a-traj-b { fill: none; stroke: var(--muted); stroke-width: 1.8; stroke-dasharray: 4 4; }
  .a-traj-c { fill: none; stroke: var(--accent); stroke-width: 2.2; }
  .a-ideal { fill: none; stroke: var(--muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .a-go { fill: rgba(61, 139, 88, 0.14); stroke: #3d8b58; stroke-width: 1.8; }
  .a-nogo { fill: rgba(200, 83, 43, 0.12); stroke: #c8532b; stroke-width: 1.8; }

  .sart text {
    font-family: "Space Grotesk", system-ui, sans-serif;
    fill: var(--text);
  }

  .a-lab { font-size: 15px; font-weight: 700; }
  .a-lab-sm { font-size: 12.5px; }
  .a-tiny { font-size: 10.5px; fill: var(--muted); letter-spacing: 0.04em; }
  .a-num { font-family: ui-monospace, monospace; font-size: 15px; font-weight: 700; fill: var(--accent-strong); }
  .a-num-sm { font-family: ui-monospace, monospace; font-size: 11px; font-weight: 700; fill: var(--accent-strong); }
  .a-mid { text-anchor: middle; }
  .a-end { text-anchor: end; }
  .a-inv { fill: #fff; font-weight: 700; }
  :root[data-theme="dark"] .a-inv { fill: #0f1623; }
  .a-check { fill: none; stroke: #3d8b58; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .a-writing { stroke: var(--line); stroke-width: 2; }
  .a-emoji { font-size: 24px; }
  .a-rot { transform: rotate(-90deg); transform-origin: 18px 80px; text-anchor: middle; }

  @media (max-width: 640px) {
    .a-lab { font-size: 18px; }
    .a-lab-sm { font-size: 15px; }
    .a-tiny { font-size: 13px; }
  }
</style>
