---
const {kind='world',id='space'}=Astro.props;
const uid=`hero-${id}`;
---
<div class="lesson-hero" aria-hidden="true" data-hero={kind}>
<svg viewBox="0 0 620 520">
<defs><radialGradient id={`${uid}-planet`} cx="28%" cy="20%"><stop stop-color="#4bb9c8"/><stop offset=".42" stop-color="#236280"/><stop offset="1" stop-color="#081322"/></radialGradient><linearGradient id={`${uid}-metal`}><stop stop-color="#6a829d"/><stop offset=".42" stop-color="#f3faff"/><stop offset="1" stop-color="#6c839d"/></linearGradient><linearGradient id={`${uid}-flame`} x1="0" x2="0" y1="0" y2="1"><stop stop-color="#fff7cb"/><stop offset=".3" stop-color="#ffa774"/><stop offset="1" stop-color="#ff7859" stop-opacity="0"/></linearGradient></defs>
{Array.from({length:48},(_,i)=><circle cx={(i*137+17)%610} cy={(i*73+19)%510} r={i%7===0?1.7:.8} fill="#b5d9f0" opacity={i%3===0?.5:.2}/>)}
{kind==='world'&&<>
 <ellipse cx="310" cy="259" rx="267" ry="113" transform="rotate(-25 310 259)" fill="none" stroke="var(--accent)" opacity=".25"/>
 <circle cx="310" cy="259" r="178" fill="var(--accent)" opacity=".04"/><circle cx="310" cy="259" r="161" fill={`url(#${uid}-planet)`}/>
 <path d="M215 145 254 125 285 153 279 178 247 200 253 231 217 239 197 217 165 208M298 245 327 231 352 264 339 302 306 341 291 317 284 278M380 150 418 174 449 222 410 228 386 206 362 191" fill="#83ddbc" opacity=".55"/>
 <ellipse cx="310" cy="259" rx="236" ry="103" transform="rotate(-25 310 259)" fill="none" stroke="var(--accent)" opacity=".5" stroke-dasharray="2 9"/>
 <g class="hero-orbit"><g transform="translate(530 170) rotate(25)"><rect x="-9" y="-14" width="18" height="28" rx="3" fill="#ecfff8"/><path d="M-14 -9H-49V9H-14M14 -9H49V9H14" fill="#3e88ae" stroke="#a1dce3"/><path d="M0 -14V-32" stroke="#c4eeed" stroke-width="2"/></g></g>
 <text x="310" y="480" text-anchor="middle">ONE PLANET. ENDLESS QUESTIONS.</text>
</>}
{(kind==='rocket'||kind==='assembly')&&<g class={kind==='rocket'?'hero-float':''}>
 <ellipse cx="310" cy="461" rx="110" ry="17" fill="var(--accent)" opacity=".05"/>
 <g class={kind==='assembly'?'assemble-nose':''}><path d="M273 174Q275 106 310 77Q345 106 347 174Z" fill="var(--accent)"/><path d="M284 154Q287 119 307 99" fill="none" stroke="#fff9" stroke-width="5" stroke-linecap="round"/></g>
 <g class={kind==='assembly'?'assemble-body':''}><rect x="273" y="174" width="74" height="176" rx="8" fill={`url(#${uid}-metal)`}/><circle cx="310" cy="216" r="19" fill="#11354b" stroke="#b5edf2" stroke-width="4"/><path d="M274 285H346" stroke="var(--accent)" stroke-width="13"/></g>
 <g class={kind==='assembly'?'assemble-fins':''}><path d="M273 286 231 360 273 339M347 286 389 360 347 339" fill="var(--accent)"/><path d="M294 350H326L333 370H287Z" fill="#718798"/></g>
 {kind==='rocket'&&<><path class="hero-flame" d="M291 370Q268 419 310 478Q352 419 329 370Z" fill={`url(#${uid}-flame)`}/>{[0,1,2,3,4,5].map(i=><path class="hero-speed" style={`--delay:${-i*.3}s`} d={`M${145+i*67} ${30+i*45}v65`} stroke="var(--accent)" opacity=".2"/>)}</>}
 <circle cx="310" cy="256" r="208" fill="none" stroke="var(--accent)" opacity=".12" stroke-dasharray="5 12"/>
 <text x="310" y="510" text-anchor="middle">{kind==='assembly'?'BUILD IT. CHECK IT. UNDERSTAND IT.':'ACTION. REACTION. LIFTOFF.'}</text>
</g>}
{kind==='radar'&&<>
 {[70,125,180,225].map(r=><circle cx="310" cy="260" r={r} fill="none" stroke="var(--accent)" opacity=".22"/>)}
 <path d="M60 260H560M310 20V500" stroke="var(--accent)" opacity=".18"/>
 <g class="hero-radar"><path d="M310 260 310 35A225 225 0 0 1 505 147Z" fill="var(--accent)" opacity=".07"/><path d="M310 260V35" stroke="var(--accent)" stroke-width="3"/></g>
 {[[240,145],[405,315],[210,345]].map(([x,y],i)=><g class="radar-blip" style={`--delay:${i*-1.3}s`}><circle cx={x} cy={y} r="7" fill="var(--accent)"/><circle cx={x} cy={y} r="15" fill="none" stroke="var(--accent)" opacity=".3"/></g>)}
 <text x="310" y="515" text-anchor="middle">CLEAR CALLS. SHARED RESPONSIBILITY.</text>
</>}
{kind==='data'&&<>
 {[110,180,250,320,390].map(y=><path d={`M70 ${y}H565`} stroke="#9db9d5" opacity=".13"/>)}
 <path d="M70 70V420H565" stroke="#9db9d5" opacity=".4" fill="none"/>
 <path d="M70 420 500 90" stroke="var(--accent)" opacity=".5" stroke-dasharray="5 9"/>
 {[[140,367],[215,330],[280,275],[360,238],[430,190],[515,152]].map(([x,y],i)=><g class="hero-data-point" style={`--delay:${i*.45}s`}><circle cx={x} cy={y} r="9" fill="var(--accent)"/><path d={`M${x} ${y}V${420-(x-70)*330/430}`} stroke="#8debd8" stroke-width="2"/></g>)}
 <text x="540" y="464" text-anchor="end">PREDICTED →</text><text x="70" y="48">MEASURED ↑</text>
 <text x="310" y="515" text-anchor="middle">EVERY SURPRISE HAS A STORY.</text>
</>}
</svg>
</div>
<style>
.lesson-hero{width:100%;min-width:0;position:relative;display:grid;place-items:center}.lesson-hero svg{width:100%;height:auto;max-height:64vh;overflow:visible}.lesson-hero text{font:700 11px ui-sans-serif,system-ui;letter-spacing:2px;fill:#96afc5}.hero-orbit{transform-origin:310px 259px;animation:hero-orbit 22s linear infinite}.hero-float{animation:hero-float 5s ease-in-out infinite}.hero-flame{transform-origin:310px 370px;animation:hero-flame .2s infinite alternate}.hero-speed{animation:hero-speed 1.8s linear infinite;animation-delay:var(--delay)}.hero-radar{transform-origin:310px 260px;animation:hero-orbit 7s linear infinite}.radar-blip{animation:hero-blip 4s infinite;animation-delay:var(--delay)}.hero-data-point{animation:hero-point 4s ease-in-out infinite;animation-delay:var(--delay)}.assemble-nose{animation:assemble-nose 7s ease-in-out infinite}.assemble-body{animation:assemble-body 7s ease-in-out infinite}.assemble-fins{animation:assemble-fins 7s ease-in-out infinite}@keyframes hero-orbit{to{transform:rotate(360deg)}}@keyframes hero-float{50%{transform:translateY(-14px) rotate(3deg)}}@keyframes hero-flame{to{transform:scaleY(.78);opacity:.65}}@keyframes hero-speed{to{transform:translateY(200px);opacity:0}}@keyframes hero-blip{0%,100%{opacity:.25}40%{opacity:1}}@keyframes hero-point{0%,10%{opacity:.15;transform:translateY(18px)}35%,80%{opacity:1;transform:translateY(0)}100%{opacity:.15}}@keyframes assemble-nose{0%,15%,100%{transform:translateY(-45px)}45%,75%{transform:translateY(0)}}@keyframes assemble-body{0%,15%,100%{transform:translateX(-55px)}45%,75%{transform:translateX(0)}}@keyframes assemble-fins{0%,15%,100%{transform:translateY(45px)}45%,75%{transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.lesson-hero *{animation:none!important}}
</style>
