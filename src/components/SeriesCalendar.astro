---
// Season calendar for the Space Exploration series. Month grids are computed
// at build time from the event dates so nothing drifts out of sync.
const { events, months = ["2026-08", "2026-09", "2026-10", "2026-11", "2026-12"] } = Astro.props;

const KINDS = {
  meeting: { label: "Monday meeting", cls: "cal-meeting" },
  crew: { label: "Telemetry crew Saturday", cls: "cal-crew" },
  launch: { label: "Launch day", cls: "cal-launch" },
  backup: { label: "Backup launch date", cls: "cal-backup" },
  deadline: { label: "Deadline", cls: "cal-deadline" },
  holiday: { label: "Holiday", cls: "cal-holiday" },
};

const byDate = new Map();
for (const e of events) {
  if (!byDate.has(e.date)) byDate.set(e.date, []);
  byDate.get(e.date).push(e);
}

const MONTH_NAMES = ["January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December"];

function buildMonth(ym) {
  const [y, m] = ym.split("-").map(Number);
  const first = new Date(Date.UTC(y, m - 1, 1));
  const daysIn = new Date(Date.UTC(y, m, 0)).getUTCDate();
  const lead = first.getUTCDay();
  const cells = [];
  for (let i = 0; i < lead; i++) cells.push(null);
  for (let d = 1; d <= daysIn; d++) {
    const iso = `${y}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
    cells.push({ day: d, iso, events: byDate.get(iso) || [] });
  }
  return { title: `${MONTH_NAMES[m - 1]} ${y}`, cells };
}

const grid = months.map(buildMonth);
const usedKinds = [...new Set(events.map((e) => e.kind))];
---

<div class="cal">
  <ul class="cal-key">
    {usedKinds.map((k) => (
      <li><span class={`cal-dot ${KINDS[k].cls}`}></span>{KINDS[k].label}</li>
    ))}
  </ul>

  <div class="cal-months">
    {grid.map((mo) => (
      <section class="cal-month" aria-label={mo.title}>
        <h4>{mo.title}</h4>
        <div class="cal-dow" aria-hidden="true">
          <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
        </div>
        <div class="cal-grid">
          {mo.cells.map((c) =>
            c === null ? (
              <span class="cal-cell cal-empty"></span>
            ) : c.events.length ? (
              <span class={`cal-cell cal-has ${KINDS[c.events[0].kind].cls}`} title={c.events.map((e) => e.title).join(" · ")}>
                <span class="cal-day">{c.day}</span>
                <span class="cal-tip">{c.events.map((e) => e.title).join(" · ")}</span>
              </span>
            ) : (
              <span class="cal-cell"><span class="cal-day">{c.day}</span></span>
            )
          )}
        </div>
      </section>
    ))}
  </div>

  <ol class="cal-list">
    {events.map((e) => (
      <li class={KINDS[e.kind].cls}>
        <span class="cal-list-date">{e.label}</span>
        <span class="cal-list-title">{e.title}</span>
        {e.note && <span class="cal-list-note">{e.note}</span>}
      </li>
    ))}
  </ol>
</div>

<style>
  .cal { display: grid; gap: 1.2rem; }

  .cal-key {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0;
    padding: 0;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .cal-key li { display: flex; align-items: center; gap: 0.4rem; }

  .cal-dot { width: 0.7rem; height: 0.7rem; border-radius: 3px; display: inline-block; }

  .cal-months {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.9rem;
  }

  .cal-month {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.6rem 0.65rem 0.7rem;
    background: var(--surface);
  }

  .cal-month h4 {
    margin: 0 0 0.45rem;
    font-size: 0.82rem;
    font-family: "Space Grotesk", system-ui, sans-serif;
    letter-spacing: 0.03em;
  }

  .cal-dow, .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }

  .cal-dow span {
    text-align: center;
    font-size: 0.62rem;
    color: var(--muted);
    padding-bottom: 0.2rem;
  }

  .cal-cell {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 5px;
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .cal-empty { visibility: hidden; }

  .cal-has { color: #fff; font-weight: 700; cursor: default; }
  :root[data-theme="dark"] .cal-has { color: #0f1623; }

  .cal-meeting { background: var(--accent); }
  .cal-crew { background: #6b8f7a; }
  .cal-launch { background: #c8532b; }
  .cal-backup { background: #d8a13a; }
  .cal-deadline { background: #8a5fa8; }
  .cal-holiday { background: var(--line); color: var(--text); }

  .cal-dot.cal-holiday { background: var(--line); }

  .cal-tip {
    position: absolute;
    bottom: calc(100% + 5px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: var(--text);
    color: var(--bg);
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.2rem 0.45rem;
    border-radius: 5px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s;
    z-index: 5;
  }

  .cal-has:hover .cal-tip { opacity: 1; }

  .cal-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }

  .cal-list li {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.2rem 0.8rem;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    border-left: 4px solid var(--line);
    background: var(--bg-alt);
    font-size: 0.88rem;
  }

  .cal-list li.cal-meeting { border-left-color: var(--accent); background: var(--bg-alt); }
  .cal-list li.cal-crew { border-left-color: #6b8f7a; }
  .cal-list li.cal-launch { border-left-color: #c8532b; }
  .cal-list li.cal-backup { border-left-color: #d8a13a; }
  .cal-list li.cal-deadline { border-left-color: #8a5fa8; }
  .cal-list li.cal-holiday { border-left-color: var(--line); }

  .cal-list-date {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.82rem;
  }

  .cal-list-title { font-weight: 600; }

  .cal-list-note {
    grid-column: 2;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    .cal-list li { grid-template-columns: 1fr; }
    .cal-list-note { grid-column: 1; }
  }
</style>
