<section class="mission-choice" data-mission-choice aria-label="Robots or people: a mission tradeoff">
  <p class="mc-question">Imagine a budget that buys <strong>ten robotic missions</strong> or <strong>one crewed landing</strong>. Why might we still send people?</p>
  <p class="mc-assumption">A thought experiment, not a measured cost ratio. Real costs depend on the mission.</p>
  <div class="mc-illustration">
    <svg viewBox="0 0 1000 275" role="img" aria-label="Ten robotic rovers explore on the left. An astronaut chooses a rock beside a habitat on the right. Both work on an illustrated Mars landscape.">
      <defs><g id="mc-rover"><path d="M-24 15-15 5H17L27 15" fill="none" stroke="#72ddd6" stroke-width="3"/><rect x="-21" y="-10" width="42" height="21" rx="7" fill="#d8f0ea" stroke="#7ca6b3" stroke-width="2"/><path d="M0-10V-23" stroke="#b6cddc" stroke-width="4"/><rect x="-10" y="-31" width="22" height="12" rx="2" fill="#9fb9c8"/><circle cx="3" cy="-25" r="4" fill="#183446" stroke="#7198ac"/><path d="M-7-27V-22" stroke="#d8e5e8"/>{[-22,0,22].map(x=><g><circle cx={x} cy="18" r="8" fill="#1a3042" stroke="#70bbb6" stroke-width="2"/><circle cx={x} cy="18" r="2" fill="#ade6d3"/></g>)}<path d="M20-6 33-15 39-9" stroke="#ffcb87" stroke-width="3" fill="none"/></g></defs>
      {Array.from({length:30},(_,i)=><circle cx={(i*181+17)%1000} cy={(i*71+11)%170} r={i%3===0?1.5:.7} fill="#a8c7e4" opacity=".5"/>)}
      <circle cx="500" cy="85" r="52" fill="#cb806e"/><path d="M460 69Q502 51 537 76M470 111Q500 91 532 113" stroke="#e1a18a" stroke-width="10" fill="none"/><path d="M479 82 490 76 506 83 518 80" fill="none" stroke="#925951" stroke-width="3"/><ellipse cx="514" cy="105" rx="12" ry="5" fill="#ae6a5c"/>
      <path d="M0 220Q120 175 300 213Q510 169 670 214Q850 182 1000 219V275H0Z" fill="#553640"/><path d="M0 247Q260 218 480 250Q720 226 1000 244" fill="none" stroke="#a66c66" stroke-width="2"/>
      {Array.from({length:10},(_,i)=><g class="mc-bot" style={`--delay:${i*-.35}s`} transform={`translate(${57+(i%5)*78} ${i<5?111:204}) scale(${i<5?.73:.87})`}><use href="#mc-rover"/></g>)}
      <g transform="translate(860 153)"><path d="M-54 64V8Q-51-38 0-38Q51-38 54 8V64Z" fill="#afc8d4" stroke="#637d95" stroke-width="3"/><path d="M-63 62H64" stroke="#8393ac" stroke-width="8"/><rect x="-40" y="-4" width="24" height="22" rx="7" fill="#345d79"/><rect x="16" y="-4" width="24" height="22" rx="7" fill="#345d79"/><rect x="-13" y="24" width="26" height="38" rx="13" fill="#223e59"/><path d="M0-40V-67L29-56 0-51" fill="#f4bc7b" stroke="#f4bc7b" stroke-width="2"/></g>
      <g class="mc-astronaut" transform="translate(680 132)"><rect x="-28" y="-5" width="55" height="64" rx="12" fill="#adbfce"/><path d="M-12 49-17 84M14 49 21 84" stroke="#dfe8ef" stroke-width="18" stroke-linecap="round"/><path d="M-22 9-40 33M23 9 49 24" stroke="#e5eef6" stroke-width="15" stroke-linecap="round"/><rect x="-21" y="-6" width="43" height="60" rx="16" fill="#f4f1e8"/><rect x="-13" y="12" width="27" height="18" rx="5" fill="#a4cccf"/><circle cy="-25" r="31" fill="#f1f0df" stroke="#a9becb" stroke-width="3"/><rect x="-22" y="-43" width="44" height="32" rx="14" fill="#e5af5f" stroke="#7d653e" stroke-width="2"/><path d="M-15-34Q-9-39 1-37" stroke="#fff5bc" stroke-width="4" fill="none" stroke-linecap="round"/><path d="M43 27 52 20 61 27 56 36 47 35Z" fill="#df927a" stroke="#a9675e" stroke-width="2"/></g>
      <text x="220" y="265" text-anchor="middle">MANY DESTINATIONS · NO CREW AT RISK</text><text x="775" y="265" text-anchor="middle">DECISIONS ON SITE · LIFE SUPPORT + RETURN</text>
    </svg>
  </div>
  <div class="mc-controls" role="group" aria-label="Choose a mission team"><span>YOUR MISSION TEAM</span><button data-choice="robots" aria-pressed="false">Ten robots</button><button data-choice="people" aria-pressed="false">A human crew</button><button data-choice="team" aria-pressed="true">Robots + people</button></div>
  <div class="mc-reason" aria-live="polite"><h5 data-choice-title>Let each do what it does well</h5><p data-choice-reason>Robots scout and measure; people interpret, choose, repair, and adapt on site. A team still has to justify its cost and risk.</p></div>
  <p class="mc-prompt"><strong>Defend your choice:</strong> name a science goal, an advantage, and a tradeoff. Use a discovery from Voyager 1 or Apollo 11 as evidence.</p>
</section>
<style>
.mission-choice{font-family:ui-sans-serif,system-ui,sans-serif;color:#dfebf9;text-align:left}.mc-question{font-size:clamp(19px,2.15vw,32px);line-height:1.25;letter-spacing:-.025em;margin:0;max-width:50ch;color:#e7f1ff}.mc-question strong:first-child{color:#96e9d7}.mc-question strong:last-child{color:#ffd29a}.mc-assumption{font-size:10px;color:#9db2cb;margin:8px 0 0}.mc-illustration{background:radial-gradient(ellipse at 50% 30%,#293345,#101a2d 70%);border:1px solid #3a4b61;border-radius:13px;margin:17px 0 13px;overflow:hidden}.mc-illustration svg{width:100%;height:auto;max-height:28vh;display:block}.mc-illustration text{font:11px ui-sans-serif,system-ui,sans-serif;fill:#f4d8bd;letter-spacing:1px}.mc-bot use{animation:mc-bob 5s var(--delay) infinite alternate;transform-origin:center}.mc-astronaut{transform-origin:center}.mc-controls{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.mc-controls span{font-size:9px;letter-spacing:.1em;color:#9bb0ca;margin-right:8px}.mc-controls button{font:inherit;font-size:12px;border-radius:7px;border:1px solid #445b74;background:#132439;color:#c9daef;padding:10px 14px;cursor:pointer}.mc-controls button[aria-pressed=true]{background:#a5e9d5;color:#13382f;border-color:#a5e9d5}.mc-controls button:focus-visible{outline:3px solid #ffe1a4;outline-offset:2px}.mc-reason{display:grid;grid-template-columns:230px 1fr;gap:20px;align-items:center;padding:14px 0 10px;min-height:75px}.mc-reason h5{font-size:19px;letter-spacing:-.025em;line-height:1.2;color:#f4d4a7;margin:0}.mc-reason p{font-size:14px;line-height:1.45;color:#b8cce1;margin:0}.mc-prompt{margin:7px 0 0;padding-top:10px;border-top:1px solid #34475b;font-size:12px;line-height:1.4;color:#a9bfd6}.mc-prompt strong{color:#a7e9d7}.mc-controls button:hover{border-color:#a5e9d5}@keyframes mc-bob{to{transform:translateY(-1px)}}:global([data-motion-paused=true] .mc-bot use){animation-play-state:paused}@media(prefers-reduced-motion:reduce){.mc-bot use{animation:none}}@media(max-width:650px){.mc-question{font-size:19px}.mc-illustration{margin:12px 0}.mc-illustration svg{min-height:140px}.mc-controls span{width:100%}.mc-reason{grid-template-columns:1fr;gap:7px;padding-top:12px}.mc-reason h5{font-size:18px}.mc-reason p{font-size:12px}.mc-controls button{font-size:10px;padding:8px}.mc-prompt{font-size:10px}.mc-assumption{font-size:9px}}
</style>
<script>
function init(){document.querySelectorAll<HTMLElement>('[data-mission-choice]').forEach(root=>{if(root.dataset.wired)return;root.dataset.wired='1';const choices={robots:['Explore far, without risking a crew','Robots can visit dangerous places for long missions without air, food, or rescue. They have limited tools, power, and autonomy; some decisions must wait for Earth.'],people:['Adapt when the plan meets reality','People can choose samples, repair equipment, and change plans on site. Protecting the crew adds life support, shielding, supplies, and a safe return.'],team:['Let each do what it does well','Robots scout and measure; people interpret, choose, repair, and adapt on site. A team still has to justify its cost and risk.']};root.querySelectorAll<HTMLElement>('[data-choice]').forEach(button=>button.addEventListener('click',()=>{root.querySelectorAll('[data-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));const value=choices[button.dataset.choice as keyof typeof choices];root.querySelector('[data-choice-title]')!.textContent=value[0];root.querySelector('[data-choice-reason]')!.textContent=value[1];}));});}init();document.addEventListener('astro:page-load',init);
</script>
