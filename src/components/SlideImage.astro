---
// NASA public-domain photographs for slides. Every caption below was written
// after looking at the actual downloaded file, not from the search title —
// the "Saturn Apollo Program" result turned out to be a crew portrait, not a
// liftoff, which is exactly the mistake this guards against.
const IMAGES = {
  "apollo-crew": {
    src: "/images/space/saturn-v-launch.jpg",
    alt: "Three Apollo astronauts in white pressure suits standing in front of an American flag, with a Saturn V rocket on its pad in the distance",
    caption: "An Apollo crew at Kennedy Space Center, their Saturn V waiting on the pad behind them.",
    credit: "NASA",
  },
  "shuttle-launch": {
    src: "/images/space/shuttle-launch.jpg",
    alt: "Space Shuttle Columbia lifting off across a marsh, exhaust reflected in the water",
    caption: "Columbia leaves Pad 39A. Two solid boosters and three main engines, burning together.",
    credit: "NASA",
  },
  iss: {
    src: "/images/space/iss.jpg",
    alt: "The International Space Station in orbit, solar arrays extended, Earth below",
    caption: "The ISS — American, Russian, Japanese, European and Canadian hardware, docked together and continuously crewed since November 2000.",
    credit: "NASA",
  },
  voyager: {
    src: "/images/space/voyager.jpg",
    alt: "Artist's concept of the Voyager spacecraft against a starfield",
    caption: "Voyager, launched 1977, still transmitting from interstellar space with less computing power than a modern key fob.",
    credit: "NASA/JPL-Caltech (artist's concept)",
  },
  perseverance: {
    src: "/images/space/perseverance.jpg",
    alt: "The Perseverance rover photographed on the surface of Mars with the Ingenuity helicopter nearby",
    caption: "Perseverance on Mars, with the Ingenuity helicopter. Every picture it sends takes 3 to 22 minutes to reach Earth.",
    credit: "NASA/JPL-Caltech/MSSS",
  },
  bootprint: {
    src: "/images/space/bootprint.jpg",
    alt: "Close-up of an astronaut's boot and its print in grey lunar soil",
    caption: "An Apollo 11 bootprint. No wind, no rain — it is still there.",
    credit: "NASA",
  },
  "dsn-dish": {
    src: "/images/space/dsn-dish.jpg",
    alt: "Workers and a crane dwarfed inside the white dish of a Deep Space Network antenna",
    caption: "Inside a Deep Space Network dish during maintenance. Look for the people — this is what receives the signal from Mars.",
    credit: "NASA/JPL-Caltech",
  },
  "model-liftoff": {
    src: "/images/rocketry/liftoff.jpg",
    alt: "A small model rocket lifting off from a launch pad in a wide grassy field, white smoke at the base",
    caption: "This is the moment everything else is preparation for. About a second and a half of thrust, and then it is on its own.",
    credit: "Illustration",
  },
  "model-descent": {
    src: "/images/rocketry/descent.jpg",
    alt: "A model rocket descending under an orange and white parachute over an open field",
    caption: "Ejection happened near apogee and the chute opened cleanly. From here it is a walk, not a search.",
    credit: "Illustration",
  },
  "field-ground-station": {
    src: "/images/rocketry/ground-station.jpg",
    alt: "A folding table at the edge of a field holding a laptop showing a graph, a radio receiver, a clipboard, binoculars and a stopwatch",
    caption: "Mission control, Troop 308 edition. Laptop, ground radio, flight cards, binoculars, stopwatch — that is the whole range.",
    credit: "Illustration",
  },
  // ---- NASA public domain, added to give the decks real photography ----
  // Every caption below was written after opening the file. Three of the
  // candidates had misleading titles: an "Artemis I Liftoff" that is the
  // rocket standing on the pad, an "Orion parachute descent test" that is the
  // capsule being loaded into a transport aircraft, and (earlier) a "Saturn V
  // launch" that was a crew portrait. Titles are not evidence.
  "engine-test": {
    src: "/images/nasa/engine-test.jpg",
    alt: "A rocket engine firing on a test stand beside a lake, a huge white exhaust plume rolling sideways across the water",
    caption: "An engine firing on the test stand at Stennis. The rocket is bolted down, so all of the thrust goes into the plume — this is action and reaction with nowhere to hide.",
    credit: "NASA",
  },
  "mission-control": {
    src: "/images/nasa/mission-control.jpg",
    alt: "Rows of flight controllers at consoles in NASA's Mission Operations Control Room during Apollo 7, with a world map on the front screen",
    caption: "Mission Control during Apollo 7. Every one of those consoles is one person with one job and one call to make — which is exactly how our range works on November 21.",
    credit: "NASA",
  },
  "mission-control-plot": {
    src: "/images/nasa/mission-control-plot.jpg",
    alt: "Flight controllers at consoles facing a large screen showing a plotted trajectory curve",
    caption: "The big screen is a trajectory: where they predicted the spacecraft would be, against where it actually was. That comparison is the whole job — and it is what your altimeter gives you.",
    credit: "NASA",
  },
  "clean-room-build": {
    src: "/images/nasa/clean-room-build.jpg",
    alt: "Engineers in white cleanroom suits and masks carefully fitting a component onto the Mars Perseverance rover",
    caption: "Engineers fitting the mast onto Perseverance. Six people, white gloves, no rushing — this is what careful assembly looks like when you only get one try.",
    credit: "NASA/JPL-Caltech",
  },
  "sample-return-capsule": {
    src: "/images/nasa/sample-return-capsule.jpg",
    alt: "Three recovery team members standing on desert scrubland beside a small dark cone-shaped capsule on the ground",
    caption: "The OSIRIS-REx capsule on the Utah desert floor with its recovery team, carrying pieces of the asteroid Bennu. This is what requirement 5c looks like when it works.",
    credit: "NASA",
  },
  "wind-tunnel-model": {
    src: "/images/nasa/wind-tunnel-model.jpg",
    tall: true,
    alt: "An engineer in a suit holding a small model rocket mounted on a sting in a wind tunnel, measuring it with a rule",
    caption: "An engineer fitting a model of the Apollo escape rocket into a wind tunnel in 1964. Predict it, test it, measure it, then fly the real one — the same order you are doing it in.",
    credit: "NASA",
  },
  "rocket-on-pad": {
    src: "/images/nasa/rocket-on-pad.jpg",
    alt: "A large orange and white rocket standing on a distant launch pad, with the tracked crawler-transporter parked in the foreground",
    caption: "Standing on the pad, ready to go — and it only got there because every check on a very long list was signed off first.",
    credit: "NASA",
  },
  "pad-at-night": {
    src: "/images/nasa/pad-at-night.jpg",
    tall: true,
    alt: "A rocket lit by floodlights on a launch pad against a completely black night sky",
    caption: "Lit up on the pad in the dark, waiting for a launch window. Note: this is the rocket standing still, not launching.",
    credit: "NASA",
  },
  "drop-test": {
    src: "/images/nasa/drop-test.jpg",
    alt: "A white space capsule hitting the surface of a test pool at an angle, throwing up a sheet of spray",
    caption: "An Orion capsule dropped into a test pool on purpose, to find out what the splashdown does to it. Better to break it here than with a crew aboard.",
    credit: "NASA",
  },
  "liftoff": {
    src: "/images/nasa/liftoff.jpg",
    alt: "A space shuttle lifting off across a marsh, its exhaust reflected in the water in the foreground",
    caption: "Columbia leaving the pad, seen across the marsh. Everything before this moment is preparation; everything after it is data.",
    credit: "NASA",
  },
  "katherine-johnson": {
    src: "/images/space/katherine-johnson.jpg",
    tall: true,
    alt: "Portrait of Katherine Johnson, NASA mathematician, seated",
    caption: "Katherine Johnson at NASA Langley, 1971. She calculated the trajectories that put Americans in orbit and on the Moon — John Glenn refused to fly until she personally checked the computer's numbers.",
    credit: "NASA",
  },
};

const { name, size = "full" } = Astro.props;
const img = IMAGES[name];
---

{img && (
  <figure class={`simg simg-${size}${img.tall ? " simg-tall" : ""}`}>
    <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
    <figcaption>
      <span class="simg-cap">{img.caption}</span>
      <span class="simg-credit">
        {img.credit === "Illustration" ? "AI-generated illustration" : img.credit + " · public domain"}
      </span>
    </figcaption>
  </figure>
)}

<style>
  .simg { margin: 0.4rem 0 0.9rem; }

  /* Height-capped and centred, never stretched to the full slide width.
     These are not all wide photographs — Katherine Johnson is portrait, and
     the Apollo crew, Columbia, the bootprint and the DSN dish are all square.
     `width: 100%` plus `object-fit: cover` cropped every one of those into a
     thin horizontal band through the middle of the picture. */
  .simg img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 34vh;
    margin-inline: auto;
    object-fit: contain;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--bg-alt);
  }

  /* A portrait image capped at the same height as a wide one ends up tiny. */
  .simg-tall img { max-height: 46vh; }

  .simg-half img { max-height: 26vh; }
  .simg-half.simg-tall img { max-height: 34vh; }

  .simg figcaption {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.4rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .simg-cap { color: var(--text); }

  .simg-credit {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
