---
// Model-rocket flight simulator, two modes.
//   mode="launch"   — pad to apogee, drawn as an altitude-vs-time profile
//   mode="recovery" — apogee to ground: delay timing, device choice, wind drift
//
// Wide 16:9 stage so it fits inside a projected slide without scrolling.
// Teaching model: constant average thrust, fixed Cd, no rod tip-off. Tuned so
// a clean C6-5 Cosmic Cargo lands near Estes' published ~1,000 ft and an
// unloaded Lil' Spite on F15-6 lands near its published ~1,200 ft.
const { mode = "launch", id = mode } = Astro.props;
const isLaunch = mode === "launch";
---

<div class="fsim" data-fsim data-mode={mode} id={`fsim-${id}`}>
  <div class="fsim-head">
    <h4>{isLaunch ? "Launch: pad to apogee" : "Recovery: apogee to landing"}</h4>
    <p>
      {isLaunch
        ? "Pick an airframe and a motor and watch the flight profile. Adding payload costs altitude twice over — more mass to lift, and less speed at burnout."
        : "The ejection charge fires when the delay grain burns through. Too early and the rocket is still fast enough to shred the parachute; too late and it is already falling."}
    </p>
  </div>

  <div class="fsim-body">
    <div class="fsim-stage">
      <canvas data-fsim-canvas width="660" height="380" role="img"
        aria-label={isLaunch ? "Altitude versus time flight profile" : "Descent and wind drift profile"}></canvas>
      <div class="fsim-phase" data-fsim-phase>Ready</div>
    </div>

    <div class="fsim-panel">
      <label>
        Airframe
        <select data-fsim-airframe>
          <option value="cargo" selected>Cosmic Cargo — Scout rocket</option>
          <option value="spite">Lil' Spite — capstone rocket</option>
        </select>
      </label>

      {isLaunch ? (
        <>
          <label>
            Motor
            <select data-fsim-motor></select>
          </label>
          <label>
            Payload <output data-fsim-out="payload">0</output> g
            <input type="range" data-fsim-payload min="0" max="60" step="5" value="0" />
            <span class="fsim-hint" data-fsim-payhint>Anything the rocket carries that isn't needed to fly.</span>
          </label>
        </>
      ) : (
        <>
          <label>
            Motor delay <output data-fsim-out="delay">5</output> s after burnout
            <input type="range" data-fsim-delay min="0" max="9" step="1" value="5" />
          </label>
          <label>
            Recovery device
            <select data-fsim-device>
              <option value="chute12" selected>12 in parachute (stock)</option>
              <option value="chute18">18 in parachute</option>
              <option value="streamer">Streamer</option>
            </select>
          </label>
          <label>
            Wind <output data-fsim-out="wind">5</output> mph
            <input type="range" data-fsim-wind min="0" max="20" step="1" value="5" />
          </label>
        </>
      )}

      <dl class="fsim-readout" data-fsim-readout></dl>
      <p class="fsim-verdict" data-fsim-verdict></p>

      <div class="fsim-actions">
        <button type="button" class="fsim-btn fsim-btn-go" data-fsim-run>{isLaunch ? "Launch" : "Deploy"}</button>
        <button type="button" class="fsim-btn" data-fsim-reset>Reset</button>
      </div>
    </div>
  </div>
</div>

<style>
  .fsim {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 0.85rem 1rem 0.9rem;
  }

  .fsim-head h4 { margin: 0 0 0.25rem; font-size: 1rem; }
  .fsim-head p { margin: 0 0 0.7rem; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }

  .fsim-body { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(13rem, 0.65fr); gap: 0.9rem; align-items: start; }

  .fsim-stage { position: relative; }

  .fsim-stage canvas {
    width: 100%; height: auto; display: block;
    border-radius: 10px; border: 1px solid var(--line);
    background: #08111f;
  }

  .fsim-phase {
    position: absolute; top: 0.5rem; left: 0.5rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.15rem 0.5rem; border-radius: 999px;
    background: rgba(0,0,0,0.55); color: #fff;
  }

  .fsim-panel { display: grid; gap: 0.55rem; }
  .fsim-panel label { display: grid; gap: 0.22rem; font-size: 0.78rem; font-weight: 600; }
  .fsim-panel select, .fsim-panel input[type="range"] { width: 100%; font: inherit; }

  .fsim-panel select {
    padding: 0.3rem 0.45rem; border-radius: 7px;
    border: 1px solid var(--line); background: var(--bg); color: var(--text);
    font-size: 0.8rem;
  }

  .fsim-hint { font-weight: 400; font-size: 0.72rem; color: var(--muted); line-height: 1.4; }

  .fsim-panel output {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-weight: 700; color: var(--accent-strong);
  }

  .fsim-readout {
    display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 0.5rem;
    margin: 0.1rem 0 0; padding: 0.5rem 0.6rem;
    border-radius: 8px; background: var(--bg-alt); border: 1px solid var(--line);
    font-size: 0.78rem;
  }

  .fsim-readout dt { color: var(--muted); }

  .fsim-readout dd {
    margin: 0; text-align: right;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-variant-numeric: tabular-nums; font-weight: 700;
  }

  .fsim-verdict {
    margin: 0; min-height: 3.4rem; font-size: 0.78rem; line-height: 1.45;
    padding: 0.45rem 0.6rem; border-radius: 7px;
    border-left: 3px solid var(--line); background: var(--bg-alt);
  }

  .fsim-verdict[data-tone="good"] { border-left-color: #3d8b58; }
  .fsim-verdict[data-tone="warn"] { border-left-color: #d8a13a; }
  .fsim-verdict[data-tone="bad"] { border-left-color: #c8532b; }

  .fsim-actions { display: flex; gap: 0.35rem; }

  .fsim-btn {
    font: inherit; font-size: 0.8rem; padding: 0.35rem 0.8rem;
    border-radius: 999px; border: 1px solid var(--line);
    background: transparent; color: var(--text); cursor: pointer;
  }

  .fsim-btn:hover { border-color: var(--accent); color: var(--accent-strong); }
  .fsim-btn-go { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 700; }
  :root[data-theme="dark"] .fsim-btn-go { color: #0f1623; }

  @media (max-width: 820px) {
    .fsim-body { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (function () {
    var G = 9.81, RHO = 1.18;

    var AIRFRAMES = {
      cargo: {
        name: "Cosmic Cargo", dry: 36, area: 4.91e-4, cd: 0.90,
        motors: ["A8-3", "B6-4", "C6-5", "C6-7"], defMotor: "C6-5",
        maxPay: 60, twGood: 8, twOk: 5, rail: 0.9,
        payHint: "An altimeter is about 25 g. A small camera is 40–60 g.",
        chuteScale: 1
      },
      spite: {
        name: "Lil' Spite", dry: 292, area: 2.027e-3, cd: 0.75,
        motors: ["D12-3", "E12-4", "E16-6", "F15-6"], defMotor: "E16-6",
        maxPay: 220, twGood: 4.5, twOk: 3, rail: 1.5,
        payHint: "The telemetry payload — T-Beam, 18650 cell, sled — is about 120 g.",
        chuteScale: 1.6
      }
    };

    var MOTORS = {
      "A8-3":  { I: 2.5,  F: 4.3,  t: 0.58, m: 16.2, mp: 3.12, delay: 3 },
      "B6-4":  { I: 5.0,  F: 6.0,  t: 0.86, m: 18.2, mp: 5.6,  delay: 4 },
      "C6-5":  { I: 10.0, F: 6.0,  t: 1.7,  m: 25.5, mp: 10.8, delay: 5 },
      "C6-7":  { I: 10.0, F: 6.0,  t: 1.7,  m: 25.5, mp: 10.8, delay: 7 },
      "D12-3": { I: 16.84,F: 9.9,  t: 1.7,  m: 42,   mp: 21.1, delay: 3 },
      "E12-4": { I: 28.45,F: 11.6, t: 2.45, m: 56,   mp: 35.8, delay: 4 },
      "E16-6": { I: 33.68,F: 16.0, t: 2.1,  m: 62,   mp: 25,   delay: 6 },
      "F15-6": { I: 49.6, F: 15.0, t: 3.3,  m: 102,  mp: 60,   delay: 6 }
    };

    var DEVICES = {
      chute12: { label: "12 in chute", v: 4.6 },
      chute18: { label: "18 in chute", v: 3.1 },
      streamer: { label: "streamer", v: 9.5 }
    };

    function simLaunch(afKey, motorKey, payloadG) {
      var af = AIRFRAMES[afKey], mo = MOTORS[motorKey];
      var m0 = (af.dry + payloadG + mo.m) / 1000;
      var burnRate = mo.mp / 1000 / mo.t;
      var v = 0, y = 0, t = 0, dt = 0.002;
      var prof = [{ t: 0, y: 0, v: 0, burn: true }];
      var vBurn = 0, vmax = 0;
      var twr = mo.F / (m0 * G);
      var railV = Math.sqrt(Math.max(0, 2 * ((mo.F / m0) - G) * af.rail));

      while (t < 120) {
        var m = m0 - (t < mo.t ? burnRate * t : mo.mp / 1000);
        var thrust = t < mo.t ? mo.F : 0;
        var drag = 0.5 * RHO * af.cd * af.area * v * Math.abs(v);
        var a = (thrust - drag) / m - G;
        v += a * dt; y += v * dt; t += dt;
        if (v > vmax) vmax = v;
        if (t >= mo.t && vBurn === 0) vBurn = v;
        if (Math.round(t / dt) % 15 === 0) prof.push({ t: t, y: y, v: v, burn: t < mo.t });
        if (v <= 0 && t > mo.t) break;
      }
      prof.push({ t: t, y: y, v: 0, burn: false });
      return { prof: prof, apogee: y, tApogee: t, vBurn: vBurn, vmax: vmax, twr: twr, railV: railV, motor: mo, af: af };
    }

    function simRecovery(afKey, delayS, deviceKey, windMph) {
      var af = AIRFRAMES[afKey];
      var base = simLaunch(afKey, af.defMotor, afKey === "spite" ? 120 : 0);
      var coast = base.tApogee - base.motor.t;
      var overshoot = delayS - coast;
      var dtFromApogee = Math.abs(overshoot);
      var vEject = Math.min(G * dtFromApogee, base.vBurn);
      var ejectAlt = Math.max(0, base.apogee - 0.5 * G * dtFromApogee * dtFromApogee);

      var dev = DEVICES[deviceKey];
      var descentV = dev.v * af.chuteScale;
      var damaged = vEject > 27;
      if (damaged) descentV *= 2.4;

      var wind = windMph * 0.44704;
      var tDescent = ejectAlt / descentV;
      var drift = wind * tDescent;
      var totalAloft = base.motor.t + Math.min(delayS, coast + Math.max(0, overshoot)) + tDescent;

      return { base: base, ejectAlt: ejectAlt, vEject: vEject, descentV: descentV,
        tDescent: tDescent, drift: drift, damaged: damaged, overshoot: overshoot,
        totalAloft: totalAloft, device: dev, af: af };
    }

    function ft(m) { return Math.round(m * 3.28084); }

    function wire(root) {
      if (root.dataset.fsimWired) return;
      root.dataset.fsimWired = "1";
      var mode = root.dataset.mode;
      var cv = root.querySelector("[data-fsim-canvas]");
      var ctx = cv.getContext("2d");
      var phaseEl = root.querySelector("[data-fsim-phase]");
      var readout = root.querySelector("[data-fsim-readout]");
      var verdict = root.querySelector("[data-fsim-verdict]");
      var afSel = root.querySelector("[data-fsim-airframe]");
      var moSel = root.querySelector("[data-fsim-motor]");
      var paySlider = root.querySelector("[data-fsim-payload]");
      var payHint = root.querySelector("[data-fsim-payhint]");
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var raf = null;

      function af() { return AIRFRAMES[afSel.value]; }

      function refreshAirframe() {
        var a = af();
        if (moSel) {
          moSel.innerHTML = a.motors.map(function (k) {
            return '<option value="' + k + '"' + (k === a.defMotor ? " selected" : "") + ">" + k + "</option>";
          }).join("");
        }
        if (paySlider) {
          paySlider.max = a.maxPay;
          paySlider.step = a.maxPay > 100 ? 10 : 5;
          if (+paySlider.value > a.maxPay) paySlider.value = a.maxPay;
          if (afSel.value === "spite" && +paySlider.value === 0) paySlider.value = 120;
          paySlider.dispatchEvent(new Event("input"));
        }
        if (payHint) payHint.textContent = a.payHint;
      }

      function rows(pairs) {
        readout.innerHTML = pairs.map(function (p) { return "<dt>" + p[0] + "</dt><dd>" + p[1] + "</dd>"; }).join("");
      }

      function axes(W, H, pad, xMax, yMax, xLabel) {
        ctx.strokeStyle = "rgba(255,255,255,0.16)";
        ctx.fillStyle = "rgba(255,255,255,0.5)";
        ctx.font = "10px ui-monospace, monospace";
        ctx.lineWidth = 1;
        var stepFt = yMax * 3.28084 > 800 ? 250 : yMax * 3.28084 > 300 ? 100 : 50;
        for (var f = stepFt; f * 0.3048 <= yMax; f += stepFt) {
          var yy = H - pad.b - (f * 0.3048 / yMax) * (H - pad.b - pad.t);
          ctx.setLineDash([3, 4]);
          ctx.beginPath(); ctx.moveTo(pad.l, yy); ctx.lineTo(W - pad.r, yy); ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillText(f + " ft", 4, yy + 3);
        }
        ctx.strokeStyle = "rgba(255,255,255,0.35)";
        ctx.beginPath();
        ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, H - pad.b); ctx.lineTo(W - pad.r, H - pad.b);
        ctx.stroke();
        ctx.fillStyle = "rgba(255,255,255,0.5)";
        ctx.fillText(xLabel, W - pad.r - 62, H - pad.b + 14);
      }

      function rocketGlyph(x, y, ang, flame, scale) {
        var s = scale || 1;
        ctx.save(); ctx.translate(x, y); ctx.rotate(ang); ctx.scale(s, s);
        ctx.fillStyle = "#eef2f7";
        ctx.beginPath(); ctx.moveTo(0, -10); ctx.lineTo(4, 3); ctx.lineTo(-4, 3); ctx.closePath(); ctx.fill();
        ctx.fillStyle = "#c8532b";
        ctx.beginPath(); ctx.moveTo(-4, 3); ctx.lineTo(-7, 8); ctx.lineTo(-4, 8); ctx.closePath(); ctx.fill();
        ctx.beginPath(); ctx.moveTo(4, 3); ctx.lineTo(7, 8); ctx.lineTo(4, 8); ctx.closePath(); ctx.fill();
        if (flame) {
          ctx.fillStyle = "rgba(255,170,40,0.95)";
          ctx.beginPath(); ctx.moveTo(-3, 4); ctx.lineTo(3, 4); ctx.lineTo(0, 11 + Math.random() * 7); ctx.closePath(); ctx.fill();
        }
        ctx.restore();
      }

      // ---------------- launch: altitude vs time ----------------
      function runLaunch(p) {
        var r = simLaunch(afSel.value, moSel.value, +paySlider.value);
        var W = cv.width, H = cv.height, pad = { l: 44, r: 14, t: 16, b: 26 };
        ctx.fillStyle = "#08111f"; ctx.fillRect(0, 0, W, H);

        var yMax = Math.max(r.apogee * 1.12, 10);
        var xMax = Math.max(r.tApogee * 1.05, 1);
        axes(W, H, pad, xMax, yMax, "time (s)");

        var px = function (t) { return pad.l + (t / xMax) * (W - pad.l - pad.r); };
        var py = function (y) { return H - pad.b - (y / yMax) * (H - pad.b - pad.t); };

        var n = Math.max(2, Math.floor(r.prof.length * p));

        // burn phase shading
        ctx.fillStyle = "rgba(255,170,40,0.10)";
        ctx.fillRect(pad.l, pad.t, px(r.motor.t) - pad.l, H - pad.b - pad.t);

        ctx.lineWidth = 2.4;
        for (var i = 1; i < n; i++) {
          var a = r.prof[i - 1], b = r.prof[i];
          ctx.strokeStyle = b.burn ? "rgba(255,170,60,0.95)" : "rgba(120,200,255,0.92)";
          ctx.beginPath(); ctx.moveTo(px(a.t), py(a.y)); ctx.lineTo(px(b.t), py(b.y)); ctx.stroke();
        }

        var cur = r.prof[n - 1];
        rocketGlyph(px(cur.t), py(cur.y), 0, cur.burn && p < 1, 1);

        // burnout marker
        if (p > 0.35) {
          ctx.strokeStyle = "rgba(255,255,255,0.3)"; ctx.setLineDash([3, 3]);
          ctx.beginPath(); ctx.moveTo(px(r.motor.t), pad.t); ctx.lineTo(px(r.motor.t), H - pad.b); ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = "rgba(255,255,255,0.6)"; ctx.font = "10px ui-monospace, monospace";
          ctx.fillText("burnout", px(r.motor.t) + 4, pad.t + 11);
        }
        if (p >= 1) {
          ctx.fillStyle = "rgba(255,255,255,0.85)";
          ctx.fillText("apogee " + ft(r.apogee) + " ft", Math.min(W - 110, px(r.tApogee) - 66), py(r.apogee) - 8);
        }

        phaseEl.textContent = p >= 1 ? "Apogee" : cur.burn ? "Boost" : "Coast";

        rows([
          ["Apogee", ft(r.apogee) + " ft"],
          ["Burnout speed", Math.round(r.vBurn) + " m/s"],
          ["Time to apogee", r.tApogee.toFixed(1) + " s"],
          ["Thrust-to-weight", r.twr.toFixed(1) + " : 1"],
          ["Best delay", "≈ " + (r.tApogee - r.motor.t).toFixed(1) + " s"]
        ]);

        if (p >= 1) {
          var a2 = r.af;
          var bestDelay = (r.tApogee - r.motor.t).toFixed(1);
          if (r.twr < a2.twOk) {
            verdict.dataset.tone = "bad";
            verdict.textContent = "Thrust-to-weight " + r.twr.toFixed(1) + ":1 is too low for this airframe — it leaves the rod before the fins can bite. Less payload or more motor.";
          } else if (r.twr < a2.twGood) {
            verdict.dataset.tone = "warn";
            verdict.textContent = "Flies, but marginal at " + r.twr.toFixed(1) + ":1. Fine on a calm day off a full-length rod; sketchy in wind. Estes' own recommendation for the kit is the authority here — average thrust understates what actually gets a long rocket off the rail.";
          } else {
            verdict.dataset.tone = "good";
            verdict.textContent = "Clean flight. " + ft(r.apogee) + " ft, apogee at " + r.tApogee.toFixed(1) + " s. Coast after burnout is " + bestDelay + " s — pick the motor delay closest to that number.";
          }
        }
      }

      // ---------------- recovery: altitude vs drift ----------------
      function runRecovery(p) {
        var delay = +root.querySelector("[data-fsim-delay]").value;
        var device = root.querySelector("[data-fsim-device]").value;
        var wind = +root.querySelector("[data-fsim-wind]").value;
        var r = simRecovery(afSel.value, delay, device, wind);
        var W = cv.width, H = cv.height, pad = { l: 44, r: 14, t: 16, b: 26 };
        ctx.fillStyle = "#08111f"; ctx.fillRect(0, 0, W, H);

        var yMax = Math.max(r.base.apogee * 1.12, 10);
        var xMax = Math.max(r.drift * 1.15, 30);
        axes(W, H, pad, xMax, yMax, "drift downwind (ft)");

        var px = function (d) { return pad.l + (d / xMax) * (W - pad.l - pad.r); };
        var py = function (y) { return H - pad.b - (y / yMax) * (H - pad.b - pad.t); };

        var ey = py(r.ejectAlt);
        ctx.strokeStyle = r.damaged ? "#ff8a5c" : "rgba(255,255,255,0.45)";
        ctx.setLineDash([4, 4]); ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(pad.l, ey); ctx.lineTo(W - pad.r, ey); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = r.damaged ? "#ff8a5c" : "rgba(255,255,255,0.7)";
        ctx.font = "10px ui-monospace, monospace";
        ctx.fillText("ejection @ " + ft(r.ejectAlt) + " ft", pad.l + 4, ey - 4);

        ctx.strokeStyle = "rgba(255,200,90,0.9)"; ctx.lineWidth = 2.4;
        ctx.beginPath();
        var steps = 80, shown = Math.max(1, Math.floor(steps * p));
        for (var i = 0; i <= shown; i++) {
          var f = i / steps;
          var x = px(r.drift * f), y = ey + (H - pad.b - ey) * f;
          i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
        }
        ctx.stroke();

        var cf = shown / steps;
        var cx = px(r.drift * cf), cy = ey + (H - pad.b - ey) * cf;
        if (!r.damaged) {
          ctx.strokeStyle = "#eef2f7"; ctx.lineWidth = 1.2;
          if (device === "streamer") {
            ctx.beginPath();
            for (var s = 0; s < 5; s++) ctx.lineTo(cx + (s % 2 ? 5 : -5), cy - 20 + s * 4);
            ctx.stroke();
          } else {
            ctx.fillStyle = "rgba(240,120,60,0.9)";
            ctx.beginPath(); ctx.arc(cx, cy - 18, 11, Math.PI, 0); ctx.fill();
            ctx.beginPath(); ctx.moveTo(cx - 11, cy - 18); ctx.lineTo(cx, cy - 6); ctx.lineTo(cx + 11, cy - 18); ctx.stroke();
          }
        }
        rocketGlyph(cx, cy, r.damaged ? Math.PI * 0.8 : 0, false, 1);

        phaseEl.textContent = p >= 1 ? "Landed" : "Descending";

        rows([
          ["Speed at ejection", Math.round(r.vEject) + " m/s"],
          ["Ejection altitude", ft(r.ejectAlt) + " ft"],
          ["Descent rate", r.descentV.toFixed(1) + " m/s"],
          ["Time aloft", r.totalAloft.toFixed(1) + " s"],
          ["Drift downwind", ft(r.drift) + " ft"]
        ]);

        if (p >= 1) {
          if (r.damaged) {
            verdict.dataset.tone = "bad";
            verdict.textContent = "Ejection at " + Math.round(r.vEject) + " m/s tore the recovery device — it is coming in ballistic. The delay is " + (r.overshoot < 0 ? "too short" : "too long") + ". Eject within about a second of apogee.";
          } else if (Math.abs(r.overshoot) > 1.2) {
            verdict.dataset.tone = "warn";
            verdict.textContent = "It survived, but ejection was " + Math.abs(r.overshoot).toFixed(1) + " s off apogee, so altitude was lost before the chute opened. Closer to apogee means more time aloft.";
          } else if (ft(r.drift) > 500) {
            verdict.dataset.tone = "warn";
            verdict.textContent = "Good deployment, but " + ft(r.drift) + " ft of drift — a long walk, and on a small field a lost rocket. A streamer trades time aloft for staying close.";
          } else {
            verdict.dataset.tone = "good";
            verdict.textContent = "Textbook. Ejection near apogee, " + r.totalAloft.toFixed(1) + " s aloft, landing " + ft(r.drift) + " ft downwind. This is how you win Time Aloft without losing the rocket.";
          }
        }
      }

      var runner = mode === "launch" ? runLaunch : runRecovery;
      function draw(p) { runner(p); }

      function animate() {
        if (raf) cancelAnimationFrame(raf);
        verdict.dataset.tone = ""; verdict.textContent = "";
        if (reduce) { draw(1); return; }
        var start = null, dur = mode === "launch" ? 2400 : 2800;
        function step(ts) {
          if (!start) start = ts;
          var p = Math.min(1, (ts - start) / dur);
          draw(p);
          if (p < 1) raf = requestAnimationFrame(step);
        }
        raf = requestAnimationFrame(step);
      }

      function bindOut(input, name) {
        var out = root.querySelector('[data-fsim-out="' + name + '"]');
        if (!input || !out) return;
        input.addEventListener("input", function () { out.textContent = input.value; draw(0); });
        out.textContent = input.value;
      }

      bindOut(paySlider, "payload");
      bindOut(root.querySelector("[data-fsim-delay]"), "delay");
      bindOut(root.querySelector("[data-fsim-wind]"), "wind");

      afSel.addEventListener("change", function () { refreshAirframe(); draw(0); });
      if (moSel) moSel.addEventListener("change", function () { draw(0); });
      var dev = root.querySelector("[data-fsim-device]");
      if (dev) dev.addEventListener("change", function () { draw(0); });

      root.querySelector("[data-fsim-run]").addEventListener("click", animate);
      root.querySelector("[data-fsim-reset]").addEventListener("click", function () {
        if (raf) cancelAnimationFrame(raf);
        verdict.dataset.tone = ""; verdict.textContent = "";
        phaseEl.textContent = "Ready";
        draw(0);
      });

      refreshAirframe();
      draw(0);
    }

    function init() {
      var all = document.querySelectorAll("[data-fsim]");
      for (var i = 0; i < all.length; i++) wire(all[i]);
    }
    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
