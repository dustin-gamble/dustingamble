---
// Orbital mechanics sandbox, two modes.
//   mode="ascent" — ground launch to orbit: pitch-over and delta-v
//   mode="moon"   — LEO to the Moon: trans-lunar injection burn and timing
//
// Real gravity, real constants, simplified thrust. The point is that Scouts
// feel why "going up" is the easy half and "going sideways fast enough" is
// the hard half.
const { mode = "ascent", id = mode } = Astro.props;
const isAscent = mode === "ascent";
---

<div class="osim" data-osim data-mode={mode} id={`osim-${id}`}>
  <div class="osim-head">
    <h4>{isAscent ? "Ground to orbit" : "Orbit to the Moon"}</h4>
    <p>
      {isAscent
        ? "Orbit is not about height, it is about sideways speed. Go straight up and you fall straight back. The trick is turning that climb into a horizontal velocity of about 7.8 km/s before the fuel runs out."
        : "You are already in a 300 km circular orbit. One burn at the right moment stretches that circle until its far end reaches the Moon — and the Moon has to arrive at the same place at the same time."}
    </p>
  </div>

  <div class="osim-body">
    <div class="osim-stage">
      <div class="osim-canvas-wrap">
        {!isAscent && <div class="osim-viewbar" role="group" aria-label="Camera view"><button data-camera="map" aria-pressed="true">✦ Mission map</button><button data-camera="fpv" aria-pressed="false">◉ Cockpit FPV</button><button data-look hidden>Look at Earth ↗</button></div>}
        <canvas data-osim-canvas width={isAscent?560:960} height={isAscent?440:540} role="img"
          aria-label={isAscent ? "Animated launch to orbit trajectory" : "Cartoon mission map: Earth, Moon, and the calculated spacecraft trajectory"}></canvas>
        <div class="osim-clock" data-osim-clock></div>
      </div>

      <!-- Run/Reset live under the picture, not at the foot of the control
           panel. The panel is far taller than the canvas, so a button down
           there meant pressing Burn with the trajectory scrolled off screen. -->
      <div class="osim-actions">
        <button type="button" class="osim-btn osim-btn-go" data-osim-run>
          {isAscent ? "Launch" : "Burn & fly →"}
        </button>
        <button type="button" class="osim-btn" data-osim-pause aria-pressed="false">Pause Ⅱ</button>
        <button type="button" class="osim-btn" data-osim-reset>Reset</button>
        {!isAscent && <label class="osim-scrub">Flight time<input data-osim-progress type="range" min="0" max="100" step=".1" value="0" aria-label="Flight progress"/></label>}
      </div>
      {!isAscent && <p class="osim-model-note">Simplified gravity model · cartoon worlds enlarged · cockpit camera faces the selected world</p>}
    </div>

    <div class="osim-panel">
      {isAscent ? (
        <>
          <label>
            Pitch-over altitude <output data-osim-out="pitch">12</output> km
            <input type="range" data-osim-pitch min="1" max="60" step="1" value="12" />
            <span class="osim-hint">How high you climb before starting to lean over.</span>
          </label>
          <label>
            Total &Delta;v <output data-osim-out="dv">9.8</output> km/s
            <input type="range" data-osim-dv min="6" max="12" step="0.1" value="9.8" />
            <span class="osim-hint">Your whole fuel budget, spent as one long burn. <strong data-osim-mph="dv"></strong></span>
          </label>
        </>
      ) : (
        <>
          <label>
            Injection burn <output data-osim-out="tli">3.14</output> km/s
            <input type="range" data-osim-tli min="2.80" max="3.40" step="0.01" value="3.14" />
            <span class="osim-hint">Added to your orbital speed, along the direction you are already travelling. <strong data-osim-mph="tli"></strong></span>
          </label>
          <label>
            Arrival braking burn <output data-osim-out="brake">0.00</output> km/s
            <input type="range" data-osim-brake min="0" max="1.20" step="0.05" value="0" />
            <span class="osim-hint">Fired at closest approach, against your motion relative to the Moon. Zero means you fly past; enough and the Moon captures you into orbit.</span>
          </label>
          <label>
            Moon lead angle <output data-osim-out="lead">130</output>&deg;
            <input type="range" data-osim-lead min="10" max="170" step="1" value="130" />
            <span class="osim-hint">How far ahead the Moon is when you light the engine. Aim where it will be, not where it is.</span>
          </label>
        </>
      )}

      {!isAscent && <p class="osim-task"><strong>TRY THIS</strong> Compare “Fly past” with “Enter lunar orbit.” What does the braking burn change?</p>}
      <div class="osim-presets" data-osim-presets hidden>
        <span class="osim-presets-lab">Try one</span>
        <button type="button" class="osim-preset" data-preset="3.14|130|0">Fly past the Moon</button>
        <button type="button" class="osim-preset" data-preset="3.14|134|0">Impact the Moon</button>
        <button type="button" class="osim-preset" data-preset="3.14|130|0.80">Enter lunar orbit</button>
        <button type="button" class="osim-preset" data-preset="3.14|60|0">Miss it entirely</button>
        <button type="button" class="osim-preset" data-preset="2.90|130|0">Not enough burn</button>
      </div>

      <dl class="osim-readout" data-osim-readout></dl>
      <p class="osim-verdict" data-osim-verdict></p>
    </div>
  </div>

  <p class="osim-foot">
    {isAscent
      ? "Earth radius 6,371 km, μ = 398,600 km³/s². Thrust is modelled as a constant 30 m/s² along a simple gravity-turn program — real rockets throttle and stage."
      : "Teaching model, not an Apollo reconstruction. Earth + Moon gravity; circular lunar orbit at 384,400 km. Cartoon worlds enlarged. Cockpit camera faces the selected world. A real mission must also plan landing and return."}
  </p>
</div>

<style>
  .osim {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1rem 1.15rem 1.1rem;
  }

  .osim-head h4 { margin: 0 0 0.3rem; font-size: 1.05rem; }
  .osim-head p { margin: 0 0 0.9rem; font-size: 0.9rem; color: var(--muted); line-height: 1.55; }

  .osim-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, 19rem); gap: 1.1rem; align-items: start; }

  .osim-stage { display: grid; gap: 0.6rem; align-content: start; }
  .osim-canvas-wrap { position: relative; }

  .osim-stage canvas {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #05070f;
  }

  .osim-clock {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
  }

  .osim-panel { display: grid; gap: 0.8rem; }
  .osim-panel label { display: grid; gap: 0.28rem; font-size: 0.82rem; font-weight: 600; }
  .osim-panel input[type="range"] { width: 100%; }
  .osim-hint { font-weight: 400; font-size: 0.76rem; color: var(--muted); line-height: 1.45; }

  .osim-panel output {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-weight: 700;
    color: var(--accent-strong);
  }

  .osim-readout {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.22rem 0.6rem;
    margin: 0;
    padding: 0.6rem 0.7rem;
    border-radius: 10px;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    font-size: 0.82rem;
  }

  .osim-readout dt { color: var(--muted); }

  .osim-readout dd {
    margin: 0;
    text-align: right;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .osim-verdict {
    margin: 0;
    min-height: 3.2rem;
    font-size: 0.84rem;
    line-height: 1.5;
    padding: 0.5rem 0.65rem;
    border-radius: 8px;
    border-left: 3px solid var(--line);
    background: var(--bg-alt);
  }

  .osim-verdict[data-tone="good"] { border-left-color: #3d8b58; }
  .osim-verdict[data-tone="warn"] { border-left-color: #d8a13a; }
  .osim-verdict[data-tone="bad"] { border-left-color: #c8532b; }

  .osim-presets { display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: center; }

  .osim-presets-lab {
    font-size: 0.68rem; letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--muted); width: 100%;
  }

  .osim-preset {
    font: inherit; font-size: 0.72rem; padding: 0.24rem 0.6rem;
    border-radius: 999px; border: 1px solid var(--line);
    background: transparent; color: var(--muted); cursor: pointer;
  }

  .osim-preset:hover { border-color: var(--accent); color: var(--accent-strong); background: var(--accent-soft); }

  .osim-actions { display: flex; gap: 0.4rem; justify-content: center; }

  .osim-btn {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .osim-btn:hover { border-color: var(--accent); color: var(--accent-strong); }

  .osim-btn-go {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 700;
  }

  :root[data-theme="dark"] .osim-btn-go { color: #0f1623; }

  .osim-foot { margin: 0.9rem 0 0; font-size: 0.78rem; color: var(--muted); line-height: 1.5; }

  @media (max-width: 760px) {
    .osim-body { grid-template-columns: 1fr; }
  }

  .osim-model-note{font-size:9px;line-height:1.35;color:var(--muted);margin:0}
  .osim-viewbar{display:flex;gap:6px;align-items:center;margin:0 0 8px;flex-wrap:wrap}.osim-viewbar button{font:inherit;font-size:11px;cursor:pointer;color:#bed4e9;border:1px solid #466079;background:#152b43;padding:8px 12px;border-radius:7px}.osim-viewbar button[aria-pressed=true]{background:#a4e8d6;border-color:#a4e8d6;color:#14382f}.osim-viewbar [data-look]{margin-left:auto}.osim-viewbar [hidden]{display:none}.osim-actions{flex-wrap:wrap;justify-content:flex-start;align-items:center}.osim-scrub{display:flex;align-items:center;gap:9px;font-size:10px;margin-left:auto;color:var(--muted)}.osim-scrub input{width:90px;accent-color:#8de1ce}.osim-task{font-size:12px;line-height:1.4;margin:0;padding:9px 11px;border:1px solid #416473;border-radius:8px;background:#23444a44}.osim-task strong{display:block;font-size:8px;letter-spacing:.12em;color:var(--accent-strong);margin-bottom:4px}.osim[data-mode=moon] .osim-clock{top:54px;left:14px;font-size:11px;background:#0a1629bb;color:#bbeedf}.osim[data-mode=moon] .osim-stage canvas{height:clamp(260px,43vh,440px);object-fit:fill;background:#0b1426}.osim button:focus-visible{outline:3px solid #ffd998;outline-offset:3px}
  :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-body){grid-template-columns:minmax(0,1fr) 270px;gap:24px}
  :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-stage canvas){max-height:43vh;width:100%}
  :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-head){display:none}
  :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-panel label){display:block;font-size:11px;line-height:1.2}
  :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-panel output){display:inline;margin-left:7px}
  :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-panel input){display:block;margin:8px 0 0}
  :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-panel){gap:12px}
  :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-verdict){font-size:11px;min-height:52px;line-height:1.4}
  @media(max-width:760px){.osim-body{grid-template-columns:1fr}.osim-viewbar button{font-size:10px;padding:7px 9px}.osim-task{font-size:11px}.osim-scrub{margin-left:0}.osim[data-mode=moon] .osim-clock{top:48px;font-size:10px}}

  @media(max-width:650px){
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-body){grid-template-columns:1fr;gap:9px}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-stage canvas){height:24vh;max-height:24vh}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-panel){grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-panel>label){font-size:9px}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-panel>label output){margin-left:0;display:inline}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-panel>:not(label)){grid-column:1/-1}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-task){font-size:10px;padding:6px 8px}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-presets-lab){display:none}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-preset){font-size:9px}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-readout){font-size:10px;gap:2px 5px}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-verdict){font-size:10px;min-height:0;padding:6px 8px}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-actions){gap:5px}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-btn){font-size:10px;padding:6px 9px}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-scrub input){width:68px}
    :global(.deck-stage.is-projecting.is-projecting .osim[data-mode=moon] .osim-scrub){font-size:8px;gap:5px}
  }
</style>

<script is:inline>
  (function () {
    var RE = 6371;          // km
    var MU_E = 398600;      // km^3/s^2
    var MU_M = 4902.8;
    var RM = 1737;          // km
    var DM = 384400;        // km
    var MOON_W = (2 * Math.PI) / (27.32 * 86400); // rad/s

    function grav(rx, ry, mu) {
      var r = Math.hypot(rx, ry);
      var k = -mu / (r * r * r);
      return [k * rx, k * ry, r];
    }

    // ---------- ascent ----------
    function simAscent(pitchKm, dvKms) {
      var acc = 0.030;                  // km/s^2, about 3 g — typical of a real launcher
      var burn = dvKms / acc;           // s
      var x = 0, y = RE, vx = 0, vy = 0, t = 0;
      var pts = [], maxAlt = 0;

      for (var i = 0; i < 200000; i++) {
        var r = Math.hypot(x, y);
        var alt = r - RE;
        if (alt > maxAlt) maxAlt = alt;
        if (alt < -1) break;
        if (t > burn + 20000) break;
        // Small steps under thrust, larger ones out on the coast — a fixed step
        // big enough to finish the coast loses enough energy to fake a decaying orbit.
        var dt = t < burn ? 0.5 : Math.max(1, Math.min(30, r / 2500));

        var upx = x / r, upy = y / r;
        var thx = 0, thy = 0;
        if (t < burn) {
          // gravity turn: vertical until pitchKm, then lean toward horizontal by 120 km
          var f = Math.min(1, Math.max(0, (alt - pitchKm) / (80 - pitchKm)));
          var ang = (Math.PI / 2) * f;
          var hx = -upy, hy = upx;   // local horizontal, prograde
          thx = acc * (Math.cos(ang) * upx + Math.sin(ang) * hx);
          thy = acc * (Math.cos(ang) * upy + Math.sin(ang) * hy);
        }
        var g = grav(x, y, MU_E);
        vx += (g[0] + thx) * dt;
        vy += (g[1] + thy) * dt;
        x += vx * dt; y += vy * dt;
        t += dt;
        if (i % 5 === 0 && pts.length < 4000) pts.push([x, y, t <= burn]);
      }

      // classify the resulting orbit from the final state
      var rf = Math.hypot(x, y), vf = Math.hypot(vx, vy);
      var energy = (vf * vf) / 2 - MU_E / rf;
      var hAng = x * vy - y * vx;
      var a = -MU_E / (2 * energy);
      var e = Math.sqrt(Math.max(0, 1 - (hAng * hAng) / (MU_E * a)));
      var peri = a * (1 - e) - RE;
      var apo = a * (1 + e) - RE;

      return {
        pts: pts, maxAlt: maxAlt, burn: burn, energy: energy,
        peri: peri, apo: apo, e: e, vFinal: vf, t: t,
        escaped: energy >= 0, orbited: energy < 0 && peri > 100
      };
    }

    // ---------- trans-lunar ----------
    function simMoon(tliKms, leadDeg, brakeKms) {
      var r0 = RE + 300;
      var vCirc = Math.sqrt(MU_E / r0);
      var x = r0, y = 0;
      var vx = 0, vy = vCirc + tliKms;
      var moonTheta = (leadDeg * Math.PI) / 180;
      var t = 0;
      var pts = [], moonPts = [];
      var closest = 1e9, tClosest = 0, impact = false, apo = 0;
      var prevDr = 1e12, braked = false, maxAfter = 0, burnPt = null;
      var burnTime = null;

      for (var i = 0; i < 400000; i++) {
        var rNow = Math.hypot(x, y);
        // Adaptive: ~1 s down at perigee where the path bends hard, up to 60 s
        // out near the Moon. A fixed step loses energy and undershoots badly.
        var dt = Math.max(1, Math.min(60, rNow / 2500));
        var mx = DM * Math.cos(moonTheta + MOON_W * t);
        var my = DM * Math.sin(moonTheta + MOON_W * t);

        var ge = grav(x, y, MU_E);
        var dx = x - mx, dy = y - my;
        var dRel = Math.hypot(dx, dy);
        var km = -MU_M / (dRel * dRel * dRel);

        // Lunar orbit insertion: fire exactly at closest approach, against the
        // velocity relative to the Moon. This is what turns a flyby into an orbit.
        if (brakeKms > 0 && !braked && dRel > prevDr && dRel < 80000) {
          var mvx = -DM * MOON_W * Math.sin(moonTheta + MOON_W * t);
          var mvy = DM * MOON_W * Math.cos(moonTheta + MOON_W * t);
          var rvx = vx - mvx, rvy = vy - mvy, rv = Math.hypot(rvx, rvy);
          var k = Math.min(brakeKms, rv * 0.9) / rv;
          vx -= rvx * k; vy -= rvy * k;
          braked = true; burnPt = [x, y]; burnTime = t;
        }
        prevDr = dRel;

        vx += (ge[0] + km * dx) * dt;
        vy += (ge[1] + km * dy) * dt;
        x += vx * dt; y += vy * dt;
        t += dt;

        var rr = Math.hypot(x, y);
        if (rr > apo) apo = rr;
        if (dRel < closest) { closest = dRel; tClosest = t; }
        if (braked && dRel > maxAfter) maxAfter = dRel;
        if (dRel < RM) { impact = true; }
        if (rr < RE) break;               // fell back into the atmosphere
        if (impact) break;
        if (t > 16 * 86400) break;

        if (i % 60 === 0 && pts.length < 4000) { pts.push([x, y, t]); moonPts.push([mx, my]); }
      }

      return {
        pts: pts, moonPts: moonPts, closest: closest, tClosest: tClosest,
        impact: impact, apogee: apo - RE, t: t, reached: closest < 66000,
        braked: braked, burnPt: burnPt, burnTime: burnTime,
        captured: braked && maxAfter < 66000 && !impact
      };
    }

    function fmtKm(v) {
      if (v >= 10000) return Math.round(v / 1000) + ",000 km".replace("000 km", "000 km");
      return Math.round(v).toLocaleString() + " km";
    }
    function km(v) { return Math.round(v).toLocaleString() + " km"; }
    function mph(kms) { return Math.round(kms * 2236.94).toLocaleString() + " mph"; }

    function wire(root) {
      if (root.dataset.osimWired) return;
      root.dataset.osimWired = "1";
      var mode = root.dataset.mode;
      var cv = root.querySelector("[data-osim-canvas]");
      var ctx = cv.getContext("2d");
      var clock = root.querySelector("[data-osim-clock]");
      var readout = root.querySelector("[data-osim-readout]");
      var verdict = root.querySelector("[data-osim-verdict]");
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var raf = null, spin = 0, idle = null, visible = false, lastP = 0;
      var camera='map',look='moon',localPaused=false,moonCache=null,moonKey='';
      var canvasW=cv.width,canvasH=cv.height;

      function rows(pairs) {
        readout.innerHTML = pairs.map(function (p) { return "<dt>" + p[0] + "</dt><dd>" + p[1] + "</dd>"; }).join("");
      }

      function bindOut(input, name, digits) {
        var out = root.querySelector('[data-osim-out="' + name + '"]');
        if (!input || !out) return;
        var mphEl = root.querySelector('[data-osim-mph="' + name + '"]');
        var sync = function () {
          out.textContent = digits ? (+input.value).toFixed(digits) : input.value;
          if (mphEl) mphEl.textContent = "= " + mph(+input.value);
        };
        input.addEventListener("input", function () { sync(); if(raf)cancelAnimationFrame(raf);raf=null;lastP=0;verdict.textContent='';draw(0); });
        sync();
      }

      function stars(W, H) {
        ctx.fillStyle = "#05070f"; ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = "rgba(255,255,255,0.5)";
        for (var i = 0; i < 90; i++) {
          var sx = (i * 9973) % W, sy = (i * 7919) % H;
          ctx.fillRect(sx, sy, 1, 1);
        }
      }

      function earth(cx, cy, rpx, spin) {
        var g = ctx.createRadialGradient(cx - rpx * 0.3, cy - rpx * 0.35, rpx * 0.1, cx, cy, rpx);
        g.addColorStop(0, "#5fa8e8");
        g.addColorStop(0.6, "#1f5f9e");
        g.addColorStop(1, "#0d2b4d");
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(cx, cy, rpx, 0, 7); ctx.fill();

        // Meridians that sweep round, so the planet reads as turning under the orbit.
        if (rpx > 24) {
          ctx.save();
          ctx.beginPath(); ctx.arc(cx, cy, rpx, 0, 7); ctx.clip();
          ctx.strokeStyle = "rgba(160,215,255,0.30)"; ctx.lineWidth = 1;
          for (var m = 0; m < 6; m++) {
            var ph = (spin || 0) + (m * Math.PI) / 3;
            var w = Math.cos(ph) * rpx;
            if (w <= 0) continue;
            ctx.beginPath();
            ctx.ellipse(cx, cy, Math.abs(w), rpx, 0, 0, Math.PI * 2);
            ctx.stroke();
          }
          ctx.strokeStyle = "rgba(160,215,255,0.22)";
          ctx.beginPath(); ctx.ellipse(cx, cy, rpx, rpx * 0.34, 0, 0, Math.PI * 2); ctx.stroke();
          ctx.restore();
        }

        ctx.strokeStyle = "rgba(120,190,255,0.35)"; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.arc(cx, cy, rpx * 1.035, 0, 7); ctx.stroke();
      }

      function planetFace(cx,cy,r,kind) {
        ctx.save();ctx.translate(cx,cy);
        var g=ctx.createRadialGradient(-r*.4,-r*.5,0,r*.2,r*.2,r*1.4);
        g.addColorStop(0,kind==='earth'?'#8ee2eb':'#fff0cb');g.addColorStop(1,kind==='earth'?'#2672ae':'#889ab7');
        ctx.shadowColor=kind==='earth'?'#65ddeb':'#dbe4ff';ctx.shadowBlur=r*.25;
        ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,r,0,7);ctx.fill();ctx.shadowBlur=0;
        ctx.save();ctx.beginPath();ctx.arc(0,0,r,0,7);ctx.clip();
        if(kind==='earth'){
          ctx.fillStyle='#a8e6ad';
          [[[-.75,-.5],[-.28,-.79],[.03,-.46],[-.28,-.13],[-.14,.13],[-.48,.32],[-.83,.03]],[[.3,.12],[.71,-.01],[.8,.37],[.37,.75],[.14,.51]]].forEach(poly=>{ctx.beginPath();poly.forEach((p,i)=>i?ctx.lineTo(p[0]*r,p[1]*r):ctx.moveTo(p[0]*r,p[1]*r));ctx.closePath();ctx.fill();});
          ctx.strokeStyle='#e9fbff99';ctx.lineWidth=r*.08;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(-r*.58,-r*.38);ctx.quadraticCurveTo(-r*.2,-r*.55,r*.15,-r*.37);ctx.stroke();
        }else{
          [[-.44,-.4,.21],[.49,.24,.23],[.34,-.59,.12],[-.5,.53,.12]].forEach(c=>{ctx.fillStyle='#7f91af55';ctx.beginPath();ctx.arc(c[0]*r,c[1]*r,c[2]*r,0,7);ctx.fill();ctx.strokeStyle='#f9f1df66';ctx.lineWidth=2;ctx.stroke();});
        }
        ctx.restore();ctx.fillStyle='#20334c';[-.2,.2].forEach(x=>{ctx.beginPath();ctx.ellipse(x*r,.08*r,.055*r,.078*r,0,0,7);ctx.fill();});ctx.strokeStyle='#20334c';ctx.lineWidth=Math.max(2,r*.045);ctx.lineCap='round';ctx.beginPath();ctx.arc(0,.19*r,.16*r,.2,Math.PI-.2);ctx.stroke();ctx.fillStyle='#f2a9a266';[-.38,.38].forEach(x=>{ctx.beginPath();ctx.ellipse(x*r,.24*r,.1*r,.055*r,0,0,7);ctx.fill();});ctx.restore();
      }
      function capsule(x,y,angle,burning){
        ctx.save();ctx.translate(x,y);ctx.rotate(angle);ctx.lineWidth=2;
        if(burning){ctx.fillStyle='#ffb66d';ctx.beginPath();ctx.moveTo(-14,-6);ctx.quadraticCurveTo(-48,0,-14,6);ctx.fill();ctx.fillStyle='#fff1b3';ctx.beginPath();ctx.moveTo(-14,-3);ctx.lineTo(-34,0);ctx.lineTo(-14,3);ctx.fill();}
        ctx.fillStyle='#f4ede1';ctx.strokeStyle='#8da5bc';ctx.beginPath();ctx.moveTo(-13,-13);ctx.quadraticCurveTo(8,-12,21,0);ctx.quadraticCurveTo(8,12,-13,13);ctx.closePath();ctx.fill();ctx.stroke();ctx.fillStyle='#6ed5e5';ctx.beginPath();ctx.ellipse(5,0,6,5,0,0,7);ctx.fill();ctx.fillStyle='#8ea6b8';ctx.fillRect(-18,-11,5,22);ctx.restore();
      }
      function cockpit(cur,mp,elapsed,W,H){
        stars(W,H);var dx=mp[0]-cur[0],dy=mp[1]-cur[1],distance=Math.hypot(dx,dy);var lookingEarth=look==='earth';
        var targetDistance=lookingEarth?Math.hypot(cur[0],cur[1]):distance;
        var radius=lookingEarth?RE:RM;
        // A Moon/Earth-facing illustration, not a reconstructed Apollo attitude view.
        var apparent=Math.min(H*.32,Math.max(H*.18,Math.atan2(radius,targetDistance)*W*1.6));
        planetFace(W*.5,H*.4,apparent,lookingEarth?'earth':'moon');
        ctx.strokeStyle='#9eeed166';ctx.lineWidth=1;ctx.setLineDash([4,8]);ctx.beginPath();ctx.moveTo(W*.5-90,H*.4);ctx.lineTo(W*.5+90,H*.4);ctx.moveTo(W*.5,H*.4-90);ctx.lineTo(W*.5,H*.4+90);ctx.stroke();ctx.setLineDash([]);
        ctx.fillStyle='#a8e3dd';ctx.font='14px ui-monospace, monospace';ctx.textAlign='center';ctx.fillText((lookingEarth?'EARTH':'MOON')+'  /  '+km(Math.max(0,targetDistance-radius))+' TO SURFACE',W*.5,H*.4+Math.max(apparent+30,110));
        ctx.fillStyle='#263a50';ctx.strokeStyle='#65788d';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(W*.08,0);ctx.lineTo(W*.17,H*.79);ctx.lineTo(W*.83,H*.79);ctx.lineTo(W*.92,0);ctx.lineTo(W,0);ctx.lineTo(W,H);ctx.lineTo(0,H);ctx.closePath();ctx.fill();ctx.stroke();
        ctx.fillStyle='#132237';ctx.fillRect(W*.2,H*.83,W*.6,H*.17);ctx.fillStyle='#a7f0d5';ctx.textAlign='left';ctx.font='bold '+(W<500?9:16)+'px ui-monospace, monospace';ctx.fillText('APOLLO FLIGHT LAB',W*.23,H*.89);ctx.font=(W<500?9:13)+'px ui-monospace, monospace';ctx.fillText('T + '+elapsed.toFixed(2)+' DAYS',W*.23,H*.95);ctx.textAlign='right';ctx.fillText('COAST / GRAVITY ACTIVE',W*.76,H*.89);ctx.fillText('LOOK: '+(lookingEarth?'HOME':'MOON'),W*.76,H*.95);ctx.textAlign='left';
        [[.05,.16],[.09,.5],[.91,.5],[.95,.16]].forEach(p=>{ctx.fillStyle='#a8bbc7';ctx.beginPath();ctx.arc(W*p[0],H*p[1],4,0,7);ctx.fill();});
      }

      // ---------- ascent draw ----------
      function drawAscent(p) {
        var pitch = +root.querySelector("[data-osim-pitch]").value;
        var dv = +root.querySelector("[data-osim-dv]").value;
        var r = simAscent(pitch, dv);
        r.spin = spin;
        var W = mode==='moon'?canvasW:cv.width, H = mode==='moon'?canvasH:cv.height;
        stars(W, H);

        // FIXED view. Earth is the same size at every setting — otherwise the
        // picture silently rescales and every trajectory looks identical.
        var span = RE * 2.6;
        var scale = (Math.min(W, H) / 2 - 14) / span;
        var cx = W / 2, cy = H / 2;

        earth(cx, cy, RE * scale, r.spin);

        var n = Math.max(2, Math.floor(r.pts.length * p));
        ctx.lineWidth = 2;
        for (var i2 = 1; i2 < n; i2++) {
          var a = r.pts[i2 - 1], b = r.pts[i2];
          ctx.strokeStyle = b[2] ? "rgba(255,170,60,0.95)" : "rgba(120,200,255,0.9)";
          ctx.beginPath();
          ctx.moveTo(cx + a[0] * scale, cy - a[1] * scale);
          ctx.lineTo(cx + b[0] * scale, cy - b[1] * scale);
          ctx.stroke();
        }
        var cur = r.pts[n - 1];
        if (cur) {
          ctx.fillStyle = "#fff";
          ctx.beginPath(); ctx.arc(cx + cur[0] * scale, cy - cur[1] * scale, 3.2, 0, 7); ctx.fill();
        }

        ctx.fillStyle = "rgba(255,255,255,0.6)";
        ctx.font = "10px ui-monospace, monospace";
        ctx.fillText("orange = engine burning", 10, H - 22);
        ctx.fillText("blue = coasting", 10, H - 10);

        clock.textContent = "burn " + Math.round(r.burn) + " s";

        rows([
          ["Peak altitude", km(r.maxAlt)],
          ["Final speed", r.vFinal.toFixed(2) + " km/s (" + mph(r.vFinal) + ")"],
          ["Perigee", r.peri > -RE ? km(r.peri) : "—"],
          ["Apogee", r.apo > 0 && !r.escaped ? km(r.apo) : r.escaped ? "escaped" : "—"],
          ["Eccentricity", r.e.toFixed(3)]
        ]);

        if (p >= 1) {
          if (r.escaped) {
            verdict.dataset.tone = "warn";
            verdict.textContent = "You left Earth entirely. More Δv than an orbit needs — useful if you are going to Mars, wasteful if you wanted a satellite.";
          } else if (r.peri < 100) {
            verdict.dataset.tone = "bad";
            verdict.textContent = "Suborbital. You went up " + km(r.maxAlt) + " and came back down — the path is still an ellipse whose low point is inside the Earth. Height was never the problem; you need more sideways speed.";
          } else if (r.e > 0.25) {
            verdict.dataset.tone = "warn";
            verdict.textContent = "You are in orbit, but a lopsided one: " + km(r.peri) + " at the low point, " + km(r.apo) + " at the high point. Pitching over earlier trades altitude for the horizontal speed that rounds it out.";
          } else {
            verdict.dataset.tone = "good";
            verdict.textContent = "Orbit. Near-circular at roughly " + km(r.peri) + ", moving " + r.vFinal.toFixed(2) + " km/s sideways. That sideways number is the whole game — at this speed the ground curves away as fast as you fall.";
          }
        }
      }

      // ---------- moon draw ----------
      function drawMoon(p) {
        var tli = +root.querySelector("[data-osim-tli]").value;
        var lead = +root.querySelector("[data-osim-lead]").value;
        var brakeEl = root.querySelector("[data-osim-brake]");
        var key=tli+'|'+lead+'|'+(brakeEl?brakeEl.value:0);
        if(key!==moonKey||!moonCache){moonCache=simMoon(tli,lead,brakeEl?+brakeEl.value:0);moonKey=key;}
        var r=moonCache;
        r.spin = spin;
        var W = mode==='moon'?canvasW:cv.width, H = mode==='moon'?canvasH:cv.height;
        stars(W, H);

        var span = DM * 1.18;
        var scale = (Math.min(W, H) / 2 - 16) / span;
        var cx = W / 2, cy = H / 2;

        // Moon's orbit
        ctx.strokeStyle = "rgba(255,255,255,0.16)";
        ctx.setLineDash([4, 6]); ctx.lineWidth = 1;
        ctx.beginPath(); ctx.arc(cx, cy, DM * scale, 0, 7); ctx.stroke();
        ctx.setLineDash([]);

        planetFace(cx,cy,42,'earth');
        ctx.fillStyle='#acd8e8';ctx.font='bold 13px ui-sans-serif,system-ui,sans-serif';ctx.textAlign='center';ctx.fillText('EARTH',cx,cy+61);ctx.textAlign='left';

        var n = Math.max(2, Math.floor(r.pts.length * p));
        ctx.strokeStyle = "#9af1d8"; ctx.lineWidth = 3;
        ctx.beginPath();
        for (var i = 0; i < n; i++) {
          var q = r.pts[i];
          var px = cx + q[0] * scale, py = cy - q[1] * scale;
          i ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
        }
        ctx.stroke();

        var mp = r.moonPts[n - 1] || r.moonPts[0];
        if (mp) {
          var mx = cx + mp[0] * scale, my = cy - mp[1] * scale;
          planetFace(mx,my,25,'moon');
          ctx.fillStyle='#ece1c9';ctx.font='bold 12px ui-sans-serif,system-ui,sans-serif';ctx.textAlign='center';ctx.fillText('MOON',mx,my+41);ctx.textAlign='left';
        }
        if (r.burnPt && r.pts[n-1] && r.pts[n-1][2]>=r.burnTime) {
          ctx.strokeStyle = "#ffb45c"; ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(cx + r.burnPt[0] * scale, cy - r.burnPt[1] * scale, 7, 0, 7);
          ctx.stroke();
          ctx.fillStyle = "rgba(255,180,92,0.9)"; ctx.font = "10px ui-monospace, monospace";
          ctx.fillText("braking burn", cx + r.burnPt[0] * scale + 10, cy - r.burnPt[1] * scale - 8);
        }
        var cur = r.pts[n-1] || r.pts[0];
        if(cur){var prev=r.pts[Math.max(0,n-2)]||cur;capsule(cx+cur[0]*scale,cy-cur[1]*scale,Math.atan2(-(cur[1]-prev[1]),cur[0]-prev[0]),p<.03);}
        var days=cur?cur[2]/86400:0;
        clock.textContent='T + '+days.toFixed(2)+' days';
        if(camera==='fpv'&&cur&&mp)cockpit(cur,mp,days,W,H);
        else{ctx.fillStyle='#9eb4cb';ctx.font='12px ui-sans-serif,system-ui,sans-serif';ctx.fillText(W<500?'ENLARGED WORLDS · TEACHING MODEL':'CARTOON WORLDS ENLARGED · CALCULATED FLIGHT PATH',18,H-17);}
        var distance=cur&&mp?Math.hypot(cur[0]-mp[0],cur[1]-mp[1])-RM:0;
        rows([['Moon surface now',km(Math.max(0,distance))],['Closest approach',r.impact?'impact':km(Math.max(0,r.closest-RM))+' altitude'],['Time to closest',(r.tClosest/86400).toFixed(1)+' days']]);
        var scrub=root.querySelector('[data-osim-progress]');if(scrub)scrub.value=String(p*100);
        if(p<1){verdict.dataset.tone='';verdict.textContent=p===0?'Set a burn and a lead angle, then predict: flyby, orbit, or miss?':'Watch the Moon move. Your spacecraft must meet it at the right time.';}

        if (p >= 1) {
          if (r.captured) {
            verdict.dataset.tone = "good";
            verdict.textContent = "Captured. The braking burn at closest approach killed enough speed for the Moon's gravity to hold you — you are in lunar orbit. This is the burn Apollo called LOI, and getting it wrong in either direction is how you either hit the Moon or sail past it forever.";
          } else if (r.impact) {
            verdict.dataset.tone = "warn";
            verdict.textContent = "You hit the Moon. Fine for a probe like Ranger, bad for a crew. Apollo aimed to miss by a few hundred kilometres and then braked into orbit.";
          } else if (r.braked) {
            verdict.dataset.tone = "warn";
            verdict.textContent = "You burned, but not hard enough — closest approach " + km(r.closest) + " and then away again. More braking burn.";
          } else if (r.reached) {
            verdict.dataset.tone = "good";
            verdict.textContent = "Lunar encounter — " + km(r.closest) + " at closest approach after " + (r.tClosest / 86400).toFixed(1) + " days. Apollo took about three. From here a braking burn drops you into lunar orbit.";
          } else if (r.apogee < DM - RE - 30000) {
            verdict.dataset.tone = "bad";
            verdict.textContent = "You did not get out that far — apogee " + km(r.apogee) + " against a Moon orbiting at " + km(DM) + ". You need more burn before timing even matters.";
          } else {
            verdict.dataset.tone = "warn";
            verdict.textContent = "You reached the Moon's distance but missed by " + km(r.closest) + ". Right altitude, wrong timing — change the lead angle so the Moon arrives when you do.";
          }
        }
      }

      var runner = mode === "ascent" ? drawAscent : drawMoon;
      function draw(p) { lastP=p;runner(p); }

      function animate() {
        if (raf) cancelAnimationFrame(raf);
        verdict.dataset.tone = ""; verdict.textContent = "";
        if (reduce) { draw(1); return; }
        localPaused=false;root.querySelector('[data-osim-pause]').setAttribute('aria-pressed','false');root.querySelector('[data-osim-pause]').textContent='Pause Ⅱ';
        var start = null, dur = mode==='moon'?16000:5000;
        var previous = null;
        function step(ts) {
          if (!start) start = ts;
          if (localPaused || root.closest('[data-motion-paused="true"]') || !root.getClientRects().length || document.hidden) {
            if(previous!==null)start += ts-previous;
            previous=ts; raf=requestAnimationFrame(step);return;
          }
          previous=ts;
          var p = Math.min(1, (ts - start) / dur);
          spin += 0.006; lastP = p;
          draw(p);
          if (p < 1) raf = requestAnimationFrame(step); else raf = null;
        }
        raf = requestAnimationFrame(step);
      }

      bindOut(root.querySelector("[data-osim-pitch]"), "pitch");
      bindOut(root.querySelector("[data-osim-dv]"), "dv", 1);
      bindOut(root.querySelector("[data-osim-tli]"), "tli", 2);
      bindOut(root.querySelector("[data-osim-lead]"), "lead");
      bindOut(root.querySelector("[data-osim-brake]"), "brake", 2);

      // Presets — each one verified numerically before being offered.
      var presetWrap = root.querySelector("[data-osim-presets]");
      if (presetWrap && mode === "moon") {
        presetWrap.hidden = false;
        var pbs = presetWrap.querySelectorAll("[data-preset]");
        for (var q = 0; q < pbs.length; q++) {
          (function (btn) {
            btn.addEventListener("click", function () {
              var v = btn.dataset.preset.split("|");
              var set = function (sel, val) {
                var el = root.querySelector(sel);
                if (el) { el.value = val; el.dispatchEvent(new Event("input")); }
              };
              set("[data-osim-tli]", v[0]);
              set("[data-osim-lead]", v[1]);
              set("[data-osim-brake]", v[2]);
              animate();
            });
          })(pbs[q]);
        }
      }

      function idleSpin() {
        idle = requestAnimationFrame(function () {
          if (visible && !raf && !localPaused && !root.closest('[data-motion-paused="true"]') && !document.hidden) { spin += 0.0035; draw(lastP); }
          idleSpin();
        });
      }
      if (!reduce && "IntersectionObserver" in window) {
        new IntersectionObserver(function (es) { visible = es[0].isIntersecting; })
          .observe(root);
        idleSpin();
      }

      root.querySelectorAll('[data-camera]').forEach(function(b){b.addEventListener('click',function(){camera=b.dataset.camera;root.querySelectorAll('[data-camera]').forEach(function(el){el.setAttribute('aria-pressed',String(el===b));});root.querySelector('[data-look]').hidden=camera!=='fpv';cv.setAttribute('aria-label',camera==='map'?'Cartoon mission map: Earth, Moon, and the calculated spacecraft trajectory':'Stylized cockpit view facing '+look+'; distance comes from the flight simulation');draw(lastP);});});
      var lookButton=root.querySelector('[data-look]');if(lookButton)lookButton.addEventListener('click',function(){look=look==='moon'?'earth':'moon';lookButton.textContent=look==='moon'?'Look at Earth ↗':'Look at Moon ↗';cv.setAttribute('aria-label','Stylized cockpit view facing '+look+'; distance comes from the flight simulation');draw(lastP);});
      var scrub=root.querySelector('[data-osim-progress]');if(scrub)scrub.addEventListener('input',function(){if(raf)cancelAnimationFrame(raf);raf=null;draw(Number(scrub.value)/100);});
      root.querySelector('[data-osim-pause]').addEventListener('click',function(){localPaused=!localPaused;this.setAttribute('aria-pressed',String(localPaused));this.textContent=localPaused?'Resume ▶':'Pause Ⅱ';});
      root.querySelector("[data-osim-run]").addEventListener("click", animate);
      root.querySelector("[data-osim-reset]").addEventListener("click", function () {
        if (raf) cancelAnimationFrame(raf);raf=null;localPaused=false;
        root.querySelector('[data-osim-pause]').setAttribute('aria-pressed','false');root.querySelector('[data-osim-pause]').textContent='Pause Ⅱ';
        verdict.dataset.tone = ""; verdict.textContent = "";
        draw(0);
      });

      if(mode==='moon'&&'ResizeObserver' in window){new ResizeObserver(function(){var r=cv.getBoundingClientRect();if(r.width<1||r.height<1)return;canvasW=r.width;canvasH=r.height;var d=Math.min(devicePixelRatio||1,2);cv.width=Math.round(canvasW*d);cv.height=Math.round(canvasH*d);ctx.setTransform(d,0,0,d,0,0);draw(lastP);}).observe(cv);}
      draw(0);
    }

    function init() {
      var all = document.querySelectorAll("[data-osim]");
      for (var i = 0; i < all.length; i++) wire(all[i]);
    }
    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
