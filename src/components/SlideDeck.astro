---
// Presentable slide deck for troop meetings. Keyboard-driven, fullscreen-able,
// with a presenter-notes panel that stays off the projected slide.
//
// Slide types: title | prompt | bullets | twocol | video | parts | calculator | charrette
import RocketPartsDiagram from "./RocketPartsDiagram.astro";
import MotorCutaway from "./MotorCutaway.astro";
import MissionControl from "./MissionControl.astro";
import FlightSim from "./FlightSim.astro";
import OrbitSim from "./OrbitSim.astro";
import SlideArt from "./SlideArt.astro";
import SlideImage from "./SlideImage.astro";
import LaunchOps from "./LaunchOps.astro";

const { deck } = Astro.props;
const slides = deck.slides;
---

<section class="deck" data-deck id={`deck-${deck.id}`} aria-label={deck.title}>
  <header class="deck-head">
    <div>
      <p class="kicker">{deck.meeting}</p>
      <h3>{deck.title}</h3>
      <p class="deck-runtime">{deck.runtime}</p>
    </div>
    <div class="deck-head-actions">
      <button type="button" class="deck-btn" data-deck-notes aria-pressed="true">Presenter notes</button>
      <button type="button" class="deck-btn" data-deck-full>Present</button>
    </div>
  </header>

  <div class="deck-stage" data-deck-stage tabindex="0" role="group" aria-roledescription="slide deck">
    {slides.map((s, i) => (
      <article class="deck-slide" data-slide-index={i} hidden={i !== 0}>
        {s.type === "title" && (
          <div class="ds ds-title">
            <p class="ds-kicker">{s.kicker}</p>
            <h4 class="ds-h1">{s.heading}</h4>
            <p class="ds-sub">{s.sub}</p>
            {s.image && <SlideImage name={s.image} />}
            {s.art && <SlideArt name={s.art} />}
          </div>
        )}

        {s.type === "prompt" && (
          <div class="ds ds-prompt">
            <p class="ds-eyebrow">{s.heading}</p>
            <p class="ds-question">{s.question}</p>
            {s.image && <SlideImage name={s.image} />}
            {s.art && <SlideArt name={s.art} />}
            <details class="ds-reveal">
              <summary>Where you're steering it</summary>
              <p>{s.answer}</p>
            </details>
          </div>
        )}

        {s.type === "bullets" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            {s.image && <SlideImage name={s.image} />}
            {s.art && <SlideArt name={s.art} />}
            <ul class="ds-list">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
            {s.note && <p class="ds-note">{s.note}</p>}
          </div>
        )}

        {s.type === "twocol" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.image && <SlideImage name={s.image} />}
            {s.art && <SlideArt name={s.art} />}
            <div class="ds-cols">
              <div class="ds-col">
                <h5>{s.left.h}</h5>
                <ul>{s.left.items.map((it) => <li>{it}</li>)}</ul>
              </div>
              <div class="ds-col ds-col-accent">
                <h5>{s.right.h}</h5>
                <ul>{s.right.items.map((it) => <li>{it}</li>)}</ul>
              </div>
            </div>
            {s.note && <p class="ds-note">{s.note}</p>}
          </div>
        )}

        {s.type === "video" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.image && <SlideImage name={s.image} />}
            <div class="ds-video" data-yt={s.youtubeId}>
              <button type="button" class="ds-video-face" data-yt-play aria-label={`Play: ${s.videoTitle}`}>
                <img
                  src={`https://i.ytimg.com/vi/${s.youtubeId}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  width="480"
                  height="360"
                />
                <span class="ds-video-play" aria-hidden="true">▶</span>
              </button>
            </div>
            <p class="ds-video-meta">
              <strong>{s.videoTitle}</strong> · {s.channel}
              {" "}<a href={`https://www.youtube.com/watch?v=${s.youtubeId}`} target="_blank" rel="noopener noreferrer">open on YouTube ↗</a>
            </p>
            {s.play && <p class="ds-note">{s.play}</p>}
            {s.backup && (
              <p class="ds-backup">
                <span class="ds-backup-tag">Backup</span> {s.backup.label} —
                {" "}<a href={`https://www.youtube.com/watch?v=${s.backup.youtubeId}`} target="_blank" rel="noopener noreferrer">
                  {s.backup.videoTitle} ({s.backup.channel}) ↗
                </a>
              </p>
            )}
          </div>
        )}

        {s.type === "steps" && (
          <div class="ds ds-heavy">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            {s.image && <SlideImage name={s.image} />}
            {s.art && <SlideArt name={s.art} />}
            <ol class="ds-steps">
              {s.steps.map((st) => (
                <li>
                  <span class="ds-step-n">{st.n}</span>
                  <div>
                    <strong>{st.title}</strong>
                    <span>{st.detail}</span>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}

        {s.type === "launchops" && (
          <div class="ds ds-heavy">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            {s.image && <SlideImage name={s.image} />}
            <LaunchOps />
          </div>
        )}

        {s.type === "parts" && (
          <div class="ds ds-heavy">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            {s.image && <SlideImage name={s.image} />}
            <RocketPartsDiagram />
          </div>
        )}

        {s.type === "motor" && (
          <div class="ds ds-heavy">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            {s.image && <SlideImage name={s.image} />}
            <MotorCutaway />
          </div>
        )}

        {s.type === "missioncontrol" && (
          <div class="ds ds-heavy">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            {s.image && <SlideImage name={s.image} />}
            <MissionControl />
          </div>
        )}

        {s.type === "flightsim" && (
          <div class="ds ds-heavy">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            {s.image && <SlideImage name={s.image} size="half" />}
            <FlightSim mode={s.sim} id={`${deck.id}-${s.sim}`} />
          </div>
        )}

        {s.type === "orbitsim" && (
          <div class="ds ds-heavy">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            {s.image && <SlideImage name={s.image} size="half" />}
            <OrbitSim mode={s.sim} id={`${deck.id}-${s.sim}`} />
          </div>
        )}

        {s.type === "calculator" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            <p class="ds-intro">{s.intro}</p>
            {s.image && <SlideImage name={s.image} />}
            {s.art && <SlideArt name={s.art} />}
            <p>
              <a class="mb-link-btn" href="/merit-badges/capstones/telemetry-rocket/#rocket-calc" target="_blank" rel="noopener noreferrer">
                Open the altitude simulator ↗
              </a>
            </p>
          </div>
        )}

        {s.type === "charrette" && (
          <div class="ds ds-heavy">
            <h4 class="ds-h2">{s.heading}</h4>
            <p class="ds-intro">{s.intro}</p>
            {s.image && <SlideImage name={s.image} />}
            {s.art && <SlideArt name={s.art} />}
            <div class="ds-locations">
              {s.locations.map((l) => (
                <div class="ds-loc">
                  <strong>{l.place}</strong>
                  <span>{l.hook}</span>
                </div>
              ))}
            </div>
            <ul class="ds-list ds-list-tight">
              {s.required.map((r) => <li>{r}</li>)}
            </ul>
          </div>
        )}

        {s.notes && (
          <aside class="deck-notes" data-deck-note>
            <span class="deck-notes-tag">Say this</span>
            <p>{s.notes}</p>
          </aside>
        )}
      </article>
    ))}

    <div class="deck-nav">
      <button type="button" class="deck-nav-btn" data-deck-prev aria-label="Previous slide">←</button>
      <span class="deck-count"><span data-deck-cur>1</span> / {slides.length}</span>
      <button type="button" class="deck-nav-btn" data-deck-next aria-label="Next slide">→</button>
      <span class="deck-kbd">click the deck, then use ← →</span>
    </div>

    <p class="deck-fs-hint">← → move · N notes · Esc exit</p>
  </div>
</section>

<style>
  .deck {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-alt);
    overflow: hidden;
    margin: 1.4rem 0;
  }

  .deck-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .deck-head h3 { margin: 0.15rem 0 0.2rem; font-size: 1.2rem; }
  .deck-runtime { margin: 0; font-size: 0.84rem; color: var(--muted); }
  .deck-head-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .deck-btn {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .deck-btn:hover { border-color: var(--accent); color: var(--accent-strong); }
  .deck-btn[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); color: var(--accent-strong); }

  .deck-stage {
    position: relative;
    background: var(--bg);
    padding: 1.4rem 1.4rem 3.6rem;
    min-height: 22rem;
    outline: none;
  }

  .deck-stage:focus-visible { box-shadow: inset 0 0 0 2px var(--accent); }

  /* =========================================================
     PROJECTION MODE
     One slide = exactly one viewport. Never scroll inside a
     slide; if it does not fit, the content is too dense and
     belongs on two slides.
     ========================================================= */
  .deck-stage.is-projecting {
    position: fixed;
    inset: 0;
    /* The site header is sticky and was painting over the top of every
       projected slide, ghosting the heading behind a nav bar. Sit above
       everything; :global(body) below also hides the chrome outright. */
    z-index: 2147483000;
    border-radius: 0;
  }

  .deck-stage.is-projecting {
    --slide-padding: clamp(1.25rem, 3.5vw, 3.5rem);
    --content-gap: clamp(0.5rem, 1.6vh, 1.6rem);

    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    padding: var(--slide-padding) var(--slide-padding) calc(var(--slide-padding) + 2.5rem);
    display: grid;
    place-items: center;
    background: var(--bg);
  }

  .deck-stage.is-projecting .deck-slide[hidden] { display: none; }

  /* Belt and braces with the z-index above: while a deck is projecting, the
     site header and footer are simply not in the room. */
  :global(body.deck-projecting) :global(.site-header),
  :global(body.deck-projecting) :global(.site-footer) { display: none; }

  .deck-stage.is-projecting .deck-slide {
    width: min(100%, 1600px);
    max-height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .deck-stage.is-projecting .ds {
    display: flex;
    flex-direction: column;
    gap: var(--content-gap);
    max-height: 100%;
    overflow: hidden;
  }

  /* ------------------------------------------------------------------
     Two-column projection.

     Everything used to stack in one ~1000px column inside a 1600px stage:
     heading, intro, photo, diagram, bullets, note. That is ~1130px of
     content in a ~790px budget, so fit() shrank the whole slide to 70% —
     which is what made the decks look empty. The photo ended up 357px wide
     on a 1600px screen with dead cream on three sides.

     So on a wide screen, put the visual in its own column beside the text.
     Nothing needs shrinking, the picture gets real size, and the frame is
     full. Slides with no visual keep the single column and simply centre.
     ------------------------------------------------------------------ */
  @media (min-width: 1100px) {
    /* Two things this selector is working around, both found the hard way.

       1. The whole thing is wrapped in :global(). .simg and .sart come from
          child components and carry a different astro cid, and Astro does not
          unwrap a :global() nested inside :has() — it emitted the literal text
          ":global(.simg)" into the stylesheet, which is invalid CSS, so the
          browser discarded the entire rule.

       2. The classes are repeated (.is-projecting.is-projecting, .ds.ds).
          Going global costs the two [data-astro-cid] attribute selectors that
          Astro adds to the scoped `.deck-stage.is-projecting .ds` rule above,
          so without the repetition that rule wins and display stays flex —
          grid-template-columns applied while display: grid did not. */
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg)) {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-auto-rows: min-content;
      /* start, not center: when content is a little too tall, centring
         overflows in BOTH directions and .ds is overflow:hidden, so the
         heading was being clipped off the top of the slide entirely. */
      align-content: start;
      column-gap: clamp(1.5rem, 3vw, 3.5rem);
      /* row-gap must be 0 — the body and the visual are pinned to explicit
         high row numbers (see below) and every empty row between would
         otherwise contribute a gap. Spacing comes from margins instead. */
      row-gap: 0;
    }

    /* Heading and standfirst run the full width. */
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-h1),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-h2),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-kicker),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-sub),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-eyebrow),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-question),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-intro) {
      grid-column: 1 / -1;
    }

    /* Visuals take the right column.

       The row numbers are the crux. Grid auto-placement flows in DOM order,
       so simply saying `grid-column: 1` on the bullets put them in the row
       AFTER the photo — i.e. below it, off the bottom of the slide — rather
       than beside it. Pinning the visual and the body to the same explicit
       row is what actually puts them side by side. 90 is just a number
       comfortably higher than any heading count. */
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .simg) {
      grid-column: 2;
      grid-row: 90;
      min-height: 0;
      align-self: center;
    }

    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .sart) {
      grid-column: 2;
      grid-row: 91;
      min-height: 0;
      align-self: center;
    }

    /* Everything else — bullets, steps, columns — fills the left column,
       on the same rows as the visual so the two sit side by side. */
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-list),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-steps),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-cols),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-reveal),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-video),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-locs) {
      grid-column: 1;
      grid-row: 90 / span 2;
      align-self: start;
    }

    /* Spacing that row-gap: 0 gave up. */
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-h1),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-h2),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-question) { margin-bottom: 0.35rem; }

    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-kicker),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-eyebrow) { margin-bottom: 0.2rem; }

    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-intro),
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .ds-sub) { margin-bottom: 0.9rem; }

    /* Only a picture that HAS its own column gets to be big — raising the cap
       globally overflowed every single-column slide instead. */
    :global(.deck-stage.is-projecting .ds:not(.ds-heavy):has(> .simg) > .simg img) { max-height: 44vh; }
    :global(.deck-stage.is-projecting .ds:not(.ds-heavy):has(> .simg) > .simg-tall img) { max-height: 50vh; }

    /* A photo and a diagram sharing the right column split the budget. */
    :global(.deck-stage.is-projecting .ds:not(.ds-heavy):has(> .simg):has(> .sart) > .simg img) { max-height: 27vh; }
    :global(.deck-stage.is-projecting .ds:not(.ds-heavy):has(> .simg):has(> .sart) > .sart .sart-svg) { max-height: 21vh; }
    /* .sart is a bare wrapper div; in a grid column its svg (width:100%) had
       nothing to resolve against and collapsed to zero. Give it the column. */
    :global(.deck-stage.is-projecting.is-projecting .ds.ds:not(.ds-heavy):has(> .simg) > .sart) { width: 100%; }
  }

  /* The note is a presenter aside. It was the deepest element on several
     slides, dragging the auto-scale down for text the room never reads. */
  .deck-stage.is-projecting .ds-note { display: none; }

/* Presenter notes belong to the presenter and not to the room.
     Hidden on the projection by default; press N to peek. */
  .deck-stage.is-projecting .deck-notes { display: none; }
  .deck-stage.is-projecting.show-notes .deck-notes {
    display: block;
    position: absolute;
    left: var(--slide-padding);
    right: var(--slide-padding);
    bottom: 3.2rem;
    margin: 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-alt);
    max-height: 30vh;
    overflow-y: auto;
  }

  .deck-stage.is-projecting .ds-h1 { font-size: clamp(2rem, 5.2vw, 4.5rem); line-height: 1.05; }
  .deck-stage.is-projecting .ds-h2 { font-size: clamp(1.4rem, 3vw, 2.6rem); line-height: 1.15; }
  .deck-stage.is-projecting .ds-sub { font-size: clamp(1rem, 1.7vw, 1.6rem); }
  .deck-stage.is-projecting .ds-question { font-size: clamp(1.4rem, 3.2vw, 2.8rem); }
  .deck-stage.is-projecting .ds-list li,
  .deck-stage.is-projecting .ds-intro { font-size: clamp(0.95rem, 1.5vw, 1.45rem); }
  .deck-stage.is-projecting .ds-list li { margin-bottom: 0.35em; }
  .deck-stage.is-projecting .ds-note { font-size: clamp(0.85rem, 1.2vw, 1.2rem); }

/* Everything visual gets a ceiling so it can never push the slide over. */
  /* Everything visual gets a ceiling so it can never push the slide over. */
  .deck-stage.is-projecting :global(.sart-svg) { max-height: 30vh; width: auto; margin-inline: auto; }
  .deck-stage.is-projecting :global(.simg img) { max-height: 42vh; }
  .deck-stage.is-projecting :global(.simg-tall img) { max-height: 54vh; }
  .deck-stage.is-projecting :global(.simg figcaption) { font-size: clamp(0.75rem, 1vw, 1rem); }
  .deck-stage.is-projecting :global(.rpd-svg),
  .deck-stage.is-projecting :global(.mcut-svg),
  .deck-stage.is-projecting :global(.mctl-svg) { max-height: 44vh; }
  .deck-stage.is-projecting :global(.fsim-stage canvas),
  .deck-stage.is-projecting :global(.osim-stage canvas) { max-height: 42vh; }
  .deck-stage.is-projecting :global(.lops-script) { max-height: 34vh; }
  .deck-stage.is-projecting :global(.ds-video) { max-width: min(60vw, 46rem); }
  .deck-stage.is-projecting :global(.ds-steps) { gap: 0.3rem; }
  .deck-stage.is-projecting :global(.ds-steps span:not(.ds-step-n)) { font-size: clamp(0.75rem, 1vw, 1rem); }

  /* The simulators carry their own explanatory paragraph, which duplicates the
     slide intro when projected. Drop it and tighten the layout so the sim
     slides fit like every other slide. */
  .deck-stage.is-projecting :global(.osim-head p),
  .deck-stage.is-projecting :global(.fsim-head p),
  .deck-stage.is-projecting :global(.osim-foot),
  .deck-stage.is-projecting :global(.fsim-foot),
  .deck-stage.is-projecting :global(.osim-hint),
  .deck-stage.is-projecting :global(.fsim-hint) { display: none; }

  /* The control panel, not the canvas, is what makes a simulator slide too
     tall. Keep the whole component inside the slide and let the canvas be the
     part that gives way. */
  .deck-stage.is-projecting :global(.fsim),
  .deck-stage.is-projecting :global(.osim) {
    max-height: 100%;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .deck-stage.is-projecting :global(.fsim-body),
  .deck-stage.is-projecting :global(.osim-body) { min-height: 0; }

  .deck-stage.is-projecting :global(.fsim-stage),
  .deck-stage.is-projecting :global(.osim-stage) { min-height: 0; }

  .deck-stage.is-projecting :global(.fsim-readout),
  .deck-stage.is-projecting :global(.osim-readout) { font-size: 0.74rem; padding: 0.4rem 0.5rem; }

  .deck-stage.is-projecting :global(.fsim-panel label),
  .deck-stage.is-projecting :global(.osim-panel label) { font-size: 0.74rem; }

  .deck-stage.is-projecting :global(.osim-head h4),
