<script is:inline>
  (function () {
    function wire(deck) {
      if (deck.dataset.deckWired) return;
      deck.dataset.deckWired = "1";
      deck.dataset.notes = "on";

      const stage = deck.querySelector("[data-deck-stage]");
      const slides = Array.from(deck.querySelectorAll(".deck-slide"));
      const cur = deck.querySelector("[data-deck-cur]");
      const prev = deck.querySelector("[data-deck-prev]");
      const next = deck.querySelector("[data-deck-next]");
      let i = 0;

      // Last-resort guard: if a slide still cannot fit the projection, scale it
      // down rather than let it overflow. The CSS above should mean this never
      // fires — it exists so a future content edit degrades gracefully.
      // Keep a projected slide inside the viewport.
      //
      // NOTE: .ds is overflow:hidden when projecting, so scrollHeight always
      // equals clientHeight and can never reveal overflow - anything spilling
      // out is silently clipped. Measure the deepest descendant instead, which
      // is what actually decides whether the room sees the whole slide.
      function fit(el) {
        var box = el && el.querySelector(".ds");
        if (!box) return;
        box.style.transform = "";
        if (!stage.classList.contains("is-projecting")) return;

        // Available space is measured from where the slide actually starts, not
        // from the stage height: the slide is vertically centred, so its top
        // sits below the stage top and using stage height overestimates room.
        var stageRect = stage.getBoundingClientRect();
        var top = box.getBoundingClientRect().top;
        var avail = (stageRect.bottom - 56) - top;
        if (avail <= 0) return;
        var deepest = 0;
        var kids = box.querySelectorAll("*");
        for (var n = 0; n < kids.length; n++) {
          var r = kids[n].getBoundingClientRect();
          if (r.height > 0 && r.bottom > deepest) deepest = r.bottom;
        }
        var need = deepest - top;

        if (need > avail) {
          var k = Math.max(0.58, avail / need);
          box.style.transformOrigin = "top center";
          box.style.transform = "scale(" + k.toFixed(3) + ")";
        }
      }

      // A single measurement one frame after the slide appears is not enough.
      // The slide's own content is still settling then - the sim canvases are
      // width-driven (height:auto) and the entry animation holds children in
      // their translated start state - so an early read under-reports the real
      // height and locks in a scale that is too generous. Measure again once
      // things have stopped moving, and keep watching for later growth.
      function scheduleFit(el) {
        fit(el);
        requestAnimationFrame(function () {
          requestAnimationFrame(function () { fit(el); });
        });
        // After the 420ms entry animation has finished, and once more for any
        // late layout (fonts, images decoding).
        setTimeout(function () { fit(el); }, 500);
        setTimeout(function () { fit(el); }, 1200);
        observe(el);
      }

      // Re-fit whenever anything inside the live slide changes size. fit() only
      // writes a transform, which does not affect layout, so this cannot loop.
      var ro = window.ResizeObserver
        ? new ResizeObserver(function () {
            if (stage.classList.contains("is-projecting")) fit(slides[i]);
          })
        : null;

      function observe(el) {
        if (!ro) return;
        ro.disconnect();
        var box = el && el.querySelector(".ds");
        if (!box) return;
        ro.observe(box);
        for (var c = 0; c < box.children.length; c++) ro.observe(box.children[c]);
      }

      // Slide images are loading="lazy", and a slide that has never been shown
      // is display:none — so the browser has no reason to fetch its photo until
      // the moment it appears, which on a projector reads as a blank box. Warm
      // the current slide and the one after it.
      function preload(n) {
        [slides[n], slides[n + 1]].forEach(function (sl) {
          if (!sl) return;
          sl.querySelectorAll('img[loading="lazy"]').forEach(function (img) {
            img.loading = "eager";
            if (!img.complete) img.src = img.src;
          });
        });
      }

      function show(n) {
        i = Math.max(0, Math.min(slides.length - 1, n));
        preload(i);
        slides.forEach((s, idx) => (s.hidden = idx !== i));
        cur.textContent = String(i + 1);
        prev.disabled = i === 0;
        next.disabled = i === slides.length - 1;
        scheduleFit(slides[i]);
      }

      prev.addEventListener("click", () => show(i - 1));
      next.addEventListener("click", () => show(i + 1));

      stage.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "PageDown") { e.preventDefault(); show(i + 1); }
        else if (e.key === "ArrowLeft" || e.key === "PageUp") { e.preventDefault(); show(i - 1); }
        else if (e.key === "Home") { e.preventDefault(); show(0); }
        else if (e.key === "End") { e.preventDefault(); show(slides.length - 1); }
        else if (e.key === "n" || e.key === "N") { stage.classList.toggle("show-notes"); }
        else if (e.key === "Escape" && stage.classList.contains("is-projecting")) { exitProjection(); }
      });

      const notesBtn = deck.querySelector("[data-deck-notes]");
      notesBtn.addEventListener("click", () => {
        const on = deck.dataset.notes === "on";
        deck.dataset.notes = on ? "off" : "on";
        notesBtn.setAttribute("aria-pressed", String(!on));
      });

      const fullBtn = deck.querySelector("[data-deck-full]");

      function enterProjection() {
        stage.classList.add("is-projecting");
        document.body.classList.add("deck-projecting");
        document.documentElement.style.overflow = "hidden";
        fullBtn.textContent = "Exit";
        stage.focus();
        // Real fullscreen looks nicer, but embedded and locked-down browsers
        // refuse it — and can throw synchronously rather than rejecting. The
        // class above already gives a full-window deck, so a refusal is not a
        // failure; the presentation still works.
        try {
          if (stage.requestFullscreen) {
            const r = stage.requestFullscreen();
            if (r && r.catch) r.catch(() => {});
          }
        } catch (e) { /* projection mode still applies */ }
        requestAnimationFrame(() => show(i));
      }

      function exitProjection() {
        stage.classList.remove("is-projecting", "show-notes");
        document.body.classList.remove("deck-projecting");
        document.documentElement.style.overflow = "";
        fullBtn.textContent = "Present";
        try {
          if (document.fullscreenElement) {
            const r = document.exitFullscreen();
            if (r && r.catch) r.catch(() => {});
          }
        } catch (e) { /* already out */ }
        requestAnimationFrame(() => show(i));
      }

      fullBtn.addEventListener("click", () => {
        if (stage.classList.contains("is-projecting")) exitProjection();
        else enterProjection();
      });

      deck.querySelectorAll("[data-yt-play]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const wrap = btn.closest("[data-yt]");
          const id = wrap.dataset.yt;
          const frame = document.createElement("iframe");
          frame.src = "https://www.youtube-nocookie.com/embed/" + id + "?autoplay=1&rel=0";
          frame.title = "Embedded video";
          frame.allow = "accelerometer; autoplay; encrypted-media; picture-in-picture";
          frame.allowFullscreen = true;
          wrap.replaceChildren(frame);
        });
      });

      document.addEventListener("fullscreenchange", function () {
        // Leaving real fullscreen (Esc, F11) should also leave projection mode.
        if (!document.fullscreenElement && stage.classList.contains("is-projecting")) exitProjection();
      });
      window.addEventListener("resize", function () { fit(slides[i]); });

      show(0);
    }

    function init() {
      document.querySelectorAll("[data-deck]").forEach(wire);
    }

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
