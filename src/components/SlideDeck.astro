---
// Presentable slide deck for troop meetings. Keyboard-driven, fullscreen-able,
// with a presenter-notes panel that stays off the projected slide.
//
// Slide types: title | prompt | bullets | twocol | video | parts | calculator | charrette
import RocketPartsDiagram from "./RocketPartsDiagram.astro";
import MotorCutaway from "./MotorCutaway.astro";
import MissionControl from "./MissionControl.astro";
import FlightSim from "./FlightSim.astro";
import OrbitSim from "./OrbitSim.astro";

const { deck } = Astro.props;
const slides = deck.slides;
---

<section class="deck" data-deck id={`deck-${deck.id}`} aria-label={deck.title}>
  <header class="deck-head">
    <div>
      <p class="kicker">{deck.meeting}</p>
      <h3>{deck.title}</h3>
      <p class="deck-runtime">{deck.runtime}</p>
    </div>
    <div class="deck-head-actions">
      <button type="button" class="deck-btn" data-deck-notes aria-pressed="true">Presenter notes</button>
      <button type="button" class="deck-btn" data-deck-full>Full screen</button>
    </div>
  </header>

  <div class="deck-stage" data-deck-stage tabindex="0" role="group" aria-roledescription="slide deck">
    {slides.map((s, i) => (
      <article class="deck-slide" data-slide-index={i} hidden={i !== 0}>
        {s.type === "title" && (
          <div class="ds ds-title">
            <p class="ds-kicker">{s.kicker}</p>
            <h4 class="ds-h1">{s.heading}</h4>
            <p class="ds-sub">{s.sub}</p>
          </div>
        )}

        {s.type === "prompt" && (
          <div class="ds ds-prompt">
            <p class="ds-eyebrow">{s.heading}</p>
            <p class="ds-question">{s.question}</p>
            <details class="ds-reveal">
              <summary>Where you're steering it</summary>
              <p>{s.answer}</p>
            </details>
          </div>
        )}

        {s.type === "bullets" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            <ul class="ds-list">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
            {s.note && <p class="ds-note">{s.note}</p>}
          </div>
        )}

        {s.type === "twocol" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            <div class="ds-cols">
              <div class="ds-col">
                <h5>{s.left.h}</h5>
                <ul>{s.left.items.map((it) => <li>{it}</li>)}</ul>
              </div>
              <div class="ds-col ds-col-accent">
                <h5>{s.right.h}</h5>
                <ul>{s.right.items.map((it) => <li>{it}</li>)}</ul>
              </div>
            </div>
            {s.note && <p class="ds-note">{s.note}</p>}
          </div>
        )}

        {s.type === "video" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            <div class="ds-video" data-yt={s.youtubeId}>
              <button type="button" class="ds-video-face" data-yt-play aria-label={`Play: ${s.videoTitle}`}>
                <img
                  src={`https://i.ytimg.com/vi/${s.youtubeId}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  width="480"
                  height="360"
                />
                <span class="ds-video-play" aria-hidden="true">▶</span>
              </button>
            </div>
            <p class="ds-video-meta">
              <strong>{s.videoTitle}</strong> · {s.channel}
              {" "}<a href={`https://www.youtube.com/watch?v=${s.youtubeId}`} target="_blank" rel="noopener noreferrer">open on YouTube ↗</a>
            </p>
            {s.play && <p class="ds-note">{s.play}</p>}
            {s.backup && (
              <p class="ds-backup">
                <span class="ds-backup-tag">Backup</span> {s.backup.label} —
                {" "}<a href={`https://www.youtube.com/watch?v=${s.backup.youtubeId}`} target="_blank" rel="noopener noreferrer">
                  {s.backup.videoTitle} ({s.backup.channel}) ↗
                </a>
              </p>
            )}
          </div>
        )}

        {s.type === "steps" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            <ol class="ds-steps">
              {s.steps.map((st) => (
                <li>
                  <span class="ds-step-n">{st.n}</span>
                  <div>
                    <strong>{st.title}</strong>
                    <span>{st.detail}</span>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}

        {s.type === "parts" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            <RocketPartsDiagram />
          </div>
        )}

        {s.type === "motor" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            <MotorCutaway />
          </div>
        )}

        {s.type === "missioncontrol" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            <MissionControl />
          </div>
        )}

        {s.type === "flightsim" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            <FlightSim mode={s.sim} id={`${deck.id}-${s.sim}`} />
          </div>
        )}

        {s.type === "orbitsim" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            {s.intro && <p class="ds-intro">{s.intro}</p>}
            <OrbitSim mode={s.sim} id={`${deck.id}-${s.sim}`} />
          </div>
        )}

        {s.type === "calculator" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            <p class="ds-intro">{s.intro}</p>
            <p>
              <a class="mb-link-btn" href="/merit-badges/capstones/telemetry-rocket/#rocket-calc" target="_blank" rel="noopener noreferrer">
                Open the altitude simulator ↗
              </a>
            </p>
          </div>
        )}

        {s.type === "charrette" && (
          <div class="ds">
            <h4 class="ds-h2">{s.heading}</h4>
            <p class="ds-intro">{s.intro}</p>
            <div class="ds-locations">
              {s.locations.map((l) => (
                <div class="ds-loc">
                  <strong>{l.place}</strong>
                  <span>{l.hook}</span>
                </div>
              ))}
            </div>
            <ul class="ds-list ds-list-tight">
              {s.required.map((r) => <li>{r}</li>)}
            </ul>
          </div>
        )}

        {s.notes && (
          <aside class="deck-notes" data-deck-note>
            <span class="deck-notes-tag">Say this</span>
            <p>{s.notes}</p>
          </aside>
        )}
      </article>
    ))}

    <div class="deck-nav">
      <button type="button" class="deck-nav-btn" data-deck-prev aria-label="Previous slide">←</button>
      <span class="deck-count"><span data-deck-cur>1</span> / {slides.length}</span>
      <button type="button" class="deck-nav-btn" data-deck-next aria-label="Next slide">→</button>
      <span class="deck-kbd">click the deck, then use ← →</span>
    </div>
  </div>
</section>

<style>
  .deck {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-alt);
    overflow: hidden;
    margin: 1.4rem 0;
  }

  .deck-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .deck-head h3 { margin: 0.15rem 0 0.2rem; font-size: 1.2rem; }
  .deck-runtime { margin: 0; font-size: 0.84rem; color: var(--muted); }
  .deck-head-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .deck-btn {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .deck-btn:hover { border-color: var(--accent); color: var(--accent-strong); }
  .deck-btn[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); color: var(--accent-strong); }

  .deck-stage {
    position: relative;
    background: var(--bg);
    padding: 1.4rem 1.4rem 3.6rem;
    min-height: 22rem;
    outline: none;
  }

  .deck-stage:focus-visible { box-shadow: inset 0 0 0 2px var(--accent); }

  .deck-stage:fullscreen {
    padding: 3rem 4rem 5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
  }

  .deck-stage:fullscreen .ds-h1 { font-size: clamp(2.4rem, 6vw, 4rem); }
  .deck-stage:fullscreen .ds-h2 { font-size: clamp(1.7rem, 3.4vw, 2.6rem); }
  .deck-stage:fullscreen .ds-list li,
  .deck-stage:fullscreen .ds-intro { font-size: clamp(1.05rem, 1.7vw, 1.5rem); }

  .ds-kicker {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }

  .ds-title { padding: 2rem 0; }
  .ds-h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); line-height: 1.1; margin: 0 0 0.6rem; }
  .ds-sub { font-size: 1.05rem; color: var(--muted); margin: 0; }
  .ds-h2 { font-size: clamp(1.25rem, 2.4vw, 1.65rem); margin: 0 0 0.6rem; line-height: 1.25; }
  .ds-intro { color: var(--muted); margin: 0 0 0.9rem; }

  .ds-list { margin: 0; padding-left: 1.2rem; }
  .ds-list li { margin-bottom: 0.55rem; line-height: 1.6; }
  .ds-list-tight li { margin-bottom: 0.3rem; font-size: 0.92rem; }

  .ds-note {
    margin: 0.9rem 0 0;
    padding: 0.6rem 0.85rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 8px 8px 0;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .ds-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.8rem;
  }

  .ds-question { font-size: clamp(1.3rem, 3vw, 2rem); line-height: 1.3; margin: 0 0 1.2rem; font-weight: 600; }

  .ds-reveal summary { cursor: pointer; color: var(--accent); font-size: 0.9rem; }
  .ds-reveal p { margin: 0.6rem 0 0; color: var(--muted); line-height: 1.6; }

  .ds-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .ds-col { border: 1px solid var(--line); border-radius: 12px; padding: 0.8rem 1rem; }
  .ds-col-accent { border-color: var(--accent); background: var(--accent-soft); }
  .ds-col h5 { margin: 0 0 0.5rem; font-size: 0.95rem; }
  .ds-col ul { margin: 0; padding-left: 1.1rem; }
  .ds-col li { margin-bottom: 0.4rem; font-size: 0.92rem; line-height: 1.5; }

  .ds-video { max-width: 34rem; }

  .ds-video-face {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    cursor: pointer;
    aspect-ratio: 16 / 9;
  }

  .ds-video-face img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0.82; }
  .ds-video-face:hover img { opacity: 1; }

  .ds-video-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 2.6rem;
    color: #fff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
  }

  .ds-video iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 12px; display: block; }
  .ds-video-meta { font-size: 0.88rem; color: var(--muted); margin: 0.5rem 0 0; }

  .ds-backup { font-size: 0.85rem; color: var(--muted); margin: 0.6rem 0 0; }

  .ds-backup-tag {
    display: inline-block;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    margin-right: 0.3rem;
  }

  .ds-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .ds-steps li { display: flex; gap: 0.7rem; align-items: flex-start; }
  .ds-steps strong { display: block; font-size: 0.95rem; }
  .ds-steps span:not(.ds-step-n) { font-size: 0.88rem; color: var(--muted); line-height: 1.5; }

  .ds-step-n {
    flex: none;
    width: 1.55rem;
    height: 1.55rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    border: 1px solid var(--line);
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .ds-locations { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.5rem; margin-bottom: 0.9rem; }
  .ds-loc { border: 1px solid var(--line); border-radius: 10px; padding: 0.55rem 0.75rem; }
  .ds-loc strong { display: block; font-size: 0.92rem; }
  .ds-loc span { font-size: 0.82rem; color: var(--muted); line-height: 1.45; }

  .deck-notes {
    margin-top: 1.2rem;
    border-top: 1px dashed var(--line);
    padding-top: 0.8rem;
  }

  .deck-notes-tag {
    display: inline-block;
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .deck-notes p { margin: 0; font-size: 0.9rem; line-height: 1.6; color: var(--muted); }

  .deck[data-notes="off"] .deck-notes { display: none; }

  .deck-nav {
    position: absolute;
    left: 1.4rem;
    right: 1.4rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .deck-nav-btn {
    font: inherit;
    font-size: 1rem;
    line-height: 1;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .deck-nav-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent-strong); }
  .deck-nav-btn:disabled { opacity: 0.35; cursor: default; }

  .deck-count { font-family: ui-monospace, monospace; font-size: 0.85rem; color: var(--muted); }
  .deck-kbd { margin-left: auto; font-size: 0.75rem; color: var(--muted); }

  @media (max-width: 640px) {
    .ds-cols { grid-template-columns: 1fr; }
    .deck-kbd { display: none; }
    .deck-stage { padding-bottom: 3.2rem; }
  }
</style>

<script is:inline>
  (function () {
    function wire(deck) {
      if (deck.dataset.deckWired) return;
      deck.dataset.deckWired = "1";
      deck.dataset.notes = "on";

      const stage = deck.querySelector("[data-deck-stage]");
      const slides = Array.from(deck.querySelectorAll(".deck-slide"));
      const cur = deck.querySelector("[data-deck-cur]");
      const prev = deck.querySelector("[data-deck-prev]");
      const next = deck.querySelector("[data-deck-next]");
      let i = 0;

      function show(n) {
        i = Math.max(0, Math.min(slides.length - 1, n));
        slides.forEach((s, idx) => (s.hidden = idx !== i));
        cur.textContent = String(i + 1);
        prev.disabled = i === 0;
        next.disabled = i === slides.length - 1;
      }

      prev.addEventListener("click", () => show(i - 1));
      next.addEventListener("click", () => show(i + 1));

      stage.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "PageDown") { e.preventDefault(); show(i + 1); }
        else if (e.key === "ArrowLeft" || e.key === "PageUp") { e.preventDefault(); show(i - 1); }
        else if (e.key === "Home") { e.preventDefault(); show(0); }
        else if (e.key === "End") { e.preventDefault(); show(slides.length - 1); }
      });

      const notesBtn = deck.querySelector("[data-deck-notes]");
      notesBtn.addEventListener("click", () => {
        const on = deck.dataset.notes === "on";
        deck.dataset.notes = on ? "off" : "on";
        notesBtn.setAttribute("aria-pressed", String(!on));
      });

      const fullBtn = deck.querySelector("[data-deck-full]");
      fullBtn.addEventListener("click", () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else if (stage.requestFullscreen) stage.requestFullscreen().then(() => stage.focus());
      });

      deck.querySelectorAll("[data-yt-play]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const wrap = btn.closest("[data-yt]");
          const id = wrap.dataset.yt;
          const frame = document.createElement("iframe");
          frame.src = "https://www.youtube-nocookie.com/embed/" + id + "?autoplay=1&rel=0";
          frame.title = "Embedded video";
          frame.allow = "accelerometer; autoplay; encrypted-media; picture-in-picture";
          frame.allowFullscreen = true;
          wrap.replaceChildren(frame);
        });
      });

      show(0);
    }

    function init() {
      document.querySelectorAll("[data-deck]").forEach(wire);
    }

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
