---
import { formatDate } from "../lib/content";

// Each card carries a small square image: post.thumb (240x240, cut from an image already in the essay),
// or, for an essay with no images, a line icon for its topic (post.icon in content/writing/index.json).
const { post, compact = false } = Astro.props;
const href = `/writing/${post.slug}/`;

const ICONS = {
  // a run plotted on axes
  plot: `<path d="M9 8v31h31"/><path d="M12 31c4-12 8-17 11-9s6 12 9 4 4-13 7-14"/><circle cx="23" cy="22" r="1.6"/><circle cx="35" cy="20" r="1.6"/>`,
  // an aircraft from above, its wing in three bolt-on modules
  modular: `<path d="M24 6c2 3 2.5 8 2.5 13v14c0 4-1 7-2.5 9-1.5-2-2.5-5-2.5-9V19c0-5 .5-10 2.5-13z"/><path d="M5 21h10.5M18 21h3M27 21h3M32.5 21H43"/><path d="M5 21v4h10.5v-4M32.5 21v4H43v-4"/><path d="M17 38h14"/>`,
  // a long-winged glider from above
  glider: `<path d="M3 24.5C10 21.5 17 20.5 24 20.5s14 1 21 4c-7-1-14-1.5-21-1.5S10 23.5 3 24.5z"/><path d="M24 9c1.3 2 1.6 9 1.4 16-.2 6-.6 11.5-1.4 15-.8-3.5-1.2-9-1.4-15-.2-7 .1-14 1.4-16z"/><path d="M18.5 38.5h11"/>`,
  // a light bulb
  bulb: `<path d="M24 7a11 11 0 0 0-6.5 19.9c1.4 1 2 2.6 2 4.3V33h9v-1.8c0-1.7.6-3.3 2-4.3A11 11 0 0 0 24 7z"/><path d="M19.5 37h9M20.5 41h7"/><path d="M24 33v-8l-3-3M24 25l3-3"/>`,
  // a page of text
  page: `<path d="M13 6h16l7 7v29H13z"/><path d="M29 6v7h7"/><path d="M18 21h13M18 27h13M18 33h9"/>`,
};
const icon = post.thumb ? null : ICONS[post.icon] ?? ICONS.page;
---
<article class={`card writing-card has-thumb ${compact ? "compact" : ""}`}>
  <a class={`project-thumb${icon ? " writing-thumb-icon" : ""}`} href={href} tabindex="-1" aria-hidden="true">
    {post.thumb ? (
      <img src={post.thumb} alt="" width="240" height="240" loading="lazy" />
    ) : (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
    )}
  </a>
  <div class="project-card-body">
    <p class="meta-row">
      <time datetime={post.date}>{formatDate(post.date)}</time>
      <span aria-hidden="true">&middot;</span>
      <span>{post.readingTime} min read</span>
    </p>
    <h3>
      <a href={href} transition:name={post.slug}>
        {post.title}
      </a>
    </h3>
    <p>{post.summary}</p>
    <ul class="tag-list" aria-label="Tags">
      {post.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</article>
