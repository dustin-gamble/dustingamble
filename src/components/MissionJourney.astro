---
const stars=Array.from({length:55},(_,i)=>({x:(i*137+23)%760,y:(i*79+13)%340,r:i%7===0?1.7:.7}));
---
<section class="space-lab mission-journey" data-lab="missions" data-mission-journey aria-label="Voyager 1 and Apollo 11 discovery stops">
  <div class="mj-top"><span>REQUIREMENT 5a <b>Discovery → evidence → why it matters</b></span><button data-motion aria-pressed="false">Pause motion Ⅱ</button></div>
  <div class="mj-body">
    <div class="mj-map">
      <svg viewBox="0 0 760 340" role="img" aria-label="Schematic mission route with four numbered discovery stops; planets and distances not to scale">
        <defs><radialGradient id="mj-earth"><stop stop-color="#70d4ec"/><stop offset="1" stop-color="#2476a9"/></radialGradient><radialGradient id="mj-moon"><stop stop-color="#d9dcd9"/><stop offset="1" stop-color="#657080"/></radialGradient></defs>
        {stars.map(s=><circle cx={s.x} cy={s.y} r={s.r} fill="#c9e7ff" opacity=".4"/>)}
        <g transform="translate(100 210)"><circle r="57" fill="#67daed" opacity=".08"/><circle r="47" fill="url(#mj-earth)" stroke="#78d7f4" stroke-width="2"/><path d="M-32-29-9-35 4-19-12-4-7 12-26 19-40 4M16 9 35 3 38 21 22 36 9 27" fill="#78a48d"/></g>
        <text x="100" y="283" text-anchor="middle">EARTH</text>
        <g data-world="robot"><g transform="translate(320 105)"><circle r="42" fill="#efbd93"/><path d="M-38-17Q0-3 38-17M-42 3Q0 17 42 3M-34 24Q0 37 34 24" stroke="#bd8677" stroke-width="8" fill="none"/><ellipse cx="17" cy="14" rx="10" ry="5" fill="#b96753"/></g><text x="320" y="167" text-anchor="middle">JUPITER + IO</text><g transform="translate(535 114)"><circle r="31" fill="#eddaac"/><ellipse rx="58" ry="12" transform="rotate(-23)" stroke="#cfb7a5" stroke-width="8" fill="none"/></g><text x="535" y="177" text-anchor="middle">SATURN + TITAN</text><path d="M686 17Q650 100 686 190" stroke="#75cbe8" stroke-dasharray="5 7" opacity=".5" fill="none"/><text x="685" y="225" text-anchor="middle">INTERSTELLAR</text></g>
        <g data-world="crew" hidden><g transform="translate(535 130)"><circle r="51" fill="url(#mj-moon)"/><circle cx="-22" cy="-22" r="10" fill="#8799b3" opacity=".5"/><circle cx="27" cy="14" r="12" fill="#8799b3" opacity=".4"/></g><text x="535" y="206" text-anchor="middle">THE MOON</text><text x="290" y="287" text-anchor="middle">SAMPLES COME HOME</text></g>
        <path data-mj-route d="M144 191 Q220 31 316 61 Q420 31 535 79 Q625 36 707 62" fill="none" stroke="#51728b" stroke-width="2" stroke-dasharray="5 7"/>
        <path data-mj-trace fill="none" stroke="#8bead6" stroke-width="3"/>
        {[0,1,2,3].map(i=><g data-mj-pin={i}><circle r="14" fill="#10273b" stroke="#8bead6" stroke-width="2"/><text y="4" text-anchor="middle" class="mj-pin-text">{i+1}</text></g>)}
        <g data-mj-craft><circle r="25" fill="#8bead6" opacity=".1"/><g data-mj-probe><path d="M-15-12Q0 16 15-12Z" fill="#eaf5ff" stroke="#6f8da8" stroke-width="2"/><path d="M0 2V25M-20 15H20M0-12V-25" stroke="#b4d5e7" stroke-width="3"/><rect x="-7" y="3" width="14" height="12" rx="3" fill="#f9cc73"/></g><g data-mj-capsule hidden><path d="M-16 12 0-16 16 12Z" fill="#f3f5ff" stroke="#849dbb" stroke-width="2"/><rect x="-5" y="-4" width="10" height="7" rx="3" fill="#6bccf0"/><path d="M-19 14H19" stroke="#f8b885" stroke-width="5"/></g></g>
        <text x="22" y="326" class="mj-map-note">SCHEMATIC ROUTES · WORLDS ENLARGED · NOT TO SCALE</text>
      </svg>
      <div class="mj-stops" aria-label="Choose a discovery stop">{[0,1,2,3].map(i=><button data-stop={i} aria-current={i===0?'step':undefined}><b>{i+1}</b><span data-stop-label={i}></span></button>)}</div>
    </div>
    <aside class="mj-fact" aria-live="polite">
      <p class="mj-date" data-mj-date></p><h5 data-mj-title></h5>
      <p data-mj-fact></p><p class="mj-meaning"><strong>WHY IT MATTERS</strong><span data-mj-meaning></span></p>
      <div class="mj-question"><strong>YOUR TURN</strong><p data-mj-question></p><button data-mj-answer aria-expanded="false">Reveal a possible answer</button><p data-mj-answer-text hidden></p></div>
    </aside>
  </div>
  <div class="lab-controls mj-controls"><div class="mj-modes"><button data-mode="robot" aria-pressed="true">◈ Voyager 1</button><button data-mode="crew" aria-pressed="false">◉ Apollo 11</button></div><button class="mj-go" data-play>Fly to next stop →</button><button data-reset aria-label="Restart the mission">↺</button><label class="mj-progress">Journey<input data-progress type="range" min="0" max="100" value="0" aria-label="Mission progress"/></label></div>
  <footer class="mj-footer"><p><strong>Discuss with your counselor:</strong> one discovery from each mission, why it mattered, and what it taught us. These stops help you prepare for 5a; the discussion is yours.</p><span>Sources: <a href="https://science.nasa.gov/mission/voyager/voyager-1/" target="_blank" rel="noopener">NASA Voyager 1</a> · <a href="https://www.nasa.gov/history/apollo-11-mission-overview/" target="_blank" rel="noopener">Apollo 11</a> · <a href="https://science.nasa.gov/solar-system/moon/history-of-lunar-exploration/" target="_blank" rel="noopener">Lunar science</a> · <a href="https://www.scouting.org/merit-badges/space-exploration/" target="_blank" rel="noopener">5a</a></span></footer>
</section>
<style>
.mission-journey{border:1px solid #34485e;border-radius:18px;background:radial-gradient(ellipse at 20% 0,#1d304c,#0c1729 70%);color:#edf5ff;overflow:hidden;font-family:ui-sans-serif,system-ui,sans-serif;--mj-accent:#9cead8;text-align:left}.mission-journey [hidden]{display:none!important}.mj-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 18px;border-bottom:1px solid #ffffff15;font-size:10px;letter-spacing:.1em;color:#9cead8}.mj-top b{font-weight:400;letter-spacing:0;color:#afc3dc;margin-left:15px}.mj-body{display:grid;grid-template-columns:minmax(0,1fr) minmax(290px,35%)}.mj-map{min-width:0;display:flex;flex-direction:column;justify-content:center;padding:4px 10px 12px}.mj-map svg{display:block;width:100%;height:auto;max-height:32vh;min-height:180px}.mj-map text{font:10px ui-sans-serif,system-ui,sans-serif;fill:#adc5db;letter-spacing:1px}.mj-map .mj-pin-text{font-size:12px;fill:#ecfff8;font-weight:800;letter-spacing:0}.mj-map .mj-map-note{font-size:8px}.mj-stops{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:2px}.mj-stops button{display:grid;justify-items:center;gap:6px;background:transparent;border:1px solid #3c526b;font-size:10px;padding:10px 4px;line-height:1.25}.mj-stops b{font-size:11px;color:#9cead8}.mj-stops button[aria-current=step]{background:#1d4445;border-color:#98dfd0;color:white}.mj-fact{border-left:1px solid #ffffff15;padding:18px 22px;background:#09142566;min-width:0;display:flex;flex-direction:column;gap:9px}.mj-date{font-size:10px!important;letter-spacing:.07em;font-weight:700;color:#9cead8!important}.mj-fact h5{font-size:clamp(19px,1.9vw,28px);line-height:1.1;letter-spacing:-.035em;margin:0;color:#f1f7ff}.mj-fact p{margin:0;font-size:clamp(12px,1.05vw,16px);line-height:1.45;color:#c0cfe1}.mj-meaning{border-top:1px solid #ffffff14;padding-top:10px}.mj-meaning strong,.mj-question>strong{font-size:8px;letter-spacing:.12em;color:#9cead8;display:block;margin-bottom:4px}.mj-meaning span{display:block}.mj-question{padding:10px 12px;border-radius:7px;background:#24394f66;margin-top:auto}.mj-question>p{font-size:12px}.mj-question button{border:0!important;padding:5px 0 0!important;background:transparent!important;color:#a4eadb;font-size:10px!important;text-decoration:underline}.mj-question [data-mj-answer-text]{font-size:11px;margin-top:7px;color:#f2dbad}.mission-journey button{font:inherit;color:#d2e6f5;background:#172d43;border:1px solid #496076;border-radius:6px;cursor:pointer;font-size:11px;padding:9px 12px}.mission-journey button:hover{border-color:#a9efdf}.mission-journey button:focus-visible,.mission-journey a:focus-visible,.mission-journey input:focus-visible{outline:3px solid #ffe2a1;outline-offset:2px}.mj-top button{font-size:9px;padding:6px 8px}.mj-controls{padding:11px 16px;display:flex;align-items:center;gap:9px;border-top:1px solid #ffffff15;background:#080f1e88;flex-wrap:wrap}.mj-modes{display:flex;gap:4px}.mj-modes [aria-pressed=true]{background:#254c51;border-color:#96ddcb}.mj-controls .mj-go{background:#a2edda;color:#10352e;font-weight:750;border-color:#a2edda}.mj-progress{display:flex;gap:8px;align-items:center;font-size:10px;color:#a6bdd5;margin-left:auto}.mj-progress input{width:105px;accent-color:#a2edda}.mj-footer{padding:9px 16px 12px;display:flex;flex-direction:column;gap:5px}.mj-footer p{margin:0;font-size:10px;line-height:1.45;color:#b5c7dc}.mj-footer span,.mj-footer a{font-size:8px;color:#8da9c4}.mj-footer strong{color:#e4f5ff;font-weight:650}
@media(max-width:700px){.mj-top b{display:none}.mj-body{grid-template-columns:1fr}.mj-map svg{max-height:22vh;min-height:130px}.mj-fact{border-left:0;border-top:1px solid #ffffff15;padding:12px 16px;gap:6px}.mj-fact h5{font-size:20px}.mj-fact p{font-size:12px}.mj-meaning{padding-top:6px}.mj-question{margin:2px 0 0;padding:8px 10px}.mj-stops button{padding:6px 3px;font-size:9px}.mj-stops{margin-top:0}.mj-map{padding-bottom:8px}.mj-controls{padding:8px;gap:5px}.mission-journey button{font-size:10px;padding:8px}.mj-progress{display:none}.mj-footer p{font-size:9px}.mj-footer{padding:7px 10px}.mj-top{padding:9px 12px}}
:global(.show .mission-journey){height:auto!important;align-self:center;display:block!important}:global(.deck-stage.is-projecting .mission-journey){width:100%}:global(.show .mission-journey .lab-controls){min-height:0}
</style>
<script>
const journeys={robot:[
 {date:'5 SEP 1977 · LAUNCH',label:'Earth · 1977',title:'An explorer with no passengers',fact:'Voyager 1 launched to study Jupiter and Saturn. Cameras and scientific instruments sent their observations to Earth by radio.',meaning:'A robotic spacecraft can investigate distant worlds without carrying air, food, or a way home.',question:'What came back to Earth: the spacecraft, samples, or data?',answer:'Images and instrument data. Voyager 1 never brought physical samples home.'},
 {date:'5 MAR 1979 · JUPITER FLYBY',label:'Io · 1979',title:'A moon with active volcanoes',fact:'Voyager 1 images revealed erupting volcanoes on Io—the first active volcanoes found beyond Earth.',meaning:'A small, distant moon can be geologically active. An image changed our picture of what moons are like.',question:'What is the evidence, and what does it tell us about Io?',answer:'Images of erupting plumes show that Io has active volcanism; it is not simply a cold, inactive rock.'},
 {date:'12 NOV 1980 · SATURN FLYBY',label:'Titan · 1980',title:'An atmosphere hiding a world',fact:'Voyager 1 studied Saturn’s moon Titan and found a thick atmosphere dominated by nitrogen. Haze hid the surface from its cameras.',meaning:'Different instruments answer different questions. Knowing the atmosphere did not mean we had seen the ground.',question:'What did we learn—and what question remained?',answer:'We learned about Titan’s atmosphere. Its hidden surface still needed another way to investigate.'},
 {date:'AUG 2012 · HELIOPAUSE',label:'Beyond · 2012',title:'Crossing into interstellar space',fact:'Voyager 1 became the first spacecraft to enter interstellar space. Measurements showed it had crossed beyond the Sun’s wind bubble.',meaning:'The heliopause is a boundary in space that instruments can detect. It is not the edge of the Sun’s gravity.',question:'Give your counselor one discovery and explain why it matters.',answer:'Example: Io’s plumes showed active volcanoes on another world. They changed what we knew about moons.'}
],crew:[
 {date:'16 JUL 1969 · LAUNCH',label:'Launch · Jul 16',title:'Three people, two spacecraft roles',fact:'Armstrong, Aldrin, and Collins launched on Apollo 11. Columbia carried the crew; Eagle was the lunar module that would land.',meaning:'The mission had to bring people and evidence home. Life support, navigation, and a return plan were essential.',question:'Why did Apollo need more than a scientific camera?',answer:'The crew needed air, power, protection, control of the spacecraft, and a safe return—not just observations.'},
 {date:'19 JUL 1969 · LUNAR ORBIT',label:'Orbit · Jul 19',title:'Slow down to stay at the Moon',fact:'Apollo 11 fired its engine to enter lunar orbit. Collins stayed in Columbia while Armstrong and Aldrin later descended in Eagle.',meaning:'Reaching the Moon’s distance is not the same as orbiting it. Speed and timing determine the path.',question:'What changes a flyby into an orbit in our model?',answer:'A correctly timed braking burn reduces the spacecraft’s speed relative to the Moon.'},
 {date:'20 JUL 1969 · THE LANDING',label:'Land · Jul 20',title:'People chose what to collect',fact:'Armstrong and Aldrin explored the Sea of Tranquility. They collected rocks and soil and placed experiments on the surface.',meaning:'The crew could observe nearby terrain and select samples. The evidence included physical material, photographs, and measurements.',question:'What evidence could scientists examine after the crew returned?',answer:'Lunar rocks and soil, along with photos and measurements. Physical samples can be tested with laboratory instruments.'},
 {date:'24 JUL 1969 · SPLASHDOWN',label:'Return · Jul 24',title:'Moon rocks revealed ancient lava',fact:'Apollo 11 returned about 21.5 kg of lunar material. Its basalt samples showed that the dark lunar plains formed from ancient lava.',meaning:'Laboratory analysis tied a visible lunar landscape to volcanic history. The Moon had a very different past.',question:'Compare Apollo’s evidence with Voyager 1’s evidence.',answer:'Voyager 1 sent remote images and measurements. Apollo 11 also returned samples that scientists could test in laboratories.'}
]};
function init(){document.querySelectorAll<HTMLElement>('[data-mission-journey]').forEach(root=>{if(root.dataset.wired)return;root.dataset.wired='1';
 const q=<T extends Element=HTMLElement>(s:string)=>root.querySelector<T>(s)!;let mode:'robot'|'crew'='robot',stop=0,progress=0,target=0,running=false,paused=matchMedia('(prefers-reduced-motion: reduce)').matches,raf=0,last=0;const reduced=paused;
 const routes={robot:'M144 191 Q220 31 316 61 Q420 31 535 79 Q625 36 707 62',crew:'M145 191 Q245 25 480 85 Q600 40 570 166 Q350 307 144 237'};const fractions={robot:[0,.34,.69,1],crew:[0,.39,.62,1]};
 function pose(){const path=q<SVGPathElement>('[data-mj-route]'),len=path.getTotalLength(),point=path.getPointAtLength(len*progress/100);q('[data-mj-craft]').setAttribute('transform',`translate(${point.x} ${point.y-19})`);const trace=q<SVGPathElement>('[data-mj-trace]');trace.setAttribute('d',routes[mode]);trace.style.strokeDasharray=String(len);trace.style.strokeDashoffset=String(len*(1-progress/100));q<HTMLInputElement>('[data-progress]').value=String(progress);}
 function render(){const s=journeys[mode][stop];for(const key of ['date','title','fact','meaning','question'] as const)q('[data-mj-'+key+']').textContent=s[key];q('[data-mj-answer-text]').textContent=s.answer;q<HTMLElement>('[data-mj-answer-text]').hidden=true;q('[data-mj-answer]').setAttribute('aria-expanded','false');q('[data-mj-answer]').textContent='Reveal a possible answer';q('[data-mj-route]').setAttribute('d',routes[mode]);root.querySelectorAll<HTMLElement>('[data-world]').forEach(e=>e.toggleAttribute('hidden',e.dataset.world!==mode));q('[data-mj-probe]').toggleAttribute('hidden',mode==='crew');q('[data-mj-capsule]').toggleAttribute('hidden',mode==='robot');
  root.querySelectorAll<HTMLElement>('[data-stop]').forEach((b,i)=>{b.querySelector('span')!.textContent=journeys[mode][i].label;b.setAttribute('aria-current',i===stop?'step':'false');const path=q<SVGPathElement>('[data-mj-route]'),p=path.getPointAtLength(path.getTotalLength()*fractions[mode][i]);q('[data-mj-pin="'+i+'"]').setAttribute('transform',`translate(${p.x} ${p.y})`);});q('[data-play]').textContent=stop===3?'↺ Fly again':'Fly to next stop →';pose();}
 function halt(){running=false;cancelAnimationFrame(raf);q('[data-play]').textContent=stop===3?'↺ Fly again':'Fly to next stop →';}
 function tick(now:number){if(!running)return;const dt=Math.min(80,now-last);last=now;if(!paused&&!root.closest('[data-motion-paused="true"]')&&!document.hidden&&root.getClientRects().length){progress=Math.min(target,progress+dt/40);pose();}if(progress>=target){running=false;stop=Math.min(3,stop+1);render();}else raf=requestAnimationFrame(tick);}
 function reset(){halt();stop=0;progress=0;render();}
 q('[data-play]').addEventListener('click',()=>{if(running){halt();return;}if(stop===3){reset();return;}target=fractions[mode][stop+1]*100;if(reduced){progress=target;stop++;render();return;}paused=false;root.dataset.paused='false';q('[data-motion]').setAttribute('aria-pressed','false');q('[data-motion]').textContent='Pause motion Ⅱ';running=true;last=performance.now();q('[data-play]').textContent='Pause flight Ⅱ';raf=requestAnimationFrame(tick);});
 q('[data-reset]').addEventListener('click',reset);q('[data-motion]').addEventListener('click',()=>{paused=!paused;root.dataset.paused=String(paused);q('[data-motion]').setAttribute('aria-pressed',String(paused));q('[data-motion]').textContent=paused?'Resume motion ▶':'Pause motion Ⅱ';});
 root.querySelectorAll<HTMLElement>('[data-mode]').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode as typeof mode;root.querySelectorAll('[data-mode]').forEach(el=>el.setAttribute('aria-pressed',String(el===b)));reset();}));
 root.querySelectorAll<HTMLElement>('[data-stop]').forEach(b=>b.addEventListener('click',()=>{halt();stop=Number(b.dataset.stop);progress=fractions[mode][stop]*100;render();}));
 q('[data-progress]').addEventListener('input',e=>{halt();progress=Number((e.target as HTMLInputElement).value);stop=fractions[mode].reduce((n,f,i)=>progress+0.01>=f*100?i:n,0);render();});
 q('[data-mj-answer]').addEventListener('click',()=>{const answer=q<HTMLElement>('[data-mj-answer-text]');answer.hidden=!answer.hidden;q('[data-mj-answer]').setAttribute('aria-expanded',String(!answer.hidden));q('[data-mj-answer]').textContent=answer.hidden?'Reveal a possible answer':'Hide answer';});root.dataset.paused=String(paused);q('[data-motion]').setAttribute('aria-pressed',String(paused));q('[data-motion]').textContent=paused?'Resume motion ▶':'Pause motion Ⅱ';render();
 });}init();document.addEventListener('astro:page-load',init);
</script>
