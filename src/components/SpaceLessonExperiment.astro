---
const {kind='satellites'}=Astro.props;
const names={satellites:'SPACE WORKS FOR EARTH',forces:'EQUAL FORCE. DIFFERENT OBJECTS.',assembly:'EVERY PART HAS A JOB',readiness:'CLASSROOM COUNTDOWN SIMULATION',results:'PREDICT. FLY. COMPARE.'};
const uid=`experiment-${kind}`;
---
<section class="lesson-experiment" data-experiment={kind} aria-label={names[kind]}>
 <div class="experiment-visual"><svg viewBox="0 0 900 380" role="img" aria-labelledby={uid+'-title'}><title id={uid+'-title'}>{names[kind]}</title>
 <defs><radialGradient id={uid+'-earth'} cx="25%" cy="20%"><stop stop-color="#53ccdf"/><stop offset=".5" stop-color="#216e97"/><stop offset="1" stop-color="#0a1b36"/></radialGradient><linearGradient id={uid+'-metal'} x1="0" x2="0" y1="0" y2="1"><stop stop-color="#ecf8ff"/><stop offset=".5" stop-color="#a8bfd0"/><stop offset="1" stop-color="#3a506c"/></linearGradient><marker id={uid+'-arrow'} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M0 0 10 5 0 10Z" fill="currentColor"/></marker></defs>
 {Array.from({length:35},(_,i)=><circle cx={(i*131+15)%900} cy={(i*71+11)%380} r="1" fill="#d2e9fa" opacity=".2"/>)}
 {kind==='satellites'&&<>
  <circle cx="230" cy="204" r="110" fill={`url(#${uid}-earth)`}/><path d="M160 133 193 117 220 147 202 178 169 186 140 165M230 211 263 198 284 235 255 288 235 263" fill="#88e3bb" opacity=".65"/>
  <ellipse cx="230" cy="204" rx="165" ry="137" fill="none" stroke="#78c9e6" stroke-dasharray="3 8" opacity=".35"/>
  <g class="service-satellite"><path d="M309 78 371 102 359 129 297 105Z" fill="#2b6483" stroke="#8bdef1"/><rect x="321" y="91" width="27" height="21" rx="3" fill="#edf8fa"/><path d="M334 91V74" stroke="#edf8fa" stroke-width="2"/></g>
  <path class="service-signal" d="M330 119 266 200M330 119 194 237M330 119 281 262" stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 8" opacity=".7"/>
  {['WEATHER','NAVIGATION','COMMUNICATIONS'].map((label,i)=><g data-service-card={i}><rect x="475" y={52+i*100} width="370" height="78" rx="12" fill="#132439" stroke="#4d6983"/><circle cx="511" cy={91+i*100} r="10" fill="var(--accent)"/><text x="539" y={86+i*100} class="ex-label">{label}</text><text x="539" y={111+i*100} class="ex-small">{['See storms take shape','Locate yourself on Earth','Connect people across distance'][i]}</text></g>)}
  <text x="230" y="360" text-anchor="middle" class="ex-micro">ILLUSTRATIVE ORBIT · NOT TO SCALE</text>
 </>}
 {kind==='forces'&&<>
  {[0,1,2,3,4,5,6].map(i=><circle class="exhaust-particle" cx={280+i*20} cy={170+(i%3)*20} r={3+i%3} fill="#ffd096" style={`--delay:${-i*.2}s`}/>)}
  <g transform="translate(520 195)"><path d="M-50 -35H128Q165 -26 195 0Q165 26 128 35H-50Z" fill={`url(#${uid}-metal)`}/><path d="M-25 -35 -88 -88 -91 -35M-25 35 -88 88 -91 35" fill="var(--accent)"/><circle cx="110" cy="0" r="19" fill="#10364b" stroke="#8ee5ea" stroke-width="4"/></g>
  <path data-gas-force d="M380 195H145" fill="none" stroke="#ffc18b" stroke-width="10" style="color:#ffc18b" marker-end={`url(#${uid}-arrow)`}/>
  <path data-rocket-force d="M530 90H765" fill="none" stroke="#8eefda" stroke-width="10" style="color:#8eefda" marker-end={`url(#${uid}-arrow)`}/>
  <text x="225" y="140" text-anchor="middle" class="ex-label">FORCE ON GAS</text><text x="660" y="56" text-anchor="middle" class="ex-label">FORCE ON ROCKET</text>
  <text x="225" y="275" text-anchor="middle" class="ex-big" data-gas-value>20 N</text><text x="660" y="275" text-anchor="middle" class="ex-big" data-rocket-value>20 N</text>
  <text x="450" y="350" text-anchor="middle" class="ex-small">The pair does not cancel: each force acts on a different object.</text>
 </>}
 {kind==='assembly'&&<>
  <path d="M65 200H825" fill="none" stroke="#6c8099" stroke-dasharray="5 9" opacity=".5"/>
  <g data-assembly-part="0"><path d="M650 169Q707 172 735 200Q707 228 650 231Z" fill="var(--accent)"/><text x="690" y="145" text-anchor="middle" class="ex-small">NOSE</text></g>
  <g data-assembly-part="1"><rect x="573" y="169" width="77" height="62" rx="3" fill="#6381a7" stroke="#b6d1e9"/><circle cx="608" cy="200" r="16" fill="#0a2b40" stroke="#89e5ee" stroke-width="3"/><text x="610" y="264" text-anchor="middle" class="ex-small">PAYLOAD</text></g>
  <g data-assembly-part="2"><rect x="461" y="169" width="112" height="62" rx="3" fill="#244450" stroke="#97d9d0"/><path d="M480 197Q514 155 549 197Z" fill="#ffb18c"/><path d="M480 197 515 221 549 197M515 197V221" stroke="#fff5d7" fill="none"/><text x="517" y="145" text-anchor="middle" class="ex-small">RECOVERY</text></g>
  <g data-assembly-part="3"><rect x="270" y="169" width="191" height="62" rx="4" fill={`url(#${uid}-metal)`}/><path d="M366 170V230" stroke="var(--accent)" stroke-width="14"/><text x="370" y="264" text-anchor="middle" class="ex-small">BODY TUBE</text></g>
  <g data-assembly-part="4"><path d="M287 169 232 108 228 169M287 231 232 292 228 231" fill="var(--accent)"/><text x="230" y="82" text-anchor="middle" class="ex-small">FINS</text></g>
  <g data-assembly-part="5"><rect x="218" y="179" width="52" height="42" rx="4" fill="#677387" stroke="#cdd9e7"/><path d="M219 186 202 194V206L219 214" fill="#92a6be"/><text x="203" y="327" text-anchor="middle" class="ex-small">MOTOR + MOUNT</text></g>
  <text x="450" y="371" text-anchor="middle" class="ex-micro">EXPLODED VIEW · FOLLOW YOUR KIT’S INSTRUCTIONS FOR ASSEMBLY</text>
 </>}
 {kind==='readiness'&&<>
  <circle cx="235" cy="185" r="122" fill="#0b192a" stroke="#31485c" stroke-width="2"/><circle cx="235" cy="185" r="110" fill="none" stroke="var(--accent)" stroke-width="7" stroke-dasharray="691" data-countdown-ring transform="rotate(-90 235 185)"/>
  <text x="235" y="152" text-anchor="middle" class="ex-label">T MINUS</text><text x="235" y="227" text-anchor="middle" class="ex-count" data-countdown>10</text>
  {['PAD CLEAR','RECOVERY READY','WEATHER GO'].map((label,i)=><g data-gate-card={i}><rect x="435" y={53+i*91} width="375" height="70" rx="10" fill="#132439" stroke="#3f5e6d"/><circle cx="472" cy={88+i*91} r="9" fill="var(--accent)"/><text x="498" y={94+i*91} class="ex-label">{label}</text><text x="777" y={94+i*91} text-anchor="end" class="ex-label" data-gate-text={i}>GO</text></g>)}
  <text x="450" y="365" text-anchor="middle" class="ex-micro">CLASSROOM SIMULATION ONLY · USE THE REAL RANGE PROCEDURES ON LAUNCH DAY</text>
 </>}
 {kind==='results'&&<>
  {[60,120,180].map(v=><g><path d={`M70 ${300-v*1.2}H475`} stroke="#546a80" stroke-dasharray="4 6" opacity=".4"/><text x="56" y={305-v*1.2} text-anchor="end" class="ex-small">{v}</text></g>)}
  <path d="M70 45V300H500" stroke="#668095" stroke-width="2" fill="none"/><path d="M70 300 470 60" stroke="var(--accent)" stroke-width="2" stroke-dasharray="5 8"/>
  <path data-error-line d="M310 156V185" stroke="#ffb794" stroke-width="3"/>
  <circle data-result-dot cx="310" cy="185" r="10" fill="#b9ffe7" style="filter:drop-shadow(0 0 8px #8ee9d2)"/>
  <text x="70" y="28" class="ex-label">MEASURED ↑ (m)</text><text x="500" y="331" text-anchor="end" class="ex-small">PREDICTED → (m)</text>
  {[60,120,180].map(v=><text x={70+v*2} y="322" text-anchor="middle" class="ex-small">{v}</text>)}
  <text x="563" y="92" class="ex-label">PREDICTION</text><rect x="563" y="112" width="264" height="40" rx="6" fill="#17263d"/><rect data-prediction-bar x="563" y="112" width="176" height="40" rx="6" fill="#b29afb"/>
  <text x="563" y="208" class="ex-label">MEASURED</text><rect x="563" y="228" width="264" height="40" rx="6" fill="#17263d"/><rect data-measured-bar x="563" y="228" width="140" height="40" rx="6" fill="#92ebd1"/>
  <text x="563" y="181" class="ex-big" data-prediction-label>120 m</text><text x="563" y="299" class="ex-big" data-measured-label>96 m</text>
  <text x="450" y="371" text-anchor="middle" class="ex-micro">ILLUSTRATIVE DATA · ERROR = |MEASURED − PREDICTED| ÷ PREDICTED × 100%</text>
 </>}
 </svg></div>
 <div class="experiment-status"><span data-experiment-label>{names[kind]}</span><strong data-experiment-value></strong><p data-experiment-message></p></div>
 <div class="experiment-controls">
 {kind==='satellites'&&['Weather','Navigation','Communications'].map((t,i)=><button data-service={i} aria-pressed={i===0?'true':'false'}>{t}</button>)}
 {kind==='forces'&&<><label>Force in the pair <output data-force-out>20 N</output><input type="range" min="10" max="40" step="5" value="20" data-force aria-label="Force in the action reaction pair"/></label><span>Try a stronger push.</span></>}
 {kind==='assembly'&&<><label>Bring the parts together <input type="range" min="0" max="100" value="0" data-assembly aria-label="Assembly progress"/></label><button data-assembly-reset>Explode</button><button data-assembly-join>Assemble</button></>}
 {kind==='readiness'&&<>{['Pad clear','Recovery ready','Weather go'].map((t,i)=><button data-gate={i} aria-pressed="true">✓ {t}</button>)}<button data-countdown-run>Ⅱ Hold</button></>}
 {kind==='results'&&<><label>Predicted <input type="range" min="60" max="180" value="120" data-predicted aria-label="Predicted altitude in meters"/></label><label>Measured <input type="range" min="60" max="180" value="96" data-measured aria-label="Measured altitude in meters"/></label></>}
 <button data-experiment-replay class="ex-replay">↺ Replay</button>
 </div>
</section>
<style>
.lesson-experiment{display:grid;grid-template-columns:minmax(0,1fr) 225px;border:1px solid #344b65;border-radius:14px;background:linear-gradient(125deg,#15233b,#081222);overflow:hidden;color:#eaf3ff;font-family:ui-sans-serif,system-ui;width:100%;min-height:0}.experiment-visual{min-width:0;display:flex;align-items:center;padding:10px}.experiment-visual svg{width:100%;height:auto;max-height:48vh;display:block;overflow:hidden}.lesson-experiment svg text{fill:#b7cce1;font-family:ui-sans-serif,system-ui;font-size:14px}.lesson-experiment svg .ex-label{font-size:17px;letter-spacing:1px;font-weight:750;fill:#dfebf8}.lesson-experiment svg .ex-small{font-size:17px}.lesson-experiment svg .ex-micro{font-size:11px;letter-spacing:.8px;fill:#809bb7}.lesson-experiment svg .ex-big{font-size:28px;font-weight:800;fill:var(--accent,#9af1cf)}.lesson-experiment svg .ex-count{font-size:90px;font-weight:800;letter-spacing:-4px;fill:var(--accent,#9af1cf)}.experiment-status{display:flex;flex-direction:column;justify-content:center;gap:14px;border-left:1px solid #425a712f;padding:24px}.experiment-status>span{font-size:10px;font-weight:750;letter-spacing:.1em;color:#95aec8;line-height:1.4}.experiment-status strong{font-size:clamp(32px,4vw,58px);line-height:1.05;letter-spacing:-.04em;color:var(--accent,#9af1cf)}.experiment-status p{font-size:16px;line-height:1.3;margin:0;color:#d7e4f2}.experiment-controls{grid-column:1/-1;display:flex;flex-wrap:wrap;align-items:center;gap:10px;background:#07101e;border-top:1px solid #31445c;padding:12px 16px}.experiment-controls button{font:700 12px ui-sans-serif,system-ui;padding:10px 13px;border:1px solid #485e78;color:#d5e6f6;background:#142237;border-radius:6px;cursor:pointer}.experiment-controls button[aria-pressed=true]{border-color:var(--accent);color:var(--accent);background:#173637}.experiment-controls button:focus-visible,.experiment-controls input:focus-visible{outline:3px solid #ffe9a1;outline-offset:3px}.experiment-controls label{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:650;flex-wrap:wrap}.experiment-controls output{color:var(--accent);font-weight:800}.experiment-controls input{width:145px;accent-color:var(--accent)}.experiment-controls>span{font-size:11px;color:#9db4cc}.experiment-controls .ex-replay{margin-left:auto}.service-satellite{animation:service-drift 4s ease-in-out infinite}.service-signal{animation:service-signal 1.2s linear infinite}.exhaust-particle{animation:gas-flow 1.2s linear infinite;animation-delay:var(--delay)}[data-service-card],[data-gate-card]{transition:opacity .4s}[data-assembly-part]{transition:transform .1s linear}[data-result-dot],[data-error-line],[data-prediction-bar],[data-measured-bar]{transition:all .45s ease}@keyframes service-drift{50%{transform:translate(4px,-6px)}}@keyframes service-signal{to{stroke-dashoffset:28}}@keyframes gas-flow{to{transform:translateX(-200px);opacity:0}}@media(max-width:900px){.lesson-experiment{grid-template-columns:minmax(0,1fr) 180px}.experiment-status{padding:16px}.experiment-status p{font-size:14px}.experiment-controls{gap:7px}.experiment-controls button{font-size:10px}.experiment-controls input{width:110px}}@media(max-width:650px){.lesson-experiment{grid-template-columns:1fr}.experiment-status{border-left:0;border-top:1px solid #31445c;display:grid;grid-template-columns:110px 1fr;gap:6px 12px;padding:12px 16px}.experiment-status>span{grid-column:2;font-size:8px}.experiment-status strong{grid-column:1;grid-row:1/3;font-size:30px;align-self:center}.experiment-status p{grid-column:2;font-size:12px}.experiment-controls{padding:9px;gap:6px}.experiment-controls label{font-size:10px}.experiment-controls button{font-size:9px;padding:9px}.experiment-controls input{width:85px}.experiment-visual svg{max-height:34vh}.experiment-controls>span{display:none}}@media(prefers-reduced-motion:reduce){.lesson-experiment *{animation:none!important;transition:none!important}}
</style>
<script>
document.querySelectorAll<HTMLElement>('[data-experiment]').forEach(root=>{
 const kind=root.dataset.experiment!,q=<T extends Element=HTMLElement>(s:string)=>root.querySelector<T>(s)!;
 const put=(s:string,text:string)=>{q(s).textContent=text;};const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
 let time=0,last=0,auto=!reduced,wasVisible=false,service=0,assembly=0,countdown=10,running=true,gates=[true,true,true],force=20;
 const state=(value:string,message:string)=>{put('[data-experiment-value]',value);put('[data-experiment-message]',message);};
 function render(){
  if(kind==='satellites'){const labels=['WEATHER','POSITION','CONTACT'],messages=['Watch storms develop from above.','Use satellite signals to work out where you are.','Relay information between distant places.'];state(labels[service],messages[service]);root.querySelectorAll<HTMLElement>('[data-service-card]').forEach((e,i)=>e.setAttribute('opacity',i===service?'1':'.25'));root.querySelectorAll<HTMLElement>('[data-service]').forEach((e,i)=>e.setAttribute('aria-pressed',String(i===service)));}
  if(kind==='forces'){q('[data-gas-force]').setAttribute('d',`M380 195H${380-force*6}`);q('[data-rocket-force]').setAttribute('d',`M530 90H${530+force*6}`);put('[data-gas-value]',force+' N');put('[data-rocket-value]',force+' N');put('[data-force-out]',force+' N');state('1 : 1','Equal strength. Opposite directions. Different objects.');q<HTMLInputElement>('[data-force]').value=String(force);}
  if(kind==='assembly'){const offsets=[[80,-48],[38,65],[0,-75],[-45,65],[-70,-25],[-92,45]];root.querySelectorAll('[data-assembly-part]').forEach((e,i)=>e.setAttribute('transform',`translate(${offsets[i][0]*(1-assembly/100)} ${offsets[i][1]*(1-assembly/100)})`));q<HTMLInputElement>('[data-assembly]').value=String(assembly);state(assembly>98?'READY':'6 GROUPS',assembly>98?'A complete system. Every part has a purpose.':'Name the parts before they come together.');}
  if(kind==='readiness'){const go=gates.every(Boolean);put('[data-countdown]',String(Math.ceil(countdown)).padStart(2,'0'));q('[data-countdown-ring]').setAttribute('stroke-dashoffset',String(691*(1-countdown/10)));state(!go?'HOLD':countdown<=0?'GO':running?'COUNTING':'HOLD',!go?'One no-go stops the clock. Restore every station before continuing.':countdown<=0?'Simulation complete. The real launch follows the range director’s commands.':running?'Listen to the calls. Anyone can call a hold.':'The clock stays here until the crew is ready.');root.querySelectorAll<HTMLElement>('[data-gate]').forEach((b,i)=>{b.setAttribute('aria-pressed',String(gates[i]));b.textContent=(gates[i]?'✓ ':'× ')+['Pad clear','Recovery ready','Weather go'][i];put(`[data-gate-text="${i}"]`,gates[i]?'GO':'HOLD');q(`[data-gate-card="${i}"]`).setAttribute('opacity',gates[i]?'1':'.4');});put('[data-countdown-run]',running&&go&&countdown>0?'Ⅱ Hold':countdown<=0?'↺ Restart':'▶ Continue');}
  if(kind==='results'){const p=Number(q<HTMLInputElement>('[data-predicted]').value),m=Number(q<HTMLInputElement>('[data-measured]').value),error=Math.abs(m-p)/p*100;const x=70+p*2,y=300-m*1.2;q('[data-result-dot]').setAttribute('cx',String(x));q('[data-result-dot]').setAttribute('cy',String(y));q('[data-error-line]').setAttribute('d',`M${x} ${300-p*1.2}V${y}`);q('[data-prediction-bar]').setAttribute('width',String(p/180*264));q('[data-measured-bar]').setAttribute('width',String(m/180*264));put('[data-prediction-label]',p+' m');put('[data-measured-label]',m+' m');state(error.toFixed(1)+'%',m===p?'A perfect prediction in this example.':m<p?'Below prediction. What did your model miss?':'Above prediction. Which assumption needs another look?');}
 }
 function reset(){time=0;auto=!reduced;service=0;assembly=0;force=20;countdown=10;running=!reduced;gates=[true,true,true];if(kind==='results'){q<HTMLInputElement>('[data-predicted]').value='120';q<HTMLInputElement>('[data-measured]').value='96';}render();}
 root.addEventListener('space:replay',reset);q('[data-experiment-replay]').addEventListener('click',reset);
 root.addEventListener('click',e=>{if(e.isTrusted&&!(e.target as HTMLElement).closest('[data-experiment-replay]'))auto=false;});root.addEventListener('input',()=>{auto=false;});
 root.querySelectorAll<HTMLElement>('[data-service]').forEach((b,i)=>b.addEventListener('click',()=>{service=i;render();}));
 q<HTMLInputElement>('[data-force]')?.addEventListener('input',e=>{force=Number((e.target as HTMLInputElement).value);render();});
 q<HTMLInputElement>('[data-assembly]')?.addEventListener('input',e=>{assembly=Number((e.target as HTMLInputElement).value);render();});
 q('[data-assembly-reset]')?.addEventListener('click',()=>{assembly=0;render();});q('[data-assembly-join]')?.addEventListener('click',()=>{assembly=100;render();});
 root.querySelectorAll('[data-gate]').forEach((b,i)=>b.addEventListener('click',()=>{gates[i]=!gates[i];if(!gates[i])running=false;render();}));
 q('[data-countdown-run]')?.addEventListener('click',()=>{if(countdown<=0){countdown=10;running=false;}if(gates.every(Boolean))running=!running;render();});
 ['[data-predicted]','[data-measured]'].forEach(s=>q(s)?.addEventListener('input',render));
 root.addEventListener('keydown',e=>{if((e.target as HTMLElement).matches('input,button')&&['ArrowLeft','ArrowRight','Home','End',' '].includes(e.key))e.stopPropagation();});
 function tick(now:number){const dt=last?Math.min(now-last,60):0;last=now;const box=root.getBoundingClientRect();const visible=!!root.getClientRects().length&&box.bottom>0&&box.top<innerHeight&&!document.hidden;const paused=root.closest('[data-motion-paused="true"]');if(visible&&!wasVisible)reset();wasVisible=visible;if(visible&&!paused){time+=dt;if(auto){if(kind==='satellites')service=Math.floor(time/4000)%3;if(kind==='forces')force=[20,30,40,10][Math.floor(time/3000)%4];if(kind==='assembly'){const t=time%12000;assembly=t<2000?0:t<6500?(t-2000)/45:t<10000?100:100-(t-10000)/20;}if(kind==='results'){const m=[96,144,120][Math.floor(time/4000)%3];q<HTMLInputElement>('[data-measured]').value=String(m);}if(kind==='readiness'&&time>=6000){gates[2]=false;running=false;countdown=4;auto=false;}}
 if(kind==='readiness'&&running&&gates.every(Boolean)&&countdown>0)countdown=Math.max(0,countdown-dt/1000);render();}requestAnimationFrame(tick);}
 reset();requestAnimationFrame(tick);
});
</script>
