---
import { getBooks } from "../lib/content";

const collection = getBooks().filter((book) => book.series === "Drone Field Guide");
// The book on sale goes in the middle, on top; the companions fan out either side of it.
const lead = collection.find((book) => book.buy) ?? collection[0];
const others = collection.filter((book) => book !== lead);
const half = Math.floor(others.length / 2);
const fan = [...others.slice(0, half), lead, ...others.slice(half)];
const middle = (fan.length - 1) / 2;
const step = Math.min(12, 90 / (fan.length - 1));   // ten covers fan out 10 degrees apart
const href = (book) => book.link ?? `/books/${book.slug}/`;
---
<div class="fan-panel">
  <p class="shelf-eyebrow">Engineering starts with a question</p>
  <p class="shelf-title">What could you build?</p>
  <p class="shelf-lede">From the garage to the water. From the kitchen table to other worlds.</p>
  <div class="book-fan">
    {fan.map((book, i) => (
      <a
        class="book-fan-item"
        href={href(book)}
        aria-label={book.title}
        style={`--angle:${(i - middle) * step}deg;--lift:${Math.abs(i - middle) * 5}px;z-index:${10 - Math.abs(i - fan.indexOf(lead))}`}
      >
        <img src={`/images/books/shelf/${book.slug}.jpg`} alt="" width="440" height="570" loading="lazy" />
      </a>
    ))}
  </div>
</div>
