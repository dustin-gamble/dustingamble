---
// 3D flight replay. Reads a telemetry CSV (or the bundled demo flight) and
// draws the trajectory in an orbitable 3D view with playback.
//
// Deliberately dependency-free: the projection is ~20 lines of maths on a 2D
// canvas rather than a WebGL library. Nothing to install, nothing to break on
// a laptop at the edge of a field, and it works in a slide.
import demo from "../data/demo-flight.json";
---

<div class="t3d" data-t3d>
  <div class="t3d-head">
    <div>
      <h4>3D flight replay</h4>
      <p>Drag to orbit · scroll to zoom · scrub the timeline. Loaded with a demo flight — paste your own CSV below after launch day.</p>
    </div>
    <div class="t3d-views">
      <button type="button" class="t3d-vbtn is-on" data-view="orbit">Orbit</button>
      <button type="button" class="t3d-vbtn" data-view="side">Side</button>
      <button type="button" class="t3d-vbtn" data-view="top">Top</button>
    </div>
  </div>

  <div class="t3d-body">
    <div class="t3d-stage">
      <canvas data-t3d-canvas width="720" height="440" role="img"
        aria-label="Three-dimensional replay of a model rocket flight path"></canvas>
      <div class="t3d-clock" data-t3d-clock>T+0.0 s</div>
      <div class="t3d-phase" data-t3d-phase>Ready</div>
    </div>

    <div class="t3d-panel">
      <dl class="t3d-readout" data-t3d-readout></dl>

      <div class="t3d-transport">
        <button type="button" class="t3d-btn t3d-btn-go" data-t3d-play>▶ Play</button>
        <button type="button" class="t3d-btn" data-t3d-reset>Reset</button>
      </div>

      <label class="t3d-scrub">
        Timeline
        <input type="range" data-t3d-scrub min="0" max="1000" step="1" value="0" />
      </label>

      <label class="t3d-scrub">
        Speed <output data-t3d-rate>1</output>&times;
        <input type="range" data-t3d-rate-in min="1" max="8" step="1" value="2" />
      </label>

      <dl class="t3d-summary" data-t3d-summary></dl>
    </div>
  </div>

  <details class="t3d-load">
    <summary>Load your own flight</summary>
    <p>
      Paste CSV with one row per sample. Columns, in order:
      <code>time_s, altitude_m, speed_ms, latitude, longitude</code>.
      A header row is fine — it gets skipped. This is exactly the file the ground station writes.
    </p>
    <textarea data-t3d-csv rows="6" spellcheck="false"
      placeholder="0.0,0.0,0.0,35.305000,-120.710000&#10;0.2,0.5,4.9,35.305000,-120.710000&#10;..."></textarea>
    <div class="t3d-loadrow">
      <button type="button" class="t3d-btn t3d-btn-go" data-t3d-apply>Load flight</button>
      <button type="button" class="t3d-btn" data-t3d-demo>Back to demo</button>
      <span class="t3d-msg" data-t3d-msg></span>
    </div>
  </details>

  <script type="application/json" data-t3d-demo-data set:html={JSON.stringify(demo)}></script>
</div>

<style>
  .t3d {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 0.9rem 1.1rem 1rem;
  }

  .t3d-head { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: flex-start; }
  .t3d-head h4 { margin: 0 0 0.2rem; font-size: 1.05rem; }
  .t3d-head p { margin: 0 0 0.8rem; font-size: 0.85rem; color: var(--muted); line-height: 1.5; max-width: 56ch; }

  .t3d-views { display: flex; gap: 0.3rem; }

  .t3d-vbtn {
    font: inherit; font-size: 0.75rem; padding: 0.25rem 0.65rem;
    border-radius: 999px; border: 1px solid var(--line);
    background: transparent; color: var(--muted); cursor: pointer;
  }

  .t3d-vbtn.is-on { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
  :root[data-theme="dark"] .t3d-vbtn.is-on { color: #0f1623; }

  .t3d-body { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(12rem, 0.6fr); gap: 0.9rem; align-items: start; }

  .t3d-stage { position: relative; }

  .t3d-stage canvas {
    width: 100%; height: auto; display: block;
    border-radius: 10px; border: 1px solid var(--line);
    background: #060d18; cursor: grab; touch-action: none;
  }

  .t3d-stage canvas:active { cursor: grabbing; }

  .t3d-clock, .t3d-phase {
    position: absolute; top: 0.5rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem; letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem; border-radius: 999px;
    background: rgba(0,0,0,0.55); color: #fff;
  }

  .t3d-clock { left: 0.5rem; }
  .t3d-phase { right: 0.5rem; text-transform: uppercase; }

  .t3d-panel { display: grid; gap: 0.55rem; }

  .t3d-readout, .t3d-summary {
    display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 0.5rem;
    margin: 0; padding: 0.5rem 0.6rem;
    border-radius: 8px; background: var(--bg-alt); border: 1px solid var(--line);
    font-size: 0.78rem;
  }

  .t3d-readout dt, .t3d-summary dt { color: var(--muted); }

  .t3d-readout dd, .t3d-summary dd {
    margin: 0; text-align: right;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-variant-numeric: tabular-nums; font-weight: 700;
  }

  .t3d-summary { border-color: var(--accent); }

  .t3d-transport { display: flex; gap: 0.3rem; }

  .t3d-btn {
    font: inherit; font-size: 0.78rem; padding: 0.32rem 0.75rem;
    border-radius: 999px; border: 1px solid var(--line);
    background: transparent; color: var(--text); cursor: pointer;
  }

  .t3d-btn:hover { border-color: var(--accent); color: var(--accent-strong); }
  .t3d-btn-go { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 700; }
  :root[data-theme="dark"] .t3d-btn-go { color: #0f1623; }

  .t3d-scrub { display: grid; gap: 0.2rem; font-size: 0.75rem; font-weight: 600; color: var(--muted); }
  .t3d-scrub input { width: 100%; }
  .t3d-scrub output { font-family: ui-monospace, monospace; color: var(--accent-strong); }

  .t3d-load { margin-top: 0.9rem; border-top: 1px solid var(--line); padding-top: 0.7rem; }
  .t3d-load summary { cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--accent-strong); }
  .t3d-load p { font-size: 0.82rem; color: var(--muted); line-height: 1.55; }
  .t3d-load code { font-family: ui-monospace, monospace; font-size: 0.9em; }

  .t3d-load textarea {
    width: 100%; font-family: ui-monospace, monospace; font-size: 0.75rem;
    padding: 0.5rem; border-radius: 8px; border: 1px solid var(--line);
    background: var(--bg); color: var(--text); resize: vertical;
  }

  .t3d-loadrow { display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; margin-top: 0.4rem; }
  .t3d-msg { font-size: 0.78rem; color: var(--muted); }

  @media (max-width: 820px) {
    .t3d-body { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (function () {
    var M2FT = 3.28084, MS2MPH = 2.23694;

    function wire(root) {
      if (root.dataset.t3dWired) return;
      root.dataset.t3dWired = "1";

      var cv = root.querySelector("[data-t3d-canvas]");
      var ctx = cv.getContext("2d");
      var clockEl = root.querySelector("[data-t3d-clock]");
      var phaseEl = root.querySelector("[data-t3d-phase]");
      var readout = root.querySelector("[data-t3d-readout]");
      var summary = root.querySelector("[data-t3d-summary]");
      var scrub = root.querySelector("[data-t3d-scrub]");
      var rateIn = root.querySelector("[data-t3d-rate-in]");
      var rateOut = root.querySelector("[data-t3d-rate]");
      var msg = root.querySelector("[data-t3d-msg]");
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      var demoEl = root.querySelector("[data-t3d-demo-data]") ||
                   document.querySelector("[data-t3d-demo-data]");
      if (!demoEl) { console.error("Telemetry3D: demo flight data not found"); return; }
      var demoData = JSON.parse(demoEl.textContent);
      var pts = [], stats = null;
      var az = -0.7, el = 0.32, dist = 430;
      var playing = false, tNow = 0, raf = null, lastTs = 0;

      // ---- data prep: metres east/north/up relative to the pad ----
      function prep(rows) {
        if (!rows.length) return;
        var lat0 = rows[0][3], lon0 = rows[0][4];
        var mPerLat = 111320, mPerLon = 111320 * Math.cos(lat0 * Math.PI / 180);
        pts = rows.map(function (r) {
          return {
            t: r[0], z: r[1], v: r[2],
            x: (r[4] - lon0) * mPerLon,
            y: (r[3] - lat0) * mPerLat,
            phase: r[5] || (r[2] > 0 ? "c" : "d")
          };
        });
        var maxAlt = 0, maxV = 0, tApogee = 0;
        pts.forEach(function (p) {
          if (p.z > maxAlt) { maxAlt = p.z; tApogee = p.t; }
          if (Math.abs(p.v) > maxV) maxV = Math.abs(p.v);
        });
        var last = pts[pts.length - 1];
        stats = {
          maxAlt: maxAlt, maxV: maxV, tApogee: tApogee,
          duration: last.t,
          drift: Math.hypot(last.x, last.y)
        };
        // frame the view to the flight
        var span = Math.max(maxAlt, stats.drift, 30);
        dist = span * 2.9;
        tNow = 0; scrub.value = 0;
        renderSummary();
      }

      function renderSummary() {
        summary.innerHTML =
          "<dt>Apogee</dt><dd>" + Math.round(stats.maxAlt * M2FT) + " ft</dd>" +
          "<dt>Max speed</dt><dd>" + Math.round(stats.maxV * MS2MPH) + " mph</dd>" +
          "<dt>Time to apogee</dt><dd>" + stats.tApogee.toFixed(1) + " s</dd>" +
          "<dt>Flight time</dt><dd>" + stats.duration.toFixed(1) + " s</dd>" +
          "<dt>Landed from pad</dt><dd>" + Math.round(stats.drift * M2FT) + " ft</dd>";
      }

      // ---- projection ----
      function project(x, y, z) {
        var ca = Math.cos(az), sa = Math.sin(az);
        var X = x * ca - y * sa;
        var Y = x * sa + y * ca;
        var ce = Math.cos(el), se = Math.sin(el);
        var Y2 = Y * ce - z * se;
        var Z2 = Y * se + z * ce;
        var depth = Y2 + dist;
        if (depth < 1) return null;
        var f = (cv.width * 0.9) / depth;
        return { sx: cv.width / 2 + X * f, sy: cv.height * 0.62 - Z2 * f, d: depth };
      }

      var COLORS = { b: "#ffab3d", c: "#7fc4ff", d: "#7fd39b" };
      var NAMES = { b: "Boost", c: "Coast", d: "Descent" };

      function grid() {
        var span = Math.max(stats.maxAlt, stats.drift, 30) * 1.3;
        var step = span / 4;
        ctx.strokeStyle = "rgba(140,170,210,0.16)";
        ctx.lineWidth = 1;
        for (var i = -4; i <= 4; i++) {
          var a = project(i * step, -4 * step, 0), b = project(i * step, 4 * step, 0);
          var c = project(-4 * step, i * step, 0), d = project(4 * step, i * step, 0);
          if (a && b) { ctx.beginPath(); ctx.moveTo(a.sx, a.sy); ctx.lineTo(b.sx, b.sy); ctx.stroke(); }
          if (c && d) { ctx.beginPath(); ctx.moveTo(c.sx, c.sy); ctx.lineTo(d.sx, d.sy); ctx.stroke(); }
        }
        // pad marker
        var p0 = project(0, 0, 0);
        if (p0) {
          ctx.fillStyle = "#ff8a5c";
          ctx.beginPath(); ctx.arc(p0.sx, p0.sy, 4, 0, 7); ctx.fill();
          ctx.fillStyle = "rgba(255,255,255,0.65)";
          ctx.font = "10px ui-monospace, monospace";
          ctx.fillText("PAD", p0.sx + 7, p0.sy + 3);
        }
        // altitude ruler at apogee height
        var top = project(0, 0, stats.maxAlt);
        if (p0 && top) {
          ctx.strokeStyle = "rgba(140,170,210,0.28)";
          ctx.setLineDash([3, 4]);
          ctx.beginPath(); ctx.moveTo(p0.sx, p0.sy); ctx.lineTo(top.sx, top.sy); ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = "rgba(160,200,240,0.7)";
          ctx.fillText(Math.round(stats.maxAlt * M2FT) + " ft", top.sx + 6, top.sy);
        }
      }

      function draw() {
        var W = cv.width, H = cv.height;
        var g = ctx.createLinearGradient(0, 0, 0, H);
        g.addColorStop(0, "#050a14"); g.addColorStop(1, "#0d1a2c");
        ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
        if (!pts.length) return;

        grid();

        var idx = 0;
        while (idx < pts.length - 1 && pts[idx + 1].t <= tNow) idx++;

        // ground track (shadow)
        ctx.strokeStyle = "rgba(160,200,240,0.35)"; ctx.lineWidth = 1.5;
        ctx.beginPath();
        for (var i = 0; i <= idx; i++) {
          var s = project(pts[i].x, pts[i].y, 0); if (!s) continue;
          i ? ctx.lineTo(s.sx, s.sy) : ctx.moveTo(s.sx, s.sy);
        }
        ctx.stroke();

        // trajectory, coloured by phase
        ctx.lineWidth = 2.6;
        for (var j = 1; j <= idx; j++) {
          var a = project(pts[j - 1].x, pts[j - 1].y, pts[j - 1].z);
          var b = project(pts[j].x, pts[j].y, pts[j].z);
          if (!a || !b) continue;
          ctx.strokeStyle = COLORS[pts[j].phase] || "#7fc4ff";
          ctx.beginPath(); ctx.moveTo(a.sx, a.sy); ctx.lineTo(b.sx, b.sy); ctx.stroke();
        }

        var cur = pts[idx];
        var cp = project(cur.x, cur.y, cur.z);
        var gp = project(cur.x, cur.y, 0);
        if (cp && gp) {
          ctx.strokeStyle = "rgba(255,255,255,0.28)";
          ctx.setLineDash([2, 3]);
          ctx.beginPath(); ctx.moveTo(cp.sx, cp.sy); ctx.lineTo(gp.sx, gp.sy); ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = "#fff";
          ctx.beginPath(); ctx.arc(cp.sx, cp.sy, 4.5, 0, 7); ctx.fill();
          ctx.strokeStyle = COLORS[cur.phase] || "#fff"; ctx.lineWidth = 2;
          ctx.beginPath(); ctx.arc(cp.sx, cp.sy, 8, 0, 7); ctx.stroke();
        }

        // legend
        ctx.font = "10px ui-monospace, monospace";
        var lx = 10, ly = H - 34;
        ["b", "c", "d"].forEach(function (k, n) {
          ctx.fillStyle = COLORS[k];
          ctx.fillRect(lx, ly + n * 12 - 6, 8, 3);
          ctx.fillStyle = "rgba(255,255,255,0.6)";
          ctx.fillText(NAMES[k], lx + 14, ly + n * 12);
        });

        clockEl.textContent = "T+" + tNow.toFixed(1) + " s";
        phaseEl.textContent = NAMES[cur.phase] || "";
        readout.innerHTML =
          "<dt>Altitude</dt><dd>" + Math.round(cur.z * M2FT) + " ft</dd>" +
          "<dt>Speed</dt><dd>" + Math.round(Math.abs(cur.v) * MS2MPH) + " mph</dd>" +
          "<dt>Vertical</dt><dd>" + cur.v.toFixed(1) + " m/s</dd>" +
          "<dt>From pad</dt><dd>" + Math.round(Math.hypot(cur.x, cur.y) * M2FT) + " ft</dd>";
      }

      // ---- playback ----
      function tick(ts) {
        if (!playing) return;
        var rate = +rateIn.value;
        var dt = lastTs ? (ts - lastTs) / 1000 : 0;
        lastTs = ts;
        tNow += dt * rate;
        if (tNow >= stats.duration) { tNow = stats.duration; playing = false; setPlayLabel(); }
        scrub.value = Math.round((tNow / stats.duration) * 1000);
        draw();
        if (playing) raf = requestAnimationFrame(tick);
      }

      function setPlayLabel() {
        root.querySelector("[data-t3d-play]").textContent = playing ? "❚❚ Pause" : "▶ Play";
      }

      root.querySelector("[data-t3d-play]").addEventListener("click", function () {
        if (reduce) { tNow = stats.duration; scrub.value = 1000; draw(); return; }
        playing = !playing; lastTs = 0; setPlayLabel();
        if (playing) { if (tNow >= stats.duration) tNow = 0; raf = requestAnimationFrame(tick); }
        else if (raf) cancelAnimationFrame(raf);
      });

      root.querySelector("[data-t3d-reset]").addEventListener("click", function () {
        playing = false; setPlayLabel(); if (raf) cancelAnimationFrame(raf);
        tNow = 0; scrub.value = 0; draw();
      });

      scrub.addEventListener("input", function () {
        playing = false; setPlayLabel(); if (raf) cancelAnimationFrame(raf);
        tNow = (scrub.value / 1000) * stats.duration;
        draw();
      });

      rateIn.addEventListener("input", function () { rateOut.textContent = rateIn.value; });
      rateOut.textContent = rateIn.value;

      // ---- camera ----
      var dragging = false, lx = 0, ly2 = 0;
      cv.addEventListener("pointerdown", function (e) {
        dragging = true; lx = e.clientX; ly2 = e.clientY; cv.setPointerCapture(e.pointerId);
      });
      cv.addEventListener("pointermove", function (e) {
        if (!dragging) return;
        az += (e.clientX - lx) * 0.008;
        el = Math.max(-0.25, Math.min(1.3, el + (e.clientY - ly2) * 0.006));
        lx = e.clientX; ly2 = e.clientY;
        draw();
      });
      cv.addEventListener("pointerup", function () { dragging = false; });
      cv.addEventListener("wheel", function (e) {
        e.preventDefault();
        dist = Math.max(60, Math.min(3000, dist * (e.deltaY > 0 ? 1.1 : 0.9)));
        draw();
      }, { passive: false });

      root.querySelectorAll("[data-view]").forEach(function (b) {
        b.addEventListener("click", function () {
          root.querySelectorAll("[data-view]").forEach(function (x) { x.classList.toggle("is-on", x === b); });
          var v = b.dataset.view;
          if (v === "side") { az = 0; el = 0.02; }
          else if (v === "top") { az = 0; el = 1.28; }
          else { az = -0.7; el = 0.32; }
          draw();
        });
      });

      // ---- CSV loading ----
      function parseCSV(text) {
        var rows = [];
        text.trim().split(/\r?\n/).forEach(function (line) {
          var c = line.split(/[,;\t]/).map(function (s) { return parseFloat(s); });
          if (c.length >= 5 && c.every(function (n, i) { return i > 4 || !isNaN(n); })) {
            rows.push([c[0], c[1], c[2], c[3], c[4]]);
          }
        });
        return rows;
      }

      root.querySelector("[data-t3d-apply]").addEventListener("click", function () {
        var rows = parseCSV(root.querySelector("[data-t3d-csv]").value);
        if (rows.length < 3) { msg.textContent = "Need at least 3 valid rows of 5 columns."; return; }
        prep(rows); draw();
        msg.textContent = "Loaded " + rows.length + " samples.";
      });

      root.querySelector("[data-t3d-demo]").addEventListener("click", function () {
        prep(demoData); draw(); msg.textContent = "Demo flight restored.";
      });

      prep(demoData);
      draw();
    }

    function init() {
      document.querySelectorAll("[data-t3d]").forEach(wire);
    }
    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
