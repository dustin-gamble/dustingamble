---
import {decks} from '../../../data/space-exploration-fall-2026.js';
import {presentationThemes,presentationDeck} from '../../../data/space-presentations.js';
import SpaceLessonHero from '../../../components/SpaceLessonHero.astro';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#070d18"/><title>Space Exploration — Animated Lessons / Troop 308</title><meta name="description" content="Seven animated, projector-ready Space Exploration lessons, with offline downloads."/></head><body>
<header><a href="/scouts/space-exploration-fall-2026/#counselor"><span>✳</span> TROOP 308 / COUNSELOR GUIDE</a><span>SPACE EXPLORATION</span></header>
<main><section class="intro"><p class="eyebrow">THE ROOM IS YOUR MISSION CONTROL.</p><h1>Big ideas.<br/><em>Made to move.</em></h1><p>Seven lessons. Animated experiments. Everything ready for the big screen.</p><div class="intro-actions"><a class="primary" href="/scouts/space-lessons/missions/">Present Monday’s lesson →</a><a href="/handouts/space-lessons-offline.zip" download>↓ Save all lessons offline</a><a href="/scouts/space-presentation/">Play the five-experiment show ↗</a></div><p class="help">Open a lesson, then use ← → to advance. Space pauses. R replays. F fills the screen.</p></section>
<section class="lesson-grid" aria-label="Choose a lesson">{Object.values(decks).map(deck=>{const t=presentationThemes[deck.id];return <a class="lesson-card" href={`/scouts/space-lessons/${deck.id}/`} style={`--accent:${t.color}`}><div class="card-top"><span>LESSON {t.chapter}</span><span>{presentationDeck(deck).slides.length} SLIDES ↗</span></div><div class="card-art"><SpaceLessonHero kind={t.hero} id={'card-'+deck.id}/></div><div class="card-bottom"><h2>{t.title}</h2><p>{t.tagline}</p><span class="card-play">▶ Present lesson</span></div></a>})}</section>
<section class="offline-note"><h2>A room without Wi-Fi? Ready.</h2><p>The download includes all seven lessons with their photos, diagrams, simulations and animations. Unzip it and open <strong>index.html</strong>. Videos can be played from downloaded files using the picker on each video slide; YouTube playback needs internet.</p><p><a href="/scouts/space-exploration-offline/">Offline checklist & Monday’s teaching plan →</a></p></section>
<footer>Group learning. Individual discussion and demonstration. <a href="/scouts/space-exploration-fall-2026/#counselor">Full course, handouts & counselor notes →</a></footer></main>
</body></html>
<style is:global>*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 70% 0,#28355a44,transparent 50%),#070d18;color:#edf4fc;font-family:ui-sans-serif,system-ui,-apple-system,sans-serif}header{max-width:1310px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:27px 32px;border-bottom:1px solid #bed7ee1a;font-size:9px;letter-spacing:.13em}header a{color:#b8cfdf;text-decoration:none;font-weight:750}header a>span{font-size:25px;color:#9af1cf;vertical-align:middle;margin-right:10px}header>span{color:#8199b5}main{max-width:1280px;padding:0 32px;margin:auto}.intro{padding:64px 0 44px}.eyebrow{color:#9af1cf;font-size:10px;letter-spacing:.18em;font-weight:750;margin:0 0 20px}h1{font-size:clamp(48px,6vw,82px);line-height:1;letter-spacing:-.065em;margin:0 0 22px}h1 em{color:#9af1cf;font-style:normal}.intro>p:not(.eyebrow){font-size:17px;color:#a0b6cc;line-height:1.5}.intro-actions{display:flex;align-items:center;flex-wrap:wrap;gap:23px;margin:28px 0 18px}.intro-actions a{font-size:13px;color:#b9d6e8;text-decoration:none}.intro-actions .primary{background:#a2edce;color:#082a27;padding:15px 20px;border-radius:6px;font-weight:800}.intro .help{font-size:11px!important;color:#728da7!important}.lesson-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.lesson-card{border:1px solid #3c506980;background:linear-gradient(145deg,#17283c88,#0b1425);border-radius:15px;color:#ecf5ff;text-decoration:none;overflow:hidden;transition:transform .2s,border-color .2s}.lesson-card:hover{transform:translateY(-4px);border-color:var(--accent)}.card-top{display:flex;justify-content:space-between;padding:19px 20px 0;color:var(--accent);font-size:9px;font-weight:700;letter-spacing:.12em}.card-top span+span{color:#728ea7;font-weight:500}.card-art{height:225px;padding:8px 20px}.card-art .lesson-hero{height:100%}.card-art .lesson-hero svg{height:100%;max-height:100%}.card-art .lesson-hero text{display:none}.card-bottom{padding:0 22px 23px}.card-bottom h2{font-size:24px;letter-spacing:-.04em;margin:0 0 8px}.card-bottom p{font-size:12px;line-height:1.5;color:#91a9c0;margin:0 0 20px}.card-play{display:block;padding-top:16px;border-top:1px solid #99bbd31a;font-size:11px;color:var(--accent);font-weight:750}.offline-note{margin:44px 0 0;padding:26px 28px;border:1px solid #365548;border-radius:13px;background:#12362b33}.offline-note h2{font-size:25px;letter-spacing:-.035em;margin:0 0 13px}.offline-note p{font-size:13px;color:#a5c0ca;line-height:1.7;max-width:90ch}.offline-note a,footer a{color:#9af1cf}footer{display:flex;justify-content:space-between;gap:15px;padding:35px 0;font-size:11px;color:#708da4;line-height:1.6}@media(max-width:900px){.lesson-grid{grid-template-columns:repeat(2,1fr)}.intro{padding-top:40px}}@media(max-width:570px){header{padding:20px}header>span{display:none}main{padding:0 20px}.lesson-grid{grid-template-columns:1fr}.card-art{height:235px}.intro-actions{gap:18px}.intro>p:not(.eyebrow){font-size:15px}footer{display:block}.offline-note{padding:20px}.eyebrow{font-size:8px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style>
