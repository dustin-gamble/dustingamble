<style>
  /* ---------- wide page shell ---------- */
  .se-page {
    max-width: 82rem;
    margin: 0 auto;
    padding: 0 1.25rem 5rem;
    font-size: 1rem;
    line-height: 1.65;
  }

  .se-crumbs { font-size: 0.88rem; margin: 0 0 1.4rem; }

  .se-hero { display: flex; gap: 1.1rem; align-items: flex-start; margin-bottom: 1.6rem; }
  .se-hero-icon { font-size: 2.6rem; line-height: 1; }
  .se-hero h1 { margin: 0.15rem 0 0.5rem; font-size: clamp(1.9rem, 3.6vw, 2.7rem); line-height: 1.1; }
  .se-hero-sum { margin: 0 0 0.9rem; font-size: 1.06rem; color: var(--muted); max-width: 62ch; }

  .se-block { margin: 0 0 3rem; }
  .se-block > h2 {
    font-size: 1.5rem;
    margin: 0 0 0.7rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--line);
  }
  .se-block h3 { font-size: 1.12rem; margin: 1.6rem 0 0.5rem; }
  .se-block h4 { font-size: 0.98rem; margin: 1.2rem 0 0.4rem; }
  .se-block > p, .se-block > ul, .se-block > ol { max-width: 78ch; }
  .se-lede { font-size: 1.08rem; }

  /* ---------- audience switch ---------- */
  .se-switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin: 0 0 2.4rem;
    padding: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-alt);
  }

  .se-switch-btn {
    font: inherit;
    display: grid;
    gap: 0.1rem;
    text-align: left;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .se-switch-btn strong { font-size: 1rem; color: var(--text); }
  .se-switch-btn span { font-size: 0.82rem; }
  .se-switch-btn:hover { border-color: var(--line); }

  .se-switch-btn.is-on {
    background: var(--accent);
    border-color: var(--accent);
  }

  .se-switch-btn.is-on strong,
  .se-switch-btn.is-on span { color: #fff; }
  :root[data-theme="dark"] .se-switch-btn.is-on strong,
  :root[data-theme="dark"] .se-switch-btn.is-on span { color: #0f1623; }

  /* ---------- expanders ---------- */
  .se-exp, .se-meeting {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    margin: 0.6rem 0;
    padding: 0 1.1rem;
  }

  .se-exp > summary, .se-meeting > summary {
    cursor: pointer;
    padding: 0.75rem 0;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    list-style: none;
  }

  .se-exp > summary::-webkit-details-marker,
  .se-meeting > summary::-webkit-details-marker { display: none; }

  .se-exp > summary::before, .se-meeting > summary::before {
    content: "＋";
    font-family: ui-monospace, monospace;
    color: var(--accent);
    font-size: 0.95rem;
    flex: none;
  }

  .se-exp[open] > summary::before, .se-meeting[open] > summary::before { content: "－"; }

  .se-exp[open], .se-meeting[open] { padding-bottom: 1.1rem; }
  .se-exp[open] > summary, .se-meeting[open] > summary { border-bottom: 1px solid var(--line); margin-bottom: 0.9rem; }

  .se-exp-when {
    margin-left: auto;
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .se-meeting > summary { padding: 0.95rem 0; }
  .se-meeting-title { display: grid; gap: 0.05rem; }
  .se-meeting-title strong { font-size: 1.08rem; }
  .se-meeting-title span { font-size: 0.85rem; color: var(--muted); font-weight: 400; }

  .se-meeting-n {
    flex: none;
    width: 2rem; height: 2rem;
    display: grid; place-items: center;
    border-radius: 999px;
    background: var(--accent); color: #fff;
    font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700;
  }

  :root[data-theme="dark"] .se-meeting-n { color: #0f1623; }

  /* ---------- cards, buys, awards ---------- */
  .se-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 0.8rem; margin: 1rem 0; }

  .se-buy {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.85rem 1rem;
    background: var(--surface);
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .se-buy-top { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; }
  .se-buy-top h3 { margin: 0; font-size: 1rem; }
  .se-buy-price { font-family: ui-monospace, monospace; font-weight: 700; color: var(--accent-strong); white-space: nowrap; }
  .se-buy p { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .se-buy-links { display: flex; gap: 0.4rem; margin: 0.2rem 0 0 !important; flex-wrap: wrap; }

  .se-btn-buy, .se-btn-alt {
    font-size: 0.82rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid var(--accent);
  }

  .se-btn-buy { background: var(--accent); color: #fff; font-weight: 600; }
  :root[data-theme="dark"] .se-btn-buy { color: #0f1623; }
  .se-btn-alt { color: var(--accent-strong); }
  .se-btn-buy:hover, .se-btn-alt:hover { background: var(--accent-strong); color: #fff; }
  :root[data-theme="dark"] .se-btn-buy:hover, :root[data-theme="dark"] .se-btn-alt:hover { color: #0f1623; }

  .se-awards { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.7rem; margin: 1rem 0; }

  .se-award {
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    background: var(--surface);
  }

  .se-award h3 { margin: 0 0 0.3rem; font-size: 1rem; }
  .se-award p { margin: 0 0 0.5rem; font-size: 0.88rem; color: var(--muted); }

  .se-sims { display: grid; gap: 1rem; margin: 1rem 0; }

  .se-vids { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.3rem; }
  .se-vids li { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: baseline; font-size: 0.92rem; }
  .se-vids span { font-size: 0.8rem; color: var(--muted); }

  .se-numbered { padding-left: 1.3rem; }
  .se-numbered li { margin-bottom: 0.4rem; }

  .se-two { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  .se-tight li { margin-bottom: 0.3rem; line-height: 1.55; font-size: 0.94rem; }

  /* ---------- timeline ---------- */
  .se-timeline { list-style: none; margin: 1rem 0 0; padding: 0; }

  .se-tl-item {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.65rem 0 0.65rem 0.9rem;
    border-left: 3px solid var(--line);
    max-width: none;
  }

  .se-tl-item p { margin: 0; }
  .se-tl-when { display: flex; flex-direction: column; }
  .se-tl-window { font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 600; font-size: 0.92rem; }
  .se-tl-owner { font-size: 0.76rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .se-risk-high { border-left-color: #c8532b; }
  .se-risk-med { border-left-color: #d8a13a; }

  /* ---------- shared bits ---------- */
  .se-objective { border-left: 3px solid var(--accent); background: var(--accent-soft); padding: 0.7rem 0.95rem; border-radius: 0 10px 10px 0; }
  .se-covers { list-style: none; padding-left: 0; }
  .se-covers li { margin-bottom: 0.4rem; line-height: 1.55; }

  .se-req {
    display: inline-block;
    min-width: 2.2rem;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    margin-right: 0.4rem;
    border-radius: 5px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    border: 1px solid var(--line);
  }

  .se-risk { border-left: 3px solid #c8532b; padding: 0.6rem 0.9rem; border-radius: 0 10px 10px 0; background: rgba(200, 83, 43, 0.07); font-size: 0.93rem; }
  .se-note { border-left: 3px solid var(--accent); background: var(--accent-soft); padding: 0.65rem 0.95rem; border-radius: 0 10px 10px 0; font-size: 0.93rem; }
  .se-gotcha { font-size: 0.9rem; color: var(--muted); border-top: 1px dashed var(--line); padding-top: 0.6rem; margin-bottom: 0; }

  /* Printable handouts. */
  .se-handouts { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 0.8rem; margin: 1rem 0; }

  .se-handout {
    border: 1px solid var(--line); border-radius: 12px;
    padding: 0.8rem 1rem 0.9rem; background: var(--surface);
    display: flex; flex-direction: column; gap: 0.4rem;
  }

  .se-handout-top { display: flex; gap: 0.6rem; align-items: baseline; justify-content: space-between; }
  .se-handout h3 { margin: 0; font-size: 1rem; }
  .se-handout p { margin: 0; font-size: 0.86rem; line-height: 1.55; }
  .se-handout p:last-child { margin-top: auto; padding-top: 0.4rem; }

  .se-handout-when {
    flex: none; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em;
    font-weight: 700; color: var(--muted); white-space: nowrap;
  }

  /* Digital Resource Guide link table. */
  .se-drg { display: grid; gap: 0.35rem; margin: 0.9rem 0 0; }

  .se-drg-row {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: 0.7rem;
    align-items: baseline;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    background: var(--bg-alt);
    border-left: 3px solid var(--line);
    font-size: 0.92rem;
  }

  .se-drg-req {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-weight: 700;
    font-size: 0.78rem;
    color: var(--accent-strong);
  }

  .se-drg-subs { display: inline-flex; flex-wrap: wrap; gap: 0.3rem; margin-left: 0.5rem; }

  .se-drg-subs a {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.72rem;
    padding: 0.05rem 0.4rem;
    border-radius: 5px;
    border: 1px solid var(--line);
    text-decoration: none;
  }

  /* Pioneer bench. Two columns of name + one line of why they matter. */
  .se-pioneers {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 0.5rem;
  }

  .se-pioneer {
    display: grid;
    gap: 0.15rem;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    background: var(--bg-alt);
    border-left: 3px solid var(--accent);
  }

  .se-pioneer-name { font-weight: 700; font-size: 0.93rem; }
  .se-pioneer-did { font-size: 0.84rem; line-height: 1.5; color: var(--muted); }

  .se-verdict {
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    padding: 0.7rem 1rem;
    border-radius: 0 10px 10px 0;
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 78ch;
  }

  .se-twocol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 0.9rem;
    margin: 1.1rem 0;
  }

  .se-col-good, .se-col-bad {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem 1rem 0.9rem;
    background: var(--surface);
  }

  .se-col-good { border-left: 3px solid #3d8b58; }
  .se-col-bad { border-left: 3px solid #c8532b; }
  .se-col-good h3, .se-col-bad h3 { margin: 0 0 0.5rem; font-size: 0.98rem; }

  /* A scoped-out track. Deliberately loud: the whole point is that a counselor
     skimming the page does not start building something we cut. */
  .se-deferred {
    border: 2px solid #c8532b;
    border-radius: 14px;
    padding: 1rem 1.2rem;
    margin: 0 0 1.2rem;
    background: rgba(200, 83, 43, 0.06);
  }

  .se-deferred-tag {
    margin: 0 0 0.7rem;
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #c8532b;
  }

  .se-deferred-swap {
    margin: 0.9rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--line);
    font-size: 0.93rem;
    line-height: 1.65;
  }

  /* Advancement-policy warnings. Amber, not accent — a counselor should read
     these differently from a teaching note. */
  .se-policy {
    border-left: 3px solid #d8a13a;
    background: rgba(216, 161, 58, 0.09);
    padding: 0.7rem 1rem;
    border-radius: 0 10px 10px 0;
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 78ch;
  }

  .se-callout { border: 2px solid #c8532b; border-radius: 14px; padding: 1rem 1.2rem; margin: 1.2rem 0 1.6rem; background: rgba(200, 83, 43, 0.06); }
  .se-callout h3 { margin-top: 0; }
  .se-callout p:last-child { margin-bottom: 0; }

  .se-callout-line { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0 0 0.8rem; }

  .se-pill { display: inline-block; font-size: 0.76rem; padding: 0.18rem 0.65rem; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
  .se-pill-warn { border-color: #c8532b; color: #c8532b; }
  .se-pill-strong { border-color: var(--accent); color: var(--accent-strong); font-weight: 600; }

  .se-tagline { font-size: 1.12rem; font-weight: 600; color: var(--accent-strong); }

  .se-gate-n {
    flex: none; width: 1.7rem; height: 1.7rem;
    display: inline-grid; place-items: center;
    border-radius: 999px; background: var(--accent-soft); color: var(--accent-strong);
    font-size: 0.85rem; font-weight: 700; margin-right: 0.4rem;
  }

  .se-speaker-rank {
    flex: none; width: 1.8rem; height: 1.8rem;
    display: grid; place-items: center;
    border-radius: 999px; border: 1px solid var(--accent);
    color: var(--accent-strong); font-weight: 700; font-size: 0.85rem;
  }

  .se-speaker-org { margin: 0 0 0.7rem; font-size: 0.86rem; color: var(--muted); }
  .se-speaker-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.7rem; margin: 0.8rem 0; }
  .se-speaker-meta dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); }
  .se-speaker-meta dd { margin: 0.15rem 0 0; font-size: 0.9rem; line-height: 1.5; }

  /* ---------- tables ---------- */
  .mb-table-wrap { width: 100%; overflow-x: auto; margin: 0.7rem 0 1.1rem; }
  .se-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .se-table th, .se-table td { text-align: left; vertical-align: top; padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--line); line-height: 1.5; }
  .se-table thead th { font-family: "Space Grotesk", system-ui, sans-serif; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .se-table tfoot td { font-weight: 700; border-bottom: none; border-top: 2px solid var(--line); }
  .se-time { font-family: ui-monospace, monospace; font-size: 0.85rem; white-space: nowrap; }
  .se-who { color: var(--muted); font-size: 0.85rem; }
  .se-price { font-family: ui-monospace, monospace; font-size: 0.86rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .se-table-narrow { max-width: 46rem; }
  .se-row-hit td { background: var(--accent-soft); }
  .se-buycell { white-space: nowrap; font-size: 0.82rem; }
  .se-buycell a { display: block; }
  .se-order-notes { color: var(--muted); }

  /* ---------- fixes ---------- */
  .se-fixes { list-style: none; padding-left: 0; }
  .se-fix { border-left: 3px solid var(--line); padding: 0.5rem 0 0.5rem 0.9rem; margin-bottom: 0.9rem; }
  .se-fix p { margin: 0.2rem 0 0; font-size: 0.92rem; color: var(--muted); line-height: 1.55; }
  .se-fix-fixed { border-left-color: #3d8b58; }
  .se-fix-verified { border-left-color: var(--accent); }
  .se-fix-noted { border-left-color: #d8a13a; }

  .se-fix-tag {
    display: inline-block; font-size: 0.66rem; letter-spacing: 0.09em; text-transform: uppercase;
    padding: 0.08rem 0.42rem; border-radius: 4px; border: 1px solid var(--line);
    color: var(--muted); margin-right: 0.5rem;
  }

  @media (max-width: 860px) {
    .se-two { grid-template-columns: 1fr; }
    .se-tl-item { grid-template-columns: 1fr; gap: 0.2rem; }
    .se-switch { grid-template-columns: 1fr; }
    .se-hero { flex-direction: column; gap: 0.5rem; }
    .se-exp-when { margin-left: 0; width: 100%; }
