  .se-callout p:last-child { margin-bottom: 0; }

  .se-callout-line { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0 0 0.8rem; }

  .se-pill { display: inline-block; font-size: 0.76rem; padding: 0.18rem 0.65rem; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
  .se-pill-warn { border-color: #c8532b; color: #c8532b; }
  .se-pill-strong { border-color: var(--accent); color: var(--accent-strong); font-weight: 600; }

  .se-tagline { font-size: 1.12rem; font-weight: 600; color: var(--accent-strong); }

  .se-gate-n {
    flex: none; width: 1.7rem; height: 1.7rem;
    display: inline-grid; place-items: center;
    border-radius: 999px; background: var(--accent-soft); color: var(--accent-strong);
    font-size: 0.85rem; font-weight: 700; margin-right: 0.4rem;
  }

  .se-speaker-rank {
    flex: none; width: 1.8rem; height: 1.8rem;
    display: grid; place-items: center;
    border-radius: 999px; border: 1px solid var(--accent);
    color: var(--accent-strong); font-weight: 700; font-size: 0.85rem;
  }

  .se-speaker-org { margin: 0 0 0.7rem; font-size: 0.86rem; color: var(--muted); }
  .se-speaker-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.7rem; margin: 0.8rem 0; }
  .se-speaker-meta dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); }
  .se-speaker-meta dd { margin: 0.15rem 0 0; font-size: 0.9rem; line-height: 1.5; }

  /* ---------- tables ---------- */
  .mb-table-wrap { width: 100%; overflow-x: auto; margin: 0.7rem 0 1.1rem; }
  .se-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .se-table th, .se-table td { text-align: left; vertical-align: top; padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--line); line-height: 1.5; }
  .se-table thead th { font-family: "Space Grotesk", system-ui, sans-serif; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .se-table tfoot td { font-weight: 700; border-bottom: none; border-top: 2px solid var(--line); }
  .se-time { font-family: ui-monospace, monospace; font-size: 0.85rem; white-space: nowrap; }
  .se-who { color: var(--muted); font-size: 0.85rem; }
  .se-price { font-family: ui-monospace, monospace; font-size: 0.86rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .se-table-narrow { max-width: 46rem; }
  .se-row-hit td { background: var(--accent-soft); }
  .se-buycell { white-space: nowrap; font-size: 0.82rem; }
  .se-buycell a { display: block; }
  .se-order-notes { color: var(--muted); }

  /* ---------- fixes ---------- */
  .se-fixes { list-style: none; padding-left: 0; }
  .se-fix { border-left: 3px solid var(--line); padding: 0.5rem 0 0.5rem 0.9rem; margin-bottom: 0.9rem; }
  .se-fix p { margin: 0.2rem 0 0; font-size: 0.92rem; color: var(--muted); line-height: 1.55; }
  .se-fix-fixed { border-left-color: #3d8b58; }
  .se-fix-verified { border-left-color: var(--accent); }
  .se-fix-noted { border-left-color: #d8a13a; }

  .se-fix-tag {
    display: inline-block; font-size: 0.66rem; letter-spacing: 0.09em; text-transform: uppercase;
    padding: 0.08rem 0.42rem; border-radius: 4px; border: 1px solid var(--line);
    color: var(--muted); margin-right: 0.5rem;
  }

  @media (max-width: 860px) {
    .se-two { grid-template-columns: 1fr; }
    .se-tl-item { grid-template-columns: 1fr; gap: 0.2rem; }
    .se-switch { grid-template-columns: 1fr; }
    .se-hero { flex-direction: column; gap: 0.5rem; }
    .se-exp-when { margin-left: 0; width: 100%; }
  }
</style>

<script is:inline>
  (function () {
    function init() {
      var sw = document.querySelector("[data-audience-switch]");
      if (!sw || sw.dataset.wired) return;
      sw.dataset.wired = "1";

      var btns = sw.querySelectorAll("[data-view]");
      var panels = document.querySelectorAll("[data-view-panel]");

      function show(view) {
        for (var i = 0; i < btns.length; i++) {
          var on = btns[i].dataset.view === view;
          btns[i].classList.toggle("is-on", on);
          btns[i].setAttribute("aria-selected", String(on));
        }
        for (var j = 0; j < panels.length; j++) {
          panels[j].hidden = panels[j].dataset.viewPanel !== view;
        }
        try { localStorage.setItem("se-view", view); } catch (e) {}
      }

      for (var k = 0; k < btns.length; k++) {
        (function (b) {
          b.addEventListener("click", function () { show(b.dataset.view); });
        })(btns[k]);
      }

      var saved = null;
      try { saved = localStorage.getItem("se-view"); } catch (e) {}
      if (location.hash === "#counselor") saved = "counselor";
      if (location.hash === "#scout") saved = "scout";
      show(saved === "counselor" ? "counselor" : "scout");
    }

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
