  @media(max-width:700px){
    .se-page :global(.cal-grid){position:relative}
    .se-page :global(.cal-has){position:static}
    .se-page :global(.cal-tip){left:0;right:0;transform:none;white-space:normal}
    :global(body:has(.se-page) .nav-wrap){display:grid;grid-template-columns:1fr auto;gap:9px;padding-block:10px;min-height:0}
    :global(body:has(.se-page) .nav-wrap nav){grid-column:1/-1;grid-row:2;overflow-x:auto;padding-bottom:3px}
    :global(body:has(.se-page) .nav-list){flex-wrap:nowrap;gap:17px;width:max-content}
    :global(body:has(.se-page) .nav-list a){font-size:12px}
    :global(body:has(.se-page) .theme-toggle){grid-column:2;grid-row:1;padding:5px 10px;font-size:11px}
    :global(body:has(.se-page) .site-title){font-size:15px}
  }
</style>

<script is:inline>
  (function () {
    function init() {
      var sw = document.querySelector("[data-audience-switch]");
      if (!sw || sw.dataset.wired) return;
      sw.dataset.wired = "1";

      var btns = sw.querySelectorAll("[data-view]");
      var panels = document.querySelectorAll("[data-view-panel]");

      function show(view) {
        for (var i = 0; i < btns.length; i++) {
          var on = btns[i].dataset.view === view;
          btns[i].classList.toggle("is-on", on);
          btns[i].setAttribute("aria-selected", String(on));
          btns[i].tabIndex = on ? 0 : -1;
        }
        for (var j = 0; j < panels.length; j++) {
          panels[j].hidden = panels[j].dataset.viewPanel !== view;
        }
        try { localStorage.setItem("se-view", view); } catch (e) {}
      }

      for (var k = 0; k < btns.length; k++) {
        (function (b) {
          b.addEventListener("click", function () {
            show(b.dataset.view);
            try { history.replaceState(null, "", "#" + b.dataset.view); } catch(e) {}
          });
          b.addEventListener("keydown", function(e) {
            if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(e.key)) return;
            e.preventDefault();
            var index = e.key === "Home" ? 0 : e.key === "End" ? btns.length - 1 : (Array.from(btns).indexOf(b) + 1) % btns.length;
            btns[index].click(); btns[index].focus();
          });
        })(btns[k]);
      }

      // The counselor view links across to the fillable checklist, which only
      // exists once — in the Scout panel. Switch views, then scroll to it.
      var jump = document.querySelector("[data-goto-scout-checklist]");
      if (jump) {
        jump.addEventListener("click", function (e) {
          e.preventDefault();
          show("scout");
          var target = document.querySelector("[data-sck]");
          if (target) reveal(target);
        });
      }

      // ---------------------------------------------------------------
      // Deep links.
      //
      // A deck lives two levels down: inside the counselor panel (which is
      // [hidden] by default) and inside a collapsed <details>. A plain
      // "#deck-how-rockets-work" anchor therefore lands on nothing — the
      // browser cannot scroll to an element with no layout. So we open the
      // panel and the <details> first, then scroll.
      //
      //   #deck-how-rockets-work     open the deck and scroll to it
      //   #present-how-rockets-work  ...and start presenting immediately
      //   #meeting-2                 open that meeting's run-of-show
      //   #counselor / #scout        just pick a view
      // ---------------------------------------------------------------
      function reveal(el) {
        if (!el) return;
        var ownDetails = el.querySelector(":scope > details.se-section");
        if (ownDetails) ownDetails.open = true;
        var panel = el.closest("[data-view-panel]");
        if (panel) show(panel.dataset.viewPanel);
        var d = el.closest("details");
        while (d) { d.open = true; d = d.parentElement && d.parentElement.closest("details"); }
        // Wait a frame so the newly shown panel has layout to scroll within.
        requestAnimationFrame(function () {
          el.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }

      function route(hash) {
        if (!hash) return false;
        var h = hash.replace(/^#/, "");

        if (h === "counselor" || h === "scout") { show(h); return true; }

        var present = h.indexOf("present-") === 0;
        if (present) {
          var lesson = h.slice("present-".length);
          if (["why-we-go", "how-rockets-work", "missions", "build-night", "mission-control", "debrief", "rocket-math"].includes(lesson)) {
            location.assign("/scouts/space-lessons/" + lesson + "/"); return true;
          }
        }
        var id = present ? "deck-" + h.slice("present-".length) : h;
        var el = document.getElementById(id);
        if (!el) return false;

        reveal(el);
        if (present) {
          var btn = el.querySelector("[data-deck-full]");
          // Let the reveal settle first, or the deck measures itself while
          // its panel is still hidden and every slide comes out mis-sized.
          if (btn) setTimeout(function () { btn.click(); }, 250);
        }
        return true;
      }

      // Reopening the same anchor should work even if its accordion was closed.
      document.querySelectorAll('.se-page a[href^="#"]').forEach(function(a) {
        a.addEventListener('click', function(e) {
          var hash=a.getAttribute('href');
          if (hash.length > 1 && route(hash)) {
            e.preventDefault();
            try { history.pushState(null, '', hash); } catch(e) {}
          }
        });
      });

      var saved = null;
      try { saved = localStorage.getItem("se-view"); } catch (e) {}
      show(saved === "counselor" ? "counselor" : "scout");
      route(location.hash);
      window.addEventListener("hashchange", function () { route(location.hash); });
    }

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
