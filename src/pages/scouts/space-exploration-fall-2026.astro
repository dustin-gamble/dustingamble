---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpaceCourseGateway from "../../components/SpaceCourseGateway.astro";
import SlideDeck from "../../components/SlideDeck.astro";
import SeriesCalendar from "../../components/SeriesCalendar.astro";
import FlightSim from "../../components/FlightSim.astro";
import OrbitSim from "../../components/OrbitSim.astro";
import LaunchOps from "../../components/LaunchOps.astro";
import SlideImage from "../../components/SlideImage.astro";
import CheckoutSheet from "../../components/CheckoutSheet.astro";
import SampleReturnCard from "../../components/SampleReturnCard.astro";
import BaseDesignSheet from "../../components/BaseDesignSheet.astro";
import ScoutChecklist from "../../components/ScoutChecklist.astro";
import PioneerPicker from "../../components/PioneerPicker.astro";
import CollectorCard from "../../components/CollectorCard.astro";
import {
  series,
  timeline,
  telemetryTrack,
  decks,
  meetings,
  gate,
  orders,
  competition,
  speakers,
  launchDay,
  corrections,
  calendarEvents,
  scoutGuide,
  drg,
} from "../../data/space-exploration-fall-2026.js";

const scoutOrder = orders.groups.find((g) => g.id === "scout");
const counselorOrders = orders.groups.filter((g) => g.id !== "scout");
---
<BaseLayout
  title="Space Exploration — Fall 2026 Series"
  description="Troop 308's Space Exploration merit badge series: five Monday blocks, interactive launch and orbit simulators, presenter-ready slide decks, ordering lists with buy links, a prediction competition, and a launch day before Thanksgiving."
>
  <div class="se-page">
    <nav class="se-crumbs" aria-label="Breadcrumb">
      <a href="/scouts/">Scouts</a><span aria-hidden="true">/</span><span>Space Exploration · Fall 2026</span>
    </nav>
    <SpaceCourseGateway />

    <div class="se-guide-heading" id="course-guide">
      <div><p class="se-label">YOUR COURSE GUIDE</p><h2>Find what you need.</h2></div>
      <p>Choose your view. Open a section to get started.</p>
    </div>

    <!-- ================= audience switch ================= -->
    <div class="se-switch" data-audience-switch role="tablist" aria-label="Choose your view">
      <button type="button" role="tab" class="se-switch-btn is-on" data-view="scout" id="view-scout" aria-controls="panel-scout" aria-selected="true" tabindex="0">
        <strong>Scout</strong>
        <span>My checklist, build &amp; launch day</span>
      </button>
      <button type="button" role="tab" class="se-switch-btn" data-view="counselor" id="view-counselor" aria-controls="panel-counselor" aria-selected="false" tabindex="-1">
        <strong>Counselor</strong>
        <span>Lesson plans, handouts &amp; range prep</span>
      </button>
    </div>

    <!-- ================= SCOUT VIEW ================= -->
    <div data-view-panel="scout" id="panel-scout" role="tabpanel" aria-labelledby="view-scout" class="se-view-layout">
      <aside class="se-sidebar"><nav aria-label="Scout quick navigation"><p class="se-label">QUICK NAVIGATION</p><a href="#scout-checklist">My checklist<span aria-hidden="true">↗</span></a><a href="#scout-calendar">Dates & deadlines<span aria-hidden="true">↗</span></a><a href="#scout-pioneer">Space pioneer<span aria-hidden="true">↗</span></a><a href="#scout-build">Build & practice<span aria-hidden="true">↗</span></a><a href="#scout-launch">Launch day<span aria-hidden="true">↗</span></a></nav><div class="se-sidebar-note"><span aria-hidden="true">✳</span><strong>Make space move.</strong><p>Animated experiments, ready for a room without Wi-Fi.</p><a href="/scouts/space-lessons/">Open the lessons →</a></div></aside>
<div class="se-sections"><section class="se-block" id="scout-start">
        <details class="se-section" open>
          <summary><span class="se-section-title"><h2>Your mission</h2><span>The five meetings, your own projects, and how the badge comes together.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="se-lede">{scoutGuide.theDeal}</p>
        <p class="muted">{scoutGuide.intro}</p>

<p class="se-inline-actions"><a href="#scout-checklist">Open my checklist →</a><a href="#scout-calendar">See the dates →</a></p>
</div>
        </details>
      </section>
<section class="se-block" id="scout-checklist">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Your requirement checklist</h2><span>Track all eight requirements. Save in this browser or print a copy.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          All eight requirements with a box for each one. Tick them off as you go; it saves in this browser, so
          it will still be here next Monday. Print it and bring it to meetings, or keep it on your phone
          &mdash; either way, this is the sheet I initial.
        </p>
        <ScoutChecklist />
      </div>
        </details>
      </section>
<section class="se-block" id="scout-calendar">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Dates & deadlines</h2><span>Meeting nights, launch day, and backup dates.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <SeriesCalendar events={calendarEvents} />
      </div>
        </details>
      </section>
<section class="se-block" id="scout-kit">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Your rocket kit</h2><span>What the troop provides, what to bring, and how to earn your kit.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="se-callout-line">
          <span class="se-pill se-pill-strong">{scoutGuide.buyList.total}</span>
          <span class="se-pill se-pill-warn">{scoutGuide.buyList.deadline}</span>
        </p>
        <p>{scoutGuide.buyList.why}</p>

        <div class="se-cards">
          {scoutGuide.buyList.items.map((it) => (
            <article class="se-buy">
              <div class="se-buy-top">
                <h3>{it.item}</h3>
                <span class="se-buy-price">{it.price}</span>
              </div>
              <p>{it.note}</p>
              {/* The troop buys these now, so a Scout's list has no links on it.
                  Kept conditional so the markup still works if that changes. */}
              {(it.buy || it.mfr) && (
                <p class="se-buy-links">
                  {it.buy && <a class="se-btn-buy" href={it.buy} target="_blank" rel="noopener noreferrer">Buy on Amazon ↗</a>}
                  {it.mfr && <a class="se-btn-alt" href={it.mfr} target="_blank" rel="noopener noreferrer">Estes ↗</a>}
                </p>
              )}
            </article>
          ))}
        </div>
        <p class="se-note">{scoutGuide.buyList.alsoNeed}</p>

        <details class="se-exp">
          <summary>{scoutGuide.gate.heading}</summary>
          <p>{scoutGuide.gate.intro}</p>
          <ol class="se-numbered">
            {scoutGuide.gate.items.map((g) => <li>{g}</li>)}
          </ol>
          <p class="se-note">{scoutGuide.gate.objective}</p>
        </details>
      </div>
        </details>
      </section>
<section class="se-block" id="scout-guide">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Official study guide</h2><span>Free resources from Scouting America, organized by requirement.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          Scouting America publishes a page for every single requirement on this badge. It is free, there is no
          pamphlet to buy, and it is the same text I am marking you against. If you only open one link on this
          whole page, make it this one &mdash; and if you miss a Monday, this is how you catch up.
        </p>
        <p>
          <a class="se-btn-buy" href={drg.contents} target="_blank" rel="noopener noreferrer">Open the Digital Resource Guide ↗</a>
        </p>

        <div class="se-drg">
          {drg.pages.map((pg) => (
            <div class="se-drg-row">
              <span class="se-drg-req">{pg.req}</span>
              <div>
                <a href={pg.url} target="_blank" rel="noopener noreferrer">{pg.title} ↗</a>
                {pg.subs && (
                  <span class="se-drg-subs">
                    {pg.subs.map((sub) => (
                      <a href={sub.url} target="_blank" rel="noopener noreferrer">{sub.id}</a>
                    ))}
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
        </details>
      </section>
<section class="se-block" id="scout-pioneer">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Choose your space pioneer</h2><span>Explore 26 people, choose your card, and prepare to discuss four others.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          Requirement 2 is one card about your favourite pioneer, plus talking with me about
          <strong>four others</strong>. This is the same list as the paper handout &mdash; same 26 people, same
          numbers &mdash; so you can use whichever you have to hand. Claim your card name at Meeting 1.
        </p>
        <PioneerPicker />
      </div>
        </details>
      </section>
<section class="se-block" id="scout-card">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Make your collector’s card</h2><span>The printable template for your chosen pioneer.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          Once you have picked your pioneer, this is the card you make. I hand these out on paper &mdash; this
          copy is here for when you need another one.
        </p>
        <CollectorCard />
      </div>
        </details>
      </section>
<section class="se-block" id="scout-study">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Get ready for each meeting</h2><span>Study prompts and suggested videos for every part of the course.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">{scoutGuide.study.intro}</p>
        {scoutGuide.study.blocks.map((b) => (
          <details class="se-exp">
            <summary>
              <span class="se-req">{b.req}</span> {b.title}
              <span class="se-exp-when">{b.forMeeting}</span>
            </summary>
            <p><strong>What to do:</strong> {b.doNow}</p>
            {b.videos.length > 0 && (
              <ul class="se-vids">
                {b.videos.map((v) => (
                  <li>
                    <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer">{v.t} ↗</a>
                    <span>{v.ch}</span>
                  </li>
                ))}
              </ul>
            )}
          </details>
        ))}
      </div>
        </details>
      </section>
<section class="se-block" id="scout-build">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Build your rocket</h2><span>The build lesson and help-desk details.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          Your kit arrives in the post and you build it at home. Take your time. If anything goes wrong or you
          would rather have help, bring it to the <strong>November 16</strong> meeting &mdash; there is a help desk
          open all night, spare parts, and no judgement whatsoever.
        </p>
        <p><a class="se-present-link" href="/scouts/space-lessons/build-night/">▶ Open the animated Build Night lesson</a></p><details class="se-exp"><summary>Read the slides &amp; notes</summary><SlideDeck deck={decks["build-night"]} /></details>

      </div>
        </details>
      </section>
<section class="se-block" id="scout-crew">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Find your launch-crew role</h2><span>Eight jobs, real callsigns, and a countdown to rehearse.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          Eight positions with real callsigns. You will pick yours on November 16 and practise the calls, then run
          it for real on the 21st. Have a look at what each station does &mdash; and try the countdown clock.
        </p>
        <LaunchOps />
      </div>
        </details>
      </section>
<section class="se-block" id="scout-simulators">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Try it before you fly it</h2><span>Change a motor, add payload, and test your predictions.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          The same physics you'll be predicting on launch day. Change one thing at a time and watch what happens &mdash;
          this is how you get good at the prediction contest without spending a dollar on motors.
        </p>
        <div class="se-sims">
          <FlightSim mode="launch" id="scout-launch" />
          <FlightSim mode="recovery" id="scout-recovery" />
        </div>
        <details class="se-exp">
          <summary>Going further &mdash; orbital mechanics</summary>
          <p class="muted">
            Not required for the badge, but this is the part that makes space actually strange. Orbit is not about
            going up; it is about going sideways fast enough that you keep missing the ground.
          </p>
          <div class="se-sims">
            <OrbitSim mode="ascent" id="scout-ascent" />
            <OrbitSim mode="moon" id="scout-moon" />
          </div>
        </details>
      </div>
        </details>
      </section>
<section class="se-block" id="scout-cup">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>The Prediction Cup</h2><span>How the competition works and what each award measures.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="se-tagline">{competition.tagline}</p>
        <p>{competition.why}</p>

        <div class="se-awards">
          {competition.scoring.map((s) => (
            <article class="se-award">
              <h3>{s.place}</h3>
              <p>{s.basis}</p>
              <span class="se-pill">{s.measured}</span>
            </article>
          ))}
        </div>

        <p class="se-note"><strong>The trade-off.</strong> {competition.tension}</p>

        <details class="se-exp">
          <summary>How scoring works, and how to get scratched</summary>
          <ol class="se-numbered">
            {competition.howItWorks.map((h) => <li>{h}</li>)}
          </ol>
          <h4>Penalties</h4>
          <ul>
            {competition.penalties.map((p) => <li>{p}</li>)}
          </ul>
          <p class="se-note">{competition.note}</p>
        </details>
      </div>
        </details>
      </section>
<section class="se-block" id="scout-launch">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Launch day · November 21</h2><span>What to bring, when to arrive, and how the range works.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <SlideImage name="model-liftoff" />
        <p class="se-lede">{scoutGuide.launchDay.timing}</p>
        <div class="se-two">
          <div>
            <h3>Bring</h3>
            <ul class="se-tight">
              {scoutGuide.launchDay.bring.map((b) => <li>{b}</li>)}
            </ul>
          </div>
          <div>
            <h3>Three rules that are not negotiable</h3>
            <ul class="se-tight">
              {scoutGuide.launchDay.rules.map((r) => <li>{r}</li>)}
            </ul>
          </div>
        </div>
      </div>
        </details>
      </section></div></div>
    <!-- ================= COUNSELOR VIEW ================= -->
    <div data-view-panel="counselor" id="panel-counselor" role="tabpanel" aria-labelledby="view-counselor" class="se-view-layout" hidden>
      <aside class="se-sidebar"><nav aria-label="Counselor quick navigation"><p class="se-label">QUICK NAVIGATION</p><a href="#meeting-plans">Meeting plans<span aria-hidden="true">↗</span></a><a href="#handouts">Print handouts<span aria-hidden="true">↗</span></a><a href="#sample-return">Monday’s worksheets<span aria-hidden="true">↗</span></a><a href="#checkout">Individual checkouts<span aria-hidden="true">↗</span></a><a href="#orders">Gear & ordering<span aria-hidden="true">↗</span></a><a href="#counselor-launch">Launch-day operations<span aria-hidden="true">↗</span></a></nav><div class="se-sidebar-note"><span aria-hidden="true">✳</span><strong>Make space move.</strong><p>Animated experiments, ready for a room without Wi-Fi.</p><a href="/scouts/space-lessons/">Open the lessons →</a></div></aside>
<div class="se-sections"><section class="se-block" id="meeting-plans">
        <details class="se-section" open>
          <summary><span class="se-section-title"><h2>The five meeting plans</h2><span>Run-of-shows, animated presentations, materials, and counselor notes.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          Each block is 45 minutes, 0:30&ndash;1:15, slotted into the existing troop meeting so the opening and
          closing stay where they are. Open the meeting you’re running for its plan and presentation.
        </p>

        {meetings.map((m) => (
          <details class="se-meeting" id={`meeting-${m.n}`}>
            <summary>
              <span class="se-meeting-n">{m.n}</span>
              <span class="se-meeting-title">
                <strong>{m.title}</strong>
                <span>{m.dateLabel} · {m.block}</span>
              </span>
            </summary>

            <p class="se-objective"><strong>Objective.</strong> {m.objective}</p>

            <h4>Requirements covered</h4>
            <ul class="se-covers">
              {m.covers.map((c) => (
                <li><span class="se-req">{c.id}</span> {c.how}</li>
              ))}
            </ul>

            <h4>Run of show</h4>
            <div class="mb-table-wrap">
              <table class="se-table">
                <thead>
                  <tr><th scope="col">Time</th><th scope="col">What happens</th><th scope="col">Who</th></tr>
                </thead>
                <tbody>
                  {m.runOfShow.map((row) => (
                    <tr>
                      <td class="se-time">{row[0]}</td>
                      <td>{row[1]}</td>
                      <td class="se-who">{row[2]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {m.altRunOfShow && (
              <details class="se-exp">
                <summary>{m.altRunOfShow.title}</summary>
                <p class="muted">{m.altRunOfShow.intro}</p>
                <div class="mb-table-wrap">
                  <table class="se-table">
                    <thead>
                      <tr><th scope="col">Time</th><th scope="col">What happens</th><th scope="col">Who</th></tr>
                    </thead>
                    <tbody>
                      {m.altRunOfShow.rows.map((row) => (
                        <tr>
                          <td class="se-time">{row[0]}</td>
                          <td>{row[1]}</td>
                          <td class="se-who">{row[2]}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            )}

            <p><a class="se-present-link" href={`/scouts/space-lessons/${m.deck}/`}>▶ Open animated presentation</a></p>
            <details class="se-exp"><summary>Preview slides &amp; counselor notes</summary><SlideDeck deck={decks[m.deck]} /></details>

            <div class="se-two">
              <div>
                <h4>Bring</h4>
                <ul class="se-tight">
                  {m.materials.map((x) => <li>{x}</li>)}
                </ul>
              </div>
              <div>
                <h4>Scouts leave with</h4>
                <ul class="se-tight">
                  {m.homework.map((x) => <li>{x}</li>)}
                </ul>
              </div>
            </div>

            <p class="se-risk"><strong>Where this night fails.</strong> {m.risk}</p>
          </details>
        ))}
      </div>
        </details>
      </section>
<section class="se-block" id="handouts">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Print-ready handouts</h2><span>Scout checklists, pioneer cards, and your master tracker.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">
<p class="se-inline-actions"><a href="#sample-return">Sample-return worksheet →</a><a href="#base-design">Base-design worksheet →</a></p>


        <p class="muted">
          Everything that goes out on paper, in one place. The first two are per-Scout; the tracker is yours.
        </p>
        <div class="se-handouts">
          {[
            { t: "Individual Scout checklist", w: "One per Scout · 3 pages",
              d: "All eight requirements with a tick box and an initials/date line for each. This is the Scout's record and your audit trail.",
              f: "/handouts/space-exploration-scout-checklist.pdf" },
            { t: "Pick Your Space Pioneer", w: "One per Scout · 2 pages",
              d: "26 pioneers with a one-line story and a card angle each, grouped by category, with MY CARD and DISCUSS boxes. Hand it out at Meeting 1 with the sign-up clipboard.",
              f: "/handouts/space-exploration-pick-your-pioneer.pdf" },
            { t: "Collector's card template", w: "One per Scout · 1 page",
              d: "Requirement 2's card, front and back, with cut lines. Front is a blank picture box; the back carries the information and the four other pioneers. Letter size.",
              f: "/handouts/space-exploration-collector-card-template.pdf" },
            { t: "Counselor / group master tracker", w: "Yours · 10 Scouts",
              d: "One row per Scout, one column per requirement. This is the sheet the checkout prompts below feed into.",
              f: "/handouts/space-exploration-counselor-tracker.pdf" },
          ].map((h) => (
            <article class="se-handout">
              <div class="se-handout-top">
                <h3>{h.t}</h3>
                <span class="se-handout-when">{h.w}</span>
              </div>
              <p>{h.d}</p>
              <p><a class="se-btn-buy" href={h.f} download>Download PDF ↓</a></p>
            </article>
          ))}
        </div>
        <p class="se-note">
          The pioneer list and the collector's-card template are also on the Scout side as fillable versions
          that save in the browser &mdash; same 26 people, same numbering as the paper.
        </p>
      </div>
        </details>
      </section>
<section class="se-block" id="sample-return">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Sample-return worksheet</h2><span>Requirement 5c · one robotic round trip, one card per Scout.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          Print one per Scout for October 26. Requirement 5c is a robotic round trip and it is <strong>not</strong>
          the inhabited base &mdash; the base is requirement 7. Keeping them separate is what makes both of them
          hold up, and this card is the individual evidence for 5c.
        </p>
        <SampleReturnCard />
      </div>
        </details>
      </section>
<section class="se-block" id="base-design">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Base-design worksheet</h2><span>Requirement 7 · individual drawings and four base systems.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          The patrol charrette stays exactly as it is &mdash; arguing about a base is how the good ideas turn up.
          But requirement 7 asks each Scout for drawings of <em>their</em> base, so each Scout gets their own sheet
          and owns one of the four subsystems out loud during the pitch.
        </p>
        <BaseDesignSheet />
      </div>
        </details>
      </section>
<section class="se-block" id="checkout">
        <details class="se-section">
          <summary><span class="se-section-title"><h2>Individual checkouts</h2><span>The prompts and record for signing off one Scout at a time.</span></span><span class="se-section-toggle" aria-hidden="true"></span></summary>
          <div class="se-section-body">

        <p class="muted">
          The single biggest way a group merit badge goes wrong is that the room did the requirement and nobody
          checked who actually did it. This is the sheet that prevents that.
        </p>
        <CheckoutSheet />
      </div>
        </details>
