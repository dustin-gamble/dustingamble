---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SlideDeck from "../../components/SlideDeck.astro";
import SeriesCalendar from "../../components/SeriesCalendar.astro";
import FlightSim from "../../components/FlightSim.astro";
import OrbitSim from "../../components/OrbitSim.astro";
import LaunchOps from "../../components/LaunchOps.astro";
import SlideImage from "../../components/SlideImage.astro";
import CheckoutSheet from "../../components/CheckoutSheet.astro";
import SampleReturnCard from "../../components/SampleReturnCard.astro";
import BaseDesignSheet from "../../components/BaseDesignSheet.astro";
import {
  series,
  timeline,
  telemetryTrack,
  decks,
  meetings,
  gate,
  orders,
  competition,
  speakers,
  launchDay,
  corrections,
  calendarEvents,
  scoutGuide,
  drg,
} from "../../data/space-exploration-fall-2026.js";

const scoutOrder = orders.groups.find((g) => g.id === "scout");
const counselorOrders = orders.groups.filter((g) => g.id !== "scout");
---
<BaseLayout
  title="Space Exploration — Fall 2026 Series"
  description="Troop 308's Space Exploration merit badge series: five Monday blocks, interactive launch and orbit simulators, presenter-ready slide decks, ordering lists with buy links, a prediction competition, and a launch day before Thanksgiving."
>
  <div class="se-page">
    <p class="se-crumbs">
      <a href="/scouts/">&larr; Back to Scouts</a> ·
      <a href="/merit-badges/space-exploration/">Space Exploration badge page</a> ·
      <a href="/merit-badges/capstones/telemetry-rocket/">Telemetry Rocket capstone</a> ·
      <a href="/scouts/telemetry/">Ground station</a> ·
      <a href="/scouts/space-exploration-cards/">Teaching cards</a>
    </p>

    <header class="se-hero">
      <span class="se-hero-icon" aria-hidden="true">🚀</span>
      <div>
        <p class="kicker">{series.kicker}</p>
        <h1>{series.title}</h1>
        <p class="se-hero-sum">{series.summary}</p>
        <ul class="tag-list" aria-label="Series facts">
          {series.counselorFacts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </header>

    <!-- ================= audience switch ================= -->
    <div class="se-switch" data-audience-switch role="tablist" aria-label="Choose your view">
      <button type="button" role="tab" class="se-switch-btn is-on" data-view="scout" aria-selected="true">
        <strong>Scout</strong>
        <span>What to do, study, and buy</span>
      </button>
      <button type="button" role="tab" class="se-switch-btn" data-view="counselor" aria-selected="false">
        <strong>Merit Badge Counselor</strong>
        <span>Run-of-shows, decks, gear, logistics</span>
      </button>
    </div>

    <!-- ================= SCOUT VIEW ================= -->
    <div data-view-panel="scout">
      <section class="se-block">
        <h2>The deal</h2>
        <p class="se-lede">{scoutGuide.theDeal}</p>
        <p class="muted">{scoutGuide.intro}</p>
      </section>

      <section class="se-block">
        <h2>Every date, in one place</h2>
        <SeriesCalendar events={calendarEvents} />
      </section>

      <section class="se-block">
        <h2>{scoutGuide.buyList.heading}</h2>
        <p class="se-callout-line">
          <span class="se-pill se-pill-strong">{scoutGuide.buyList.total}</span>
          <span class="se-pill se-pill-warn">{scoutGuide.buyList.deadline}</span>
        </p>
        <p>{scoutGuide.buyList.why}</p>

        <div class="se-cards">
          {scoutGuide.buyList.items.map((it) => (
            <article class="se-buy">
              <div class="se-buy-top">
                <h3>{it.item}</h3>
                <span class="se-buy-price">{it.price}</span>
              </div>
              <p>{it.note}</p>
              {/* The troop buys these now, so a Scout's list has no links on it.
                  Kept conditional so the markup still works if that changes. */}
              {(it.buy || it.mfr) && (
                <p class="se-buy-links">
                  {it.buy && <a class="se-btn-buy" href={it.buy} target="_blank" rel="noopener noreferrer">Buy on Amazon ↗</a>}
                  {it.mfr && <a class="se-btn-alt" href={it.mfr} target="_blank" rel="noopener noreferrer">Estes ↗</a>}
                </p>
              )}
            </article>
          ))}
        </div>
        <p class="se-note">{scoutGuide.buyList.alsoNeed}</p>

        <details class="se-exp">
          <summary>{scoutGuide.gate.heading}</summary>
          <p>{scoutGuide.gate.intro}</p>
          <ol class="se-numbered">
            {scoutGuide.gate.items.map((g) => <li>{g}</li>)}
          </ol>
          <p class="se-note">{scoutGuide.gate.objective}</p>
        </details>
      </section>

      <section class="se-block">
        <h2>The official guide — read it on your phone, it's free</h2>
        <p class="muted">
          Scouting America publishes a page for every single requirement on this badge. It is free, there is no
          pamphlet to buy, and it is the same text I am marking you against. If you only open one link on this
          whole page, make it this one &mdash; and if you miss a Monday, this is how you catch up.
        </p>
        <p>
          <a class="se-btn-buy" href={drg.contents} target="_blank" rel="noopener noreferrer">Open the Digital Resource Guide ↗</a>
        </p>

        <div class="se-drg">
          {drg.pages.map((pg) => (
            <div class="se-drg-row">
              <span class="se-drg-req">{pg.req}</span>
              <div>
                <a href={pg.url} target="_blank" rel="noopener noreferrer">{pg.title} ↗</a>
                {pg.subs && (
                  <span class="se-drg-subs">
                    {pg.subs.map((sub) => (
                      <a href={sub.url} target="_blank" rel="noopener noreferrer">{sub.id}</a>
                    ))}
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="se-block">
        <h2>Pick your space pioneer</h2>
        <p class="muted">
          Requirement 2 is one card about your favourite pioneer &mdash; and then talking with me about
          <strong> four others</strong>. Claim a name at Meeting 1, no duplicates. Every name here has a link
          straight to a real biography, so &ldquo;I don't know who to pick&rdquo; is not a reason to be stuck.
        </p>
        <p class="se-note">
          A pioneer is anyone who did something first or made a first possible. Mathematicians, engineers,
          programmers and writers count every bit as much as the people who flew.
        </p>

        <ul class="se-pioneers">
          {drg.pioneers.map((pi) => (
            <li class="se-pioneer">
              <span class="se-pioneer-name">
                {pi.url
                  ? <a href={pi.url} target="_blank" rel="noopener noreferrer">{pi.name} ↗</a>
                  : pi.name}
              </span>
              <span class="se-pioneer-did">{pi.did}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="se-block">
        <h2>{scoutGuide.study.heading}</h2>
        <p class="muted">{scoutGuide.study.intro}</p>
        {scoutGuide.study.blocks.map((b) => (
          <details class="se-exp">
            <summary>
              <span class="se-req">{b.req}</span> {b.title}
              <span class="se-exp-when">{b.forMeeting}</span>
            </summary>
            <p><strong>What to do:</strong> {b.doNow}</p>
            {b.videos.length > 0 && (
              <ul class="se-vids">
                {b.videos.map((v) => (
                  <li>
                    <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer">{v.t} ↗</a>
                    <span>{v.ch}</span>
                  </li>
                ))}
              </ul>
            )}
          </details>
        ))}
      </section>

      <section class="se-block">
        <h2>Building it — at home, at your own pace</h2>
        <p class="muted">
          Your kit arrives in the post and you build it at home. Take your time. If anything goes wrong or you
          would rather have help, bring it to the <strong>November 16</strong> meeting &mdash; there is a help desk
          open all night, spare parts, and no judgement whatsoever.
        </p>
        <SlideDeck deck={decks["build-night"]} />
      </section>

      <section class="se-block">
        <h2>Launch day is a real range, and you have a job on it</h2>
        <p class="muted">
          Eight positions with real callsigns. You will pick yours on November 16 and practise the calls, then run
          it for real on the 21st. Have a look at what each station does &mdash; and try the countdown clock.
        </p>
        <LaunchOps />
      </section>

      <section class="se-block">
        <h2>Try it before you fly it</h2>
        <p class="muted">
          The same physics you'll be predicting on launch day. Change one thing at a time and watch what happens &mdash;
          this is how you get good at the prediction contest without spending a dollar on motors.
        </p>
        <div class="se-sims">
          <FlightSim mode="launch" id="scout-launch" />
          <FlightSim mode="recovery" id="scout-recovery" />
        </div>
        <details class="se-exp">
          <summary>Going further &mdash; orbital mechanics</summary>
          <p class="muted">
            Not required for the badge, but this is the part that makes space actually strange. Orbit is not about
            going up; it is about going sideways fast enough that you keep missing the ground.
          </p>
          <div class="se-sims">
            <OrbitSim mode="ascent" id="scout-ascent" />
            <OrbitSim mode="moon" id="scout-moon" />
          </div>
        </details>
      </section>

      <section class="se-block">
        <h2>{competition.name}</h2>
        <p class="se-tagline">{competition.tagline}</p>
        <p>{competition.why}</p>

        <div class="se-awards">
          {competition.scoring.map((s) => (
            <article class="se-award">
              <h3>{s.place}</h3>
              <p>{s.basis}</p>
              <span class="se-pill">{s.measured}</span>
            </article>
          ))}
        </div>

        <p class="se-note"><strong>The trade-off.</strong> {competition.tension}</p>

        <details class="se-exp">
          <summary>How scoring works, and how to get scratched</summary>
          <ol class="se-numbered">
            {competition.howItWorks.map((h) => <li>{h}</li>)}
          </ol>
          <h4>Penalties</h4>
          <ul>
            {competition.penalties.map((p) => <li>{p}</li>)}
          </ul>
          <p class="se-note">{competition.note}</p>
        </details>
      </section>

      <section class="se-block">
        <h2>{scoutGuide.launchDay.heading}</h2>
        <SlideImage name="model-liftoff" />
        <p class="se-lede">{scoutGuide.launchDay.timing}</p>
        <div class="se-two">
          <div>
            <h3>Bring</h3>
            <ul class="se-tight">
              {scoutGuide.launchDay.bring.map((b) => <li>{b}</li>)}
            </ul>
          </div>
          <div>
            <h3>Three rules that are not negotiable</h3>
            <ul class="se-tight">
              {scoutGuide.launchDay.rules.map((r) => <li>{r}</li>)}
            </ul>
          </div>
        </div>
      </section>
    </div>

    <!-- ================= COUNSELOR VIEW ================= -->
    <div data-view-panel="counselor" hidden>
      <section class="se-block">
        <h2>How this is scoped</h2>
        <ul>
          {series.groundRules.map((r) => <li>{r}</li>)}
        </ul>
        <p class="se-note"><strong>On the troop calendar.</strong> {series.calendarNote}</p>
      </section>

      <section class="se-block">
        <h2>Critical path</h2>
        <p class="muted">
          Two things drive this schedule and neither is the teaching: parts have to ship, and a launch site has to
          say yes. Everything flagged red has to happen in August.
        </p>
        <ol class="se-timeline">
          {timeline.map((t) => (
            <li class={`se-tl-item se-risk-${t.risk}`}>
              <div class="se-tl-when">
                <span class="se-tl-window">{t.window}</span>
                <span class="se-tl-owner">{t.owner}</span>
              </div>
              <p>{t.what}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="se-block">
        <h2>Season calendar</h2>
        <SeriesCalendar events={calendarEvents} />
      </section>

      <section class="se-block">
        <h2>The five Monday nights</h2>
        <p class="muted">
          Each block is 45 minutes, 0:30&ndash;1:15, slotted into the existing troop meeting so the opening and
          closing stay where they are. Every night is collapsed &mdash; open the one you're running this week.
        </p>

        {meetings.map((m) => (
          <details class="se-meeting" id={`meeting-${m.n}`}>
            <summary>
              <span class="se-meeting-n">{m.n}</span>
              <span class="se-meeting-title">
                <strong>{m.title}</strong>
                <span>{m.dateLabel} · {m.block}</span>
              </span>
            </summary>

            <p class="se-objective"><strong>Objective.</strong> {m.objective}</p>

            <h4>Requirements covered</h4>
            <ul class="se-covers">
              {m.covers.map((c) => (
                <li><span class="se-req">{c.id}</span> {c.how}</li>
              ))}
            </ul>

            <h4>Run of show</h4>
            <div class="mb-table-wrap">
              <table class="se-table">
                <thead>
                  <tr><th scope="col">Time</th><th scope="col">What happens</th><th scope="col">Who</th></tr>
                </thead>
                <tbody>
                  {m.runOfShow.map((row) => (
                    <tr>
                      <td class="se-time">{row[0]}</td>
                      <td>{row[1]}</td>
                      <td class="se-who">{row[2]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {m.altRunOfShow && (
              <details class="se-exp">
                <summary>{m.altRunOfShow.title}</summary>
                <p class="muted">{m.altRunOfShow.intro}</p>
                <div class="mb-table-wrap">
                  <table class="se-table">
                    <thead>
                      <tr><th scope="col">Time</th><th scope="col">What happens</th><th scope="col">Who</th></tr>
                    </thead>
                    <tbody>
                      {m.altRunOfShow.rows.map((row) => (
                        <tr>
                          <td class="se-time">{row[0]}</td>
                          <td>{row[1]}</td>
                          <td class="se-who">{row[2]}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            )}

            <h4>The deck</h4>
            <SlideDeck deck={decks[m.deck]} />

            <div class="se-two">
              <div>
                <h4>Bring</h4>
                <ul class="se-tight">
                  {m.materials.map((x) => <li>{x}</li>)}
                </ul>
              </div>
              <div>
                <h4>Scouts leave with</h4>
                <ul class="se-tight">
                  {m.homework.map((x) => <li>{x}</li>)}
                </ul>
              </div>
            </div>

            <p class="se-risk"><strong>Where this night fails.</strong> {m.risk}</p>
          </details>
        ))}
      </section>

      <section class="se-block">
        <h2>The Telemetry Rocket — parked for now</h2>

        <div class="se-deferred">
          <p class="se-deferred-tag">{telemetryTrack.statusLabel}</p>
          <ul class="se-tight">
            {telemetryTrack.statusWhy.map((w) => <li>{w}</li>)}
          </ul>
          <p class="se-deferred-swap"><strong>What replaces it.</strong> {telemetryTrack.replacement}</p>
        </div>

        <details class="se-exp">
          <summary>The full crew plan, kept for a future year<span class="se-exp-when">Reference</span></summary>
          <p class="se-note">{telemetryTrack.ifYouRunItAnyway}</p>
        <p>{telemetryTrack.intro}</p>

        <div class="se-callout">
          <h3>{telemetryTrack.theMath.headline}</h3>
          <p>{telemetryTrack.theMath.detail}</p>
          <p><strong>{telemetryTrack.theMath.answer}</strong></p>
        </div>

        <h3>Crew roles</h3>
        <div class="mb-table-wrap">
          <table class="se-table">
            <thead>
              <tr>
                <th scope="col">Role</th><th scope="col">Size</th><th scope="col">Owns</th>
                <th scope="col">Build stages</th><th scope="col">Also earns</th>
              </tr>
            </thead>
            <tbody>
              {telemetryTrack.crewRoles.map((r) => (
                <tr>
                  <td><strong>{r.role}</strong></td>
                  <td class="se-who">{r.n}</td>
                  <td>{r.owns}</td>
                  <td class="se-who">{r.stages}</td>
                  <td class="se-who">{r.badges}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="muted">{telemetryTrack.rolesNote}</p>

        <h3>Three Saturday crew sessions</h3>
        {telemetryTrack.sessions.map((s) => (
          <details class="se-exp">
            <summary>{s.title}<span class="se-exp-when">{s.when}</span></summary>
            <ul class="se-tight">
              {s.what.map((w) => <li>{w}</li>)}
            </ul>
            <p class="se-gotcha"><strong>Gotcha.</strong> {s.gotcha}</p>
          </details>
        ))}

        <h3>What shows up on Monday nights</h3>
        <ul>
          {telemetryTrack.checkpoints.map((c) => (
            <li><strong>Meeting {c.meeting} · {c.minutes}</strong> — {c.what}</li>
          ))}
        </ul>

        <p class="se-note">{telemetryTrack.badgeNote}</p>
        <p class="se-risk"><strong>Honest risk.</strong> {telemetryTrack.honestRisk}</p>
        </details>
      </section>

      <section class="se-block">
        <h2>The Digital Resource Guide — what it does and doesn't replace</h2>
        <p>{drg.what}</p>
        <p class="se-verdict"><strong>Should you just scroll through it in the meeting?</strong> {drg.verdict}</p>

        <div class="se-twocol">
          <div class="se-col-good">
            <h3>Lean on it for</h3>
            <ul class="se-tight">{drg.useItFor.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="se-col-bad">
            <h3>Do not lean on it for</h3>
            <ul class="se-tight">{drg.dontUseItFor.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>

        <p class="muted">
          Every requirement page, if you want to open one on the projector to settle a question mid-meeting:
        </p>
        <div class="se-drg">
          {drg.pages.map((pg) => (
            <div class="se-drg-row">
              <span class="se-drg-req">{pg.req}</span>
              <div>
                <a href={pg.url} target="_blank" rel="noopener noreferrer">{pg.title} ↗</a>
                {pg.subs && (
                  <span class="se-drg-subs">
                    {pg.subs.map((sub) => <a href={sub.url} target="_blank" rel="noopener noreferrer">{sub.id}</a>)}
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="se-block">
        <h2>Requirement 5c — the sample-return card</h2>
        <p class="muted">
          Print one per Scout for October 26. Requirement 5c is a robotic round trip and it is <strong>not</strong>
          the inhabited base &mdash; the base is requirement 7. Keeping them separate is what makes both of them
          hold up, and this card is the individual evidence for 5c.
        </p>
        <SampleReturnCard />
      </section>

      <section class="se-block">
        <h2>Requirement 7 — the base design sheet</h2>
        <p class="muted">
          The patrol charrette stays exactly as it is &mdash; arguing about a base is how the good ideas turn up.
          But requirement 7 asks each Scout for drawings of <em>their</em> base, so each Scout gets their own sheet
          and owns one of the four subsystems out loud during the pitch.
        </p>
        <BaseDesignSheet />
      </section>

      <section class="se-block">
        <h2>Signing it off — one Scout at a time</h2>
        <p class="muted">
          The single biggest way a group merit badge goes wrong is that the room did the requirement and nobody
          checked who actually did it. This is the sheet that prevents that.
        </p>
        <CheckoutSheet />
      </section>

      <section class="se-block">
        <h2>The flight-readiness gate</h2>
        <p class="se-policy"><strong>These are troop rules, not badge requirements.</strong> {gate.policyNote}</p>
        <p>{gate.intro}</p>
        <div class="se-cards">
          {gate.items.map((g) => (
            <article class="card">
              <h3><span class="se-gate-n">{g.n}</span> {g.title}</h3>
              <p>{g.detail}</p>
              <ul class="tag-list"><li>{g.maps}</li></ul>
            </article>
          ))}
        </div>
        <details class="se-exp">
          <summary>Declared mission objectives that actually work</summary>
          <p class="muted">Requirement 3 wants the second launch to accomplish a specific objective. These all produce a number:</p>
          <ul>
            {gate.objectiveExamples.map((o) => <li>{o}</li>)}
          </ul>
          <p class="se-note">{gate.note}</p>
        </details>
      </section>

      <section class="se-block">
        <h2>What to order</h2>
        <p>{orders.intro}</p>
        <p class="se-note">{orders.linkNote}</p>

        <details class="se-exp">
          <summary>What each Scout buys<span class="se-exp-when">{scoutOrder.deadline}</span></summary>
          <p>{scoutOrder.intro}</p>
          <div class="mb-table-wrap">
            <table class="se-table">
              <thead>
                <tr><th scope="col">Item</th><th scope="col">Why / what it is</th><th scope="col">Qty</th><th scope="col">Price</th><th scope="col">Buy</th></tr>
              </thead>
              <tbody>
                {scoutOrder.rows.map((r) => (
                  <tr>
                    <td><strong>{r.item}</strong></td>
                    <td>{r.detail}</td>
                    <td class="se-who">{r.qty}</td>
                    <td class="se-price">{r.price}</td>
                    <td class="se-buycell">
                      {r.buy && <a href={r.buy} target="_blank" rel="noopener noreferrer">Amazon ↗</a>}
                      {r.mfr && <a href={r.mfr} target="_blank" rel="noopener noreferrer">Estes ↗</a>}
                    </td>
                  </tr>
                ))}
              </tbody>
              <tfoot><tr><td colspan="4">Total</td><td class="se-price">{scoutOrder.total}</td></tr></tfoot>
            </table>
          </div>
          <ul class="se-tight se-order-notes">
            {scoutOrder.notes.map((n) => <li>{n}</li>)}
          </ul>
        </details>

        {counselorOrders.map((g) => (
          <details class="se-exp" id={`order-${g.id}`} open>
            <summary>{g.title}<span class="se-exp-when">{g.deadline}</span></summary>
            <p class="se-callout-line"><span class="se-pill">{g.owner}</span></p>
            <p>{g.intro}</p>
            <div class="mb-table-wrap">
              <table class="se-table">
                <thead>
                  <tr><th scope="col">Item</th><th scope="col">Why / what it is</th><th scope="col">Qty</th><th scope="col">Price</th><th scope="col">Buy</th></tr>
                </thead>
                <tbody>
                  {g.rows.map((r) => (
                    <tr>
                      <td><strong>{r.item}</strong></td>
                      <td>{r.detail}</td>
                      <td class="se-who">{r.qty}</td>
                      <td class="se-price">{r.price}</td>
                      <td class="se-buycell">
                        {r.buy && <a href={r.buy} target="_blank" rel="noopener noreferrer">Amazon ↗</a>}
                        {r.mfr && <a href={r.mfr} target="_blank" rel="noopener noreferrer">Maker ↗</a>}
                      </td>
                    </tr>
                  ))}
                </tbody>
                <tfoot><tr><td colspan="4">Total</td><td class="se-price">{g.total}</td></tr></tfoot>
              </table>
            </div>
            <ul class="se-tight se-order-notes">
              {g.notes.map((n) => <li>{n}</li>)}
            </ul>
          </details>
        ))}
      </section>

      <section class="se-block">
        <h2>{competition.name}</h2>
        <p class="se-tagline">{competition.tagline}</p>
        <p>{competition.why}</p>
        <div class="mb-table-wrap">
          <table class="se-table">
            <thead>
              <tr><th scope="col">Award</th><th scope="col">Scored on</th><th scope="col">Measured with</th><th scope="col">Type</th></tr>
            </thead>
            <tbody>
              {competition.scoring.map((s) => (
                <tr>
                  <td><strong>{s.place}</strong></td>
                  <td>{s.basis}</td>
                  <td class="se-who">{s.measured}</td>
                  <td class="se-who">{s.weight}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="se-note"><strong>The trade-off is the lesson.</strong> {competition.tension}</p>
        <p class="se-risk"><strong>Gear this needs.</strong> {competition.gearNote}</p>
      </section>

      <section class="se-block">
        <h2>Guest speaker options</h2>
        <p>{speakers.intro}</p>
        {speakers.options.map((s) => (
          <details class="se-exp">
            <summary>
              <span class="se-speaker-rank">{s.rank}</span>
              {s.name}
              <span class="se-exp-when">{s.lead}</span>
            </summary>
            <p class="se-speaker-org">{s.org} · {s.distance}</p>
            <p><strong>What they are.</strong> {s.what}</p>
            <p><strong>Why them.</strong> {s.why}</p>
            <dl class="se-speaker-meta">
              <div><dt>The ask</dt><dd>{s.ask}</dd></div>
              <div><dt>Contact</dt><dd>{s.contact}</dd></div>
              <div><dt>Lead time</dt><dd>{s.lead}</dd></div>
            </dl>
            {s.url && <p><a class="mb-link-btn" href={s.url} target="_blank" rel="noopener noreferrer">Open their page ↗</a></p>}
          </details>
        ))}
      </section>

      <section class="se-block">
        <h2>Launch day — {launchDay.date}</h2>
        <p class="muted">Backup dates: {launchDay.backup}</p>
        <p>{launchDay.intro}</p>
        <p class="se-note"><strong>Why the 21st and not Thanksgiving weekend.</strong> {launchDay.whyThisDate}</p>

        <h3>The table that picks your field</h3>
        <p>{launchDay.siteRule.intro}</p>
        <div class="mb-table-wrap">
          <table class="se-table se-table-narrow">
            <thead>
              <tr><th scope="col">Motor class</th><th scope="col">Minimum site dimension</th><th scope="col">What we fly on it</th></tr>
            </thead>
            <tbody>
              {launchDay.siteRule.rows.map((r) => (
                <tr class={r.use !== "—" ? "se-row-hit" : ""}>
                  <td class="se-time">{r.motor}</td>
                  <td>{r.dim}</td>
                  <td class="se-who">{r.use}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="se-note">{launchDay.siteRule.note}</p>

        <h3>Site options</h3>
        {launchDay.sites.map((s) => (
          <details class="se-exp">
            <summary>{s.name}<span class="se-exp-when">{s.status}</span></summary>
            <p>{s.detail}</p>
            <ul class="se-tight">
              {s.actions.map((a) => <li>{a}</li>)}
            </ul>
            {s.url && <p><a class="mb-link-btn" href={s.url} target="_blank" rel="noopener noreferrer">Open ↗</a></p>}
          </details>
        ))}

        <h3>Mission control — crew, countdown, and flight cards</h3>
        <p class="muted">
          Assigned and rehearsed on November 16, run for real on the 21st. Print the flight card, print the
          countdown script, and hand every Scout a position.
        </p>
        <LaunchOps />

        <h3>Range schedule</h3>
        <p class="muted">{launchDay.scheduleNote}</p>
        <div class="mb-table-wrap">
          <table class="se-table se-table-narrow">
            <tbody>
              {launchDay.schedule.map((row) => (
                <tr><td class="se-time">{row[0]}</td><td>{row[1]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="se-two">
          <div>
            <h3>Load the truck</h3>
            <ul class="se-tight">
              {launchDay.checklist.map((c) => <li>{c}</li>)}
            </ul>
          </div>
          <div>
            <h3>Safety, non-negotiable</h3>
            <ul class="se-tight">
              {launchDay.safety.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </div>

        <p>
          Full text:
          {" "}<a href="https://www.nar.org/safety-information/model-rocket-safety-code/" target="_blank" rel="noopener noreferrer">NAR Model Rocket Safety Code ↗</a>
          {" "}·{" "}
          <a href="https://www.scouting.org/health-and-safety/gss/" target="_blank" rel="noopener noreferrer">Guide to Safe Scouting ↗</a>
        </p>
      </section>

      <section class="se-block">
        <h2>Corrections made to the badge page</h2>
        <p class="muted">
          Found while building this series. Everything marked fixed has already been changed on the
          {" "}<a href="/merit-badges/space-exploration/">Space Exploration page</a> and the
          {" "}<a href="/merit-badges/capstones/telemetry-rocket/">Telemetry Rocket capstone</a>.
        </p>
        <ul class="se-fixes">
          {corrections.map((c) => (
            <li class={`se-fix se-fix-${c.status}`}>
              <span class="se-fix-tag">{c.status}</span>
              <strong>{c.what}</strong>
              <p>{c.detail}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---------- wide page shell ---------- */
  .se-page {
    max-width: 82rem;
    margin: 0 auto;
    padding: 0 1.25rem 5rem;
    font-size: 1rem;
    line-height: 1.65;
  }

  .se-crumbs { font-size: 0.88rem; margin: 0 0 1.4rem; }

  .se-hero { display: flex; gap: 1.1rem; align-items: flex-start; margin-bottom: 1.6rem; }
  .se-hero-icon { font-size: 2.6rem; line-height: 1; }
  .se-hero h1 { margin: 0.15rem 0 0.5rem; font-size: clamp(1.9rem, 3.6vw, 2.7rem); line-height: 1.1; }
  .se-hero-sum { margin: 0 0 0.9rem; font-size: 1.06rem; color: var(--muted); max-width: 62ch; }

  .se-block { margin: 0 0 3rem; }
  .se-block > h2 {
    font-size: 1.5rem;
    margin: 0 0 0.7rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--line);
  }
  .se-block h3 { font-size: 1.12rem; margin: 1.6rem 0 0.5rem; }
  .se-block h4 { font-size: 0.98rem; margin: 1.2rem 0 0.4rem; }
  .se-block > p, .se-block > ul, .se-block > ol { max-width: 78ch; }
  .se-lede { font-size: 1.08rem; }

  /* ---------- audience switch ---------- */
  .se-switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin: 0 0 2.4rem;
    padding: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-alt);
  }

  .se-switch-btn {
    font: inherit;
    display: grid;
    gap: 0.1rem;
    text-align: left;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .se-switch-btn strong { font-size: 1rem; color: var(--text); }
  .se-switch-btn span { font-size: 0.82rem; }
  .se-switch-btn:hover { border-color: var(--line); }

  .se-switch-btn.is-on {
    background: var(--accent);
    border-color: var(--accent);
  }

  .se-switch-btn.is-on strong,
  .se-switch-btn.is-on span { color: #fff; }
  :root[data-theme="dark"] .se-switch-btn.is-on strong,
  :root[data-theme="dark"] .se-switch-btn.is-on span { color: #0f1623; }

  /* ---------- expanders ---------- */
  .se-exp, .se-meeting {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    margin: 0.6rem 0;
    padding: 0 1.1rem;
  }

  .se-exp > summary, .se-meeting > summary {
    cursor: pointer;
    padding: 0.75rem 0;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    list-style: none;
  }

  .se-exp > summary::-webkit-details-marker,
  .se-meeting > summary::-webkit-details-marker { display: none; }

  .se-exp > summary::before, .se-meeting > summary::before {
    content: "＋";
    font-family: ui-monospace, monospace;
    color: var(--accent);
    font-size: 0.95rem;
    flex: none;
  }

  .se-exp[open] > summary::before, .se-meeting[open] > summary::before { content: "－"; }

  .se-exp[open], .se-meeting[open] { padding-bottom: 1.1rem; }
  .se-exp[open] > summary, .se-meeting[open] > summary { border-bottom: 1px solid var(--line); margin-bottom: 0.9rem; }

  .se-exp-when {
    margin-left: auto;
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .se-meeting > summary { padding: 0.95rem 0; }
  .se-meeting-title { display: grid; gap: 0.05rem; }
  .se-meeting-title strong { font-size: 1.08rem; }
  .se-meeting-title span { font-size: 0.85rem; color: var(--muted); font-weight: 400; }

  .se-meeting-n {
    flex: none;
    width: 2rem; height: 2rem;
    display: grid; place-items: center;
    border-radius: 999px;
    background: var(--accent); color: #fff;
    font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700;
  }

  :root[data-theme="dark"] .se-meeting-n { color: #0f1623; }

  /* ---------- cards, buys, awards ---------- */
  .se-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 0.8rem; margin: 1rem 0; }

  .se-buy {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.85rem 1rem;
    background: var(--surface);
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .se-buy-top { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; }
  .se-buy-top h3 { margin: 0; font-size: 1rem; }
  .se-buy-price { font-family: ui-monospace, monospace; font-weight: 700; color: var(--accent-strong); white-space: nowrap; }
  .se-buy p { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .se-buy-links { display: flex; gap: 0.4rem; margin: 0.2rem 0 0 !important; flex-wrap: wrap; }

  .se-btn-buy, .se-btn-alt {
    font-size: 0.82rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid var(--accent);
  }

  .se-btn-buy { background: var(--accent); color: #fff; font-weight: 600; }
  :root[data-theme="dark"] .se-btn-buy { color: #0f1623; }
  .se-btn-alt { color: var(--accent-strong); }
  .se-btn-buy:hover, .se-btn-alt:hover { background: var(--accent-strong); color: #fff; }
  :root[data-theme="dark"] .se-btn-buy:hover, :root[data-theme="dark"] .se-btn-alt:hover { color: #0f1623; }

  .se-awards { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.7rem; margin: 1rem 0; }

  .se-award {
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    background: var(--surface);
  }

  .se-award h3 { margin: 0 0 0.3rem; font-size: 1rem; }
  .se-award p { margin: 0 0 0.5rem; font-size: 0.88rem; color: var(--muted); }

  .se-sims { display: grid; gap: 1rem; margin: 1rem 0; }

  .se-vids { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.3rem; }
  .se-vids li { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: baseline; font-size: 0.92rem; }
  .se-vids span { font-size: 0.8rem; color: var(--muted); }

  .se-numbered { padding-left: 1.3rem; }
  .se-numbered li { margin-bottom: 0.4rem; }

  .se-two { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  .se-tight li { margin-bottom: 0.3rem; line-height: 1.55; font-size: 0.94rem; }

  /* ---------- timeline ---------- */
  .se-timeline { list-style: none; margin: 1rem 0 0; padding: 0; }

  .se-tl-item {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.65rem 0 0.65rem 0.9rem;
    border-left: 3px solid var(--line);
    max-width: none;
  }

  .se-tl-item p { margin: 0; }
  .se-tl-when { display: flex; flex-direction: column; }
  .se-tl-window { font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 600; font-size: 0.92rem; }
  .se-tl-owner { font-size: 0.76rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .se-risk-high { border-left-color: #c8532b; }
  .se-risk-med { border-left-color: #d8a13a; }

  /* ---------- shared bits ---------- */
  .se-objective { border-left: 3px solid var(--accent); background: var(--accent-soft); padding: 0.7rem 0.95rem; border-radius: 0 10px 10px 0; }
  .se-covers { list-style: none; padding-left: 0; }
  .se-covers li { margin-bottom: 0.4rem; line-height: 1.55; }

  .se-req {
    display: inline-block;
    min-width: 2.2rem;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    margin-right: 0.4rem;
    border-radius: 5px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    border: 1px solid var(--line);
  }

  .se-risk { border-left: 3px solid #c8532b; padding: 0.6rem 0.9rem; border-radius: 0 10px 10px 0; background: rgba(200, 83, 43, 0.07); font-size: 0.93rem; }
  .se-note { border-left: 3px solid var(--accent); background: var(--accent-soft); padding: 0.65rem 0.95rem; border-radius: 0 10px 10px 0; font-size: 0.93rem; }
  .se-gotcha { font-size: 0.9rem; color: var(--muted); border-top: 1px dashed var(--line); padding-top: 0.6rem; margin-bottom: 0; }

  /* Digital Resource Guide link table. */
  .se-drg { display: grid; gap: 0.35rem; margin: 0.9rem 0 0; }

  .se-drg-row {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: 0.7rem;
    align-items: baseline;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    background: var(--bg-alt);
    border-left: 3px solid var(--line);
    font-size: 0.92rem;
  }

  .se-drg-req {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-weight: 700;
    font-size: 0.78rem;
    color: var(--accent-strong);
  }

  .se-drg-subs { display: inline-flex; flex-wrap: wrap; gap: 0.3rem; margin-left: 0.5rem; }

  .se-drg-subs a {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.72rem;
    padding: 0.05rem 0.4rem;
    border-radius: 5px;
    border: 1px solid var(--line);
    text-decoration: none;
  }

  /* Pioneer bench. Two columns of name + one line of why they matter. */
  .se-pioneers {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 0.5rem;
  }

  .se-pioneer {
    display: grid;
    gap: 0.15rem;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    background: var(--bg-alt);
    border-left: 3px solid var(--accent);
  }

  .se-pioneer-name { font-weight: 700; font-size: 0.93rem; }
  .se-pioneer-did { font-size: 0.84rem; line-height: 1.5; color: var(--muted); }

  .se-verdict {
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    padding: 0.7rem 1rem;
    border-radius: 0 10px 10px 0;
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 78ch;
  }

  .se-twocol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 0.9rem;
    margin: 1.1rem 0;
  }

  .se-col-good, .se-col-bad {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem 1rem 0.9rem;
    background: var(--surface);
  }

  .se-col-good { border-left: 3px solid #3d8b58; }
  .se-col-bad { border-left: 3px solid #c8532b; }
  .se-col-good h3, .se-col-bad h3 { margin: 0 0 0.5rem; font-size: 0.98rem; }

  /* A scoped-out track. Deliberately loud: the whole point is that a counselor
     skimming the page does not start building something we cut. */
  .se-deferred {
    border: 2px solid #c8532b;
    border-radius: 14px;
    padding: 1rem 1.2rem;
    margin: 0 0 1.2rem;
    background: rgba(200, 83, 43, 0.06);
  }

  .se-deferred-tag {
    margin: 0 0 0.7rem;
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #c8532b;
  }

  .se-deferred-swap {
    margin: 0.9rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--line);
    font-size: 0.93rem;
    line-height: 1.65;
  }

  /* Advancement-policy warnings. Amber, not accent — a counselor should read
     these differently from a teaching note. */
  .se-policy {
    border-left: 3px solid #d8a13a;
    background: rgba(216, 161, 58, 0.09);
    padding: 0.7rem 1rem;
    border-radius: 0 10px 10px 0;
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 78ch;
  }

  .se-callout { border: 2px solid #c8532b; border-radius: 14px; padding: 1rem 1.2rem; margin: 1.2rem 0 1.6rem; background: rgba(200, 83, 43, 0.06); }
