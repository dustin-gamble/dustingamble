---
import SpaceTeachingChart from '../../components/SpaceTeachingChart.astro';
const labs = [
 {id:'missions', n:'01', tag:'MISSION DESIGN', title:'Robots go far. People bring a different kind of intelligence.', prompt:'Choose your spacecraft. Launch it. Watch what it discovers.'},
 {id:'base', n:'02', tag:'LUNAR SURVIVAL', title:'Build a base. Then try to break it.', prompt:'Turn off the Sun. Cut the air. Find the system the crew cannot live without.'},
 {id:'drag', n:'03', tag:'AERODYNAMICS', title:'The air pushes back. Harder than you think.', prompt:'Guess what happens at twice the speed. Then slide it and find out.'},
 {id:'impulse', n:'04', tag:'PROPULSION', title:'Two engines. One very surprising tie.', prompt:'Fire them together. Which one delivers more total push?'},
 {id:'math', n:'05', tag:'ROCKET SCIENCE', title:'How much speed can you pack into a rocket?', prompt:'Trade propellant against mass. See the rocket equation move.'},
];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Space Lab — Troop 308</title><meta name="description" content="Five animated, offline-ready space experiments for Scouts."/></head><body>
<div class="orbital-glow" aria-hidden="true"></div>
<header><a class="wordmark" href="/scouts/space-exploration-fall-2026/#counselor"><span>✳</span> TROOP 308 <b>/ SPACE LAB</b></a><span class="offline"><i></i> RUNS OFFLINE</span></header>
<main>
 <div class="intro"><p class="eyebrow">DON’T JUST WATCH SPACE. PLAY WITH IT.</p><h1>Small experiments.<br/><em>Cosmic consequences.</em></h1><p>Launch a mission. Break a Moon base. Make the air fight back.<br/>Five experiments to get the room asking “what if?”</p></div>
 <p><a class="present-link" href="/scouts/space-presentation/">▶ Open the fullscreen animated presentation →</a></p><nav aria-label="Choose an experiment">{labs.map(l=><a href={'#'+l.id}><span>{l.n}</span>{l.id==='missions'?'Launch a mission':l.id==='base'?'Moon base':l.id==='drag'?'Wind tunnel':l.id==='impulse'?'Engine duel':'Rocket equation'}</a>)}</nav>
 {labs.map(l=><section class="experiment" id={l.id}><div class="experiment-title"><span class="number">{l.n}</span><div><p class="eyebrow">{l.tag}</p><h2>{l.title}</h2><p>{l.prompt}</p></div></div><SpaceTeachingChart kind={l.id}/></section>)}
 <footer>Built for curious Scouts. All visuals and controls run locally.<br/><a href="/scouts/space-exploration-fall-2026/#present-missions">Open Monday’s full lesson →</a><p>Mission paths and Moon-base systems are conceptual models. Rocket charts are optional enrichment.</p></footer>
</main>
</body></html>
<style is:global>
.present-link{display:inline-block;background:#a2f3d2;color:#06211e;padding:14px 20px;border-radius:7px;font-weight:750;font-size:15px;text-decoration:none;margin:0 0 18px}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:25px}body{margin:0;background:#070e1c;color:#e9f2ff;font-family:ui-sans-serif,system-ui,-apple-system,sans-serif}.orbital-glow{position:absolute;z-index:-1;top:-300px;left:25%;width:70%;height:700px;border-radius:50%;background:radial-gradient(ellipse,#32307166,transparent 68%);pointer-events:none}header{max-width:1250px;margin:auto;padding:30px 36px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff12}.wordmark{font-size:12px;letter-spacing:.12em;color:#e7f1ff;text-decoration:none;font-weight:800}.wordmark>span{color:#7aeecc;font-size:24px;vertical-align:middle;margin-right:10px}.wordmark b{color:#8e9db8;font-weight:500}.offline{font-size:10px;letter-spacing:.12em;color:#9bb1cb;display:flex;gap:8px;align-items:center}.offline i{height:6px;width:6px;border-radius:50%;background:#71e6bd}main{max-width:1180px;padding:0 28px;margin:auto}.intro{padding:64px 0 34px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:.19em;color:#80dacc;margin:0 0 14px}.intro h1{font-size:clamp(40px,5vw,68px);line-height:1.04;letter-spacing:-.055em;margin:0 0 22px;max-width:920px}.intro em{font-style:normal;background:linear-gradient(100deg,#82edf2,#b6a0ff 72%);color:transparent;background-clip:text}.intro>p:last-child{color:#9aacc5;font-size:17px;line-height:1.65}nav{display:flex;flex-wrap:wrap;gap:8px;border-bottom:1px solid #ffffff12;padding-bottom:30px}nav a{border:1px solid #33415b;padding:11px 15px;border-radius:30px;text-decoration:none;color:#c6d8ee;font-size:12px;background:#14203977}nav a:hover{border-color:#87e6e0}nav span{color:#80dacc;margin-right:8px;font-size:10px}.experiment{padding-top:55px;scroll-margin-top:20px}.experiment-title{display:flex;gap:22px;align-items:flex-start;margin-bottom:22px}.number{font-size:50px;letter-spacing:-.06em;font-weight:800;color:#303d57;line-height:1}.experiment-title .eyebrow{margin-bottom:9px}.experiment-title h2{font-size:clamp(23px,2.6vw,34px);letter-spacing:-.035em;line-height:1.15;margin:0 0 10px;max-width:900px}.experiment-title>div>p:last-child{color:#95a9c4;font-size:14px;margin:0}.experiment .space-lab{box-shadow:0 24px 80px #0004}footer{padding:64px 0 40px;color:#8499b6;font-size:13px;line-height:1.8}footer a{color:#83dfe7}footer p{font-size:11px;color:#647e9d}@media(max-width:650px){header{padding:20px}.wordmark b{display:none}main{padding:0 15px}.intro{padding-top:35px}.number{font-size:35px}.experiment-title{gap:14px}.experiment{padding-top:38px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
