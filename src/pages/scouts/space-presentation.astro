<script>
const show=document.querySelector<HTMLElement>('.show')!;
const frames=Array.from(document.querySelectorAll<HTMLElement>('.frame'));
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
let current=0, paused=reduced, elapsed=0, last=0, auto=true, completed=new Set<number>();
const query=<T extends HTMLElement=HTMLElement>(s:string)=>document.querySelector<T>(s)!;
const activeLab=()=>frames[current].querySelector<HTMLElement>('[data-lab]');
function clickControl(selector:string){activeLab()?.querySelector<HTMLButtonElement>(selector)?.click();}
function setInput(selector:string,value:number){const input=activeLab()?.querySelector<HTMLInputElement>(selector);if(input){input.value=String(value);input.dispatchEvent(new Event('input',{bubbles:true}));}}
function toggleBase(key:string,value:boolean){const el=activeLab()?.querySelector<HTMLButtonElement>(`[data-toggle="${key}"]`);if(el&&el.getAttribute('aria-pressed')!==String(value))el.click();}
function syncMotion(){show.dataset.paused=String(paused);const lab=activeLab();if(lab&&lab.dataset.paused!==String(paused))clickControl('[data-motion]');query('[data-pause]').innerHTML=paused?'▶ <span>Resume</span>':'Ⅱ <span>Pause</span>';query('[data-pause]').setAttribute('aria-pressed',String(paused));}
function resetDemo(){elapsed=0;completed.clear();auto=true;const id=frames[current].id;if(id==='missions'){clickControl('[data-mode="robot"]');clickControl('[data-reset]');if(!reduced)clickControl('[data-play]');}if(id==='impulse'){clickControl('[data-reset]');if(!reduced)clickControl('[data-play]');}if(id==='base'){toggleBase('night',false);toggleBase('battery',false);toggleBase('shield',true);toggleBase('air',true);}if(id==='drag')setInput('[data-speed]',1);if(id==='math'){setInput('[data-isp]',200);setInput('[data-mass-ratio]',1);}syncMotion();}
function move(index:number){const old=activeLab();if(old?.querySelector('[data-play]'))old.querySelector<HTMLButtonElement>('[data-reset]')?.click();if(old&&old.dataset.paused!=='true')old.querySelector<HTMLButtonElement>('[data-motion]')?.click();current=Math.max(0,Math.min(frames.length-1,index));frames.forEach((frame,i)=>{frame.hidden=i!==current;});show.dataset.scene=frames[current].id;query('[data-count]').textContent=String(current).padStart(2,'0')+' / 05';query<HTMLButtonElement>('[data-prev]').disabled=current===0;query('[data-next]').innerHTML=current===0?'Start <span>→</span>':current===frames.length-1?'Restart <span>↺</span>':'Next <span>→</span>';document.querySelectorAll<HTMLElement>('[data-scene-link]').forEach(b=>{if(b.dataset.sceneLink===frames[current].id)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current');});query<HTMLElement>('.timeline span').style.width=current/(frames.length-1)*100+'%';query('[data-announcement]').textContent=current===0?'Make Space Move':frames[current].querySelector('h2')!.textContent;history.replaceState(null,'','#'+frames[current].id);paused=reduced;resetDemo();}
query('[data-next]').addEventListener('click',()=>move(current===frames.length-1?0:current+1));query('[data-prev]').addEventListener('click',()=>move(current-1));query('[data-start]').addEventListener('click',()=>move(1));query('[data-replay]').addEventListener('click',()=>{paused=reduced;resetDemo();});query('[data-pause]').addEventListener('click',()=>{paused=!paused;syncMotion();});
async function fullscreen(){try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen();}catch{query('[data-announcement]').textContent='Use your browser’s fullscreen command to expand the presentation.';}}
query('[data-fullscreen]').addEventListener('click',fullscreen);
document.querySelectorAll<HTMLElement>('[data-scene-link]').forEach(b=>b.addEventListener('click',()=>move(frames.findIndex(f=>f.id===b.dataset.sceneLink))));
document.addEventListener('keydown',e=>{if(((e.target as HTMLElement).matches('input,select,textarea')||(e.key===' '&&(e.target as HTMLElement).matches('button,a')))||e.altKey||e.ctrlKey||e.metaKey)return;if(e.key==='ArrowRight'||e.key==='PageDown'){e.preventDefault();move(current===frames.length-1?0:current+1);}if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();move(current-1);}if(e.key===' '){e.preventDefault();paused=!paused;syncMotion();}if(e.key.toLowerCase()==='r'){paused=reduced;resetDemo();}if(e.key.toLowerCase()==='f')fullscreen();});
// Manual controls take over immediately; an automatic sequence never fights the teacher.
frames.forEach(frame=>{frame.addEventListener('click',e=>{if(e.isTrusted&&(e.target as HTMLElement).closest('.lab-controls'))auto=false;});frame.addEventListener('input',e=>{if(e.isTrusted)auto=false;});});
window.addEventListener('hashchange',()=>{const index=frames.findIndex(f=>f.id===location.hash.slice(1));if(index>=0&&index!==current)move(index);});
function once(at:number,id:number,fn:()=>void){if(elapsed>=at&&!completed.has(id)){completed.add(id);fn();}}
function demo(){if(!auto||reduced)return;const id=frames[current].id;
 if(id==='missions'){once(14500,1,()=>{clickControl('[data-mode="crew"]');clickControl('[data-play]');});}
 if(id==='base'){once(2200,1,()=>toggleBase('night',true));once(5700,2,()=>toggleBase('battery',true));once(9200,3,()=>toggleBase('air',false));once(12500,4,()=>toggleBase('air',true));}
 if(id==='drag'){const cycle=elapsed%15000;const v=cycle<2500?1:cycle<5500?1+(cycle-2500)/3000:cycle<8500?2:cycle<11500?2+(cycle-8500)/3000:3;setInput('[data-speed]',Math.round(v*10)/10);}
 if(id==='math'){const cycle=elapsed%18000;const r=cycle<2000?1:cycle<5500?1+(cycle-2000)/3500:cycle<8500?2:cycle<12500?2+2*(cycle-8500)/4000:cycle<16000?4:4+(cycle-16000)/2000;setInput('[data-mass-ratio]',Math.round(r*10)/10);}
}
// A local Canvas globe keeps the opening animated with no network, font, or 3D-service dependency.
const canvas=query<HTMLCanvasElement>('#universe'),ctx=canvas.getContext('2d')!;
let width=0,height=0,clock=0;
const stars=Array.from({length:160},(_,i)=>({x:((i*713+97)%1601)/1601,y:((i*373+47)%1009)/1009,r:i%9===0?1.4:.6,phase:i*.47}));
const land=[[-105,45,36,26],[-85,16,20,16],[-62,-17,21,38],[14,6,25,33],[36,49,65,24],[100,29,49,24],[132,-25,23,16],[-42,71,20,15]];
function resize(){width=innerWidth;height=innerHeight;const d=Math.min(devicePixelRatio||1,2);canvas.width=width*d;canvas.height=height*d;ctx.setTransform(d,0,0,d,0,0);}
addEventListener('resize',resize);resize();
function circle(x:number,y:number,r:number,color:string|CanvasGradient){ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fillStyle=color;ctx.fill();}
function drawGlobe(){const narrow=width<801;const cx=width*(narrow?.67:.735),cy=height*(narrow?.63:.49),r=Math.min(width*(narrow?.26:.205),height*(narrow?.21:.32));const angle=clock*.000095;
 const glow=ctx.createRadialGradient(cx,cy,r*.6,cx,cy,r*1.8);glow.addColorStop(0,'#2076ad25');glow.addColorStop(.65,'#195c9f12');glow.addColorStop(1,'#14376100');ctx.fillStyle=glow;ctx.fillRect(cx-r*2,cy-r*2,r*4,r*4);
 const orbit=(start:number,end:number)=>{ctx.save();ctx.translate(cx,cy);ctx.rotate(-.34);ctx.beginPath();ctx.ellipse(0,0,r*1.48,r*.44,0,start,end);ctx.strokeStyle='#81dfcb55';ctx.lineWidth=1;ctx.stroke();ctx.beginPath();ctx.ellipse(0,0,r*1.59,r*.47,0,start,end);ctx.strokeStyle='#82d8d418';ctx.stroke();ctx.restore();};orbit(Math.PI,Math.PI*2);
 const sphere=ctx.createRadialGradient(cx-r*.48,cy-r*.5,r*.05,cx+r*.2,cy+r*.12,r*1.25);sphere.addColorStop(0,'#286a8b');sphere.addColorStop(.35,'#13485f');sphere.addColorStop(.7,'#09202f');sphere.addColorStop(1,'#01060e');circle(cx,cy,r,sphere);
 ctx.save();ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);ctx.clip();
 for(let lat=-78;lat<=78;lat+=3){for(let lon=-180;lon<180;lon+=3){const p=lat*Math.PI/180,l=lon*Math.PI/180+angle,z=Math.cos(p)*Math.cos(l);if(z<0)continue;const x=Math.cos(p)*Math.sin(l),y=-Math.sin(p);const isLand=land.some(([lx,ly,rx,ry])=>((lon-lx)/rx)**2+((lat-ly)/ry)**2<1+.16*Math.sin(lon*.31+lat*.29));if(!isLand&&((lon+180)%15!==0&&(lat+78)%15!==0))continue;ctx.globalAlpha=(.14+z*.65)*(isLand?1:.25);circle(cx+x*r,cy+y*r,r*(isLand?.0045:.0022),isLand?'#7cddc3':'#80c1d6');}}
 ctx.globalAlpha=1;const shadow=ctx.createLinearGradient(cx-r,cy-r,cx+r,cy+r*.1);shadow.addColorStop(0,'#01071000');shadow.addColorStop(.6,'#01071000');shadow.addColorStop(1,'#010710cc');ctx.fillStyle=shadow;ctx.fillRect(cx-r,cy-r,r*2,r*2);ctx.restore();
 ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);ctx.strokeStyle='#6dd9e34a';ctx.lineWidth=1;ctx.shadowColor='#62bffa';ctx.shadowBlur=18;ctx.stroke();ctx.shadowBlur=0;orbit(0,Math.PI);
 const t=clock*.00055;const ox=Math.cos(t)*r*1.48,oy=Math.sin(t)*r*.44;const px=cx+ox*Math.cos(-.34)-oy*Math.sin(-.34),py=cy+ox*Math.sin(-.34)+oy*Math.cos(-.34);if(Math.sin(t)>0||Math.hypot(px-cx,py-cy)>r){ctx.save();ctx.translate(px,py);ctx.rotate(t+.8);ctx.shadowColor='#c7fff3';ctx.shadowBlur=17;ctx.fillStyle='#d6fff0';ctx.fillRect(-4,-7,8,14);ctx.shadowBlur=0;ctx.fillStyle='#5cabc7';ctx.fillRect(-20,-5,13,10);ctx.fillRect(7,-5,13,10);ctx.strokeStyle='#bfe7ef';ctx.beginPath();ctx.moveTo(0,-7);ctx.lineTo(0,-17);ctx.stroke();ctx.restore();}
}
function paint(now:number){const dt=last?Math.min(now-last,60):0;last=now;if(!paused&&!document.hidden){clock+=dt;elapsed+=dt;demo();}ctx.clearRect(0,0,width,height);stars.forEach(s=>{ctx.globalAlpha=.2+.4*(.5+.5*Math.sin(clock*.0005+s.phase));circle(s.x*width,s.y*height,s.r,'#b5d4f8');});ctx.globalAlpha=1;if(current===0)drawGlobe();requestAnimationFrame(paint);}
function init(){const target=frames.findIndex(f=>f.id===location.hash.slice(1));move(target>=0?target:0);requestAnimationFrame(paint);}
if(document.readyState==='complete')init();else window.addEventListener('load',init,{once:true});
</script>
