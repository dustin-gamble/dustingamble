border:0;border-radius:6px;font-size:15px;font-weight:750;padding:17px 22px;box-shadow:0 8px 50px #53d6a21c}.start:hover{background:#c4ffe7}.start span{font-size:24px;line-height:1}.intro-foot{font-size:10px;color:#7186a4;margin:18px 0 0;letter-spacing:.04em}.orbit-tag{position:absolute;bottom:12%;left:60%;display:flex;gap:13px;align-items:center;font-size:10px;letter-spacing:.13em;color:#b3cada}.crosshair{font-size:32px;color:#89edd0;font-weight:200}.orbit-tag small{display:block;margin-top:7px;font-size:8px;letter-spacing:.17em;color:#6e869d}.experiment-frame{display:grid;grid-template-rows:auto minmax(0,1fr) auto;padding:22px 0 12px;gap:16px}.scene-heading .eyebrow{font-size:10px;margin-bottom:8px}.scene-heading h2{font-size:clamp(26px,3.4vw,54px);font-weight:800;letter-spacing:-.05em;line-height:1.04;margin:0}.scene-heading h2 em{font-style:normal;color:var(--accent);display:block}.discussion{display:flex;align-items:center;gap:18px;min-height:26px}.discussion>span{font-size:9px;font-weight:800;letter-spacing:.15em;color:var(--accent);white-space:nowrap}.discussion p{font-size:clamp(12px,1.2vw,18px);line-height:1.3;margin:0;color:#adbed6}.show-controls{display:flex;align-items:center;justify-content:space-between;gap:15px;border-top:1px solid #d0e5ff17}.show-controls button{color:#9cadc5;border:1px solid transparent;background:transparent;border-radius:5px;font-size:13px;min-height:37px;padding:8px 12px}.show-controls button:hover{color:#fff;background:#ffffff0b;border-color:#ffffff1f}.scene-nav,.playback{display:flex;align-items:center;gap:12px}.scene-nav [data-count]{font-size:10px;font-variant-numeric:tabular-nums;color:#91a5c1;white-space:nowrap;letter-spacing:.1em}.scene-nav [data-prev]{font-size:24px;padding:3px 8px}.scene-nav nav{display:flex;gap:4px;margin-left:10px}.scene-nav nav button{height:28px;width:16px;padding:0;min-height:28px;position:relative;border:0}.scene-nav nav button:after{content:'';position:absolute;width:5px;height:5px;border-radius:5