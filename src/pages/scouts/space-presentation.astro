---
import SpaceTeachingChart from '../../components/SpaceTeachingChart.astro';
const scenes = [
 {id:'missions', label:'The explorers', kicker:'01 / CHOOSE YOUR MISSION', first:'Send a robot.', second:'Send a crew.', prompt:'What can a robot do that a crew cannot—and the other way around?', accent:'#7ce9ec'},
 {id:'base', label:'Moon base', kicker:'02 / KEEP THE CREW ALIVE', first:'The Sun goes down.', second:'What fails first?', prompt:'Ask the room to name the next system you should restore.', accent:'#9af1ca'},
 {id:'drag', label:'Wind tunnel', kicker:'03 / THE WIND TUNNEL', first:'Twice the speed.', second:'Four times the drag.', prompt:'Predict the drag at three times the speed. Then test it.', accent:'#ffb58d'},
 {id:'impulse', label:'Engine duel', kicker:'04 / THE ENGINE DUEL', first:'Two very different burns.', second:'One surprising tie.', prompt:'Which shaded area is larger? What does the area measure?', accent:'#bca5ff'},
 {id:'math', label:'Rocket equation', kicker:'05 / PACK YOUR PROPELLANT', first:'More fuel. More speed.', second:'But smaller gains.', prompt:'Double the mass ratio twice. Compare the speed gained each time.', accent:'#8ef1cf'},
];
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#060912"/><title>Make Space Move — Troop 308</title><meta name="description" content="An animated, offline-ready Space Exploration presentation. Five experiments, one big universe."/></head>
<body>
<canvas id="universe" aria-hidden="true"></canvas>
<div class="show" data-scene="intro">
 <header class="show-header"><a href="/scouts/space-lessons/" class="brand"><span class="brand-icon">✳</span> TROOP 308 <span class="brand-sub">/ SPACE EXPLORATION</span></a><span class="local-badge"><i></i> OFFLINE READY</span></header>
 <main id="presentation" aria-label="Animated space presentation">
  <section class="frame intro-frame" id="intro" aria-labelledby="intro-title">
   <div class="intro-copy"><p class="eyebrow">YOUR CLASSROOM. THE WHOLE UNIVERSE.</p><h1 id="intro-title">MAKE<br/>SPACE<br/><em>MOVE.</em></h1><p class="intro-deck">Five experiments.<br/>A universe of “what if?”</p><button class="start" data-start>Start the show <span>↗</span></button><p class="intro-foot">Mission design · Moon bases · Rocket science</p></div>
   <div class="orbit-tag"><span class="crosshair">+</span><span>EARTH / OUR STARTING POINT<small>WHERE WILL YOU GO NEXT?</small></span></div>
  </section>
  {scenes.map(s=><section class="frame experiment-frame" id={s.id} hidden aria-labelledby={'title-'+s.id} style={'--accent:'+s.accent}>
   <div class="scene-heading"><p class="eyebrow">{s.kicker}</p><h2 id={'title-'+s.id}>{s.first} <em>{s.second}</em></h2></div>
   <SpaceTeachingChart kind={s.id}/>
   <div class="discussion"><span>ASK THE ROOM</span><p>{s.prompt}</p></div>
  </section>)}
 </main>
 <footer class="show-controls"><div class="scene-nav"><button data-prev aria-label="Previous scene">←</button><span data-count>00 / 05</span><nav aria-label="Choose a scene"><button data-scene-link="intro" aria-label="Opening" aria-current="step"></button>{scenes.map(s=><button data-scene-link={s.id} aria-label={s.label}></button>)}</nav></div><div class="playback"><button data-replay title="Replay this scene (R)">↺ <span>Replay</span></button><button data-pause title="Pause or resume motion (Space)" aria-pressed="false">Ⅱ <span>Pause</span></button><button data-fullscreen title="Fullscreen (F)">⛶ <span>Fullscreen</span></button></div><button class="next" data-next>Start <span>→</span></button></footer>
 <div class="timeline" aria-hidden="true"><span></span></div>
 <p class="sr-only" data-announcement aria-live="polite"></p>
</div>
<noscript><p class="no-script">Enable JavaScript to run the animated presentation. The complete lesson is available <a href="/scouts/space-exploration-fall-2026/">here</a>.</p></noscript>
</body></html>
<style is:global>
