b button[aria-pressed=true]{background:#183a36;color:#adf9de;border-color:#73cdb0}.show .space-lab .scrub{margin-left:auto}.show .space-lab input[type=range]{width:clamp(90px,11vw,170px)}.show .space-lab .formula{font-size:12px}.show .space-lab .star{opacity:.5}.show .space-lab [data-craft]{filter:drop-shadow(0 0 8px #87fcff)}
.show[data-paused=true] *, .show[data-paused=true]~*{animation-play-state:paused!important}
