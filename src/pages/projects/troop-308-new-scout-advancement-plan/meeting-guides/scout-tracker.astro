---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Troop 308 Eagle Progress Tracker"
  description="A visual eagle-progress tracker for Troop 308 showing each scout's merit badge status at a glance."
>
  <section class="section-block home-hero">
    <p><a href="/projects/troop-308-new-scout-advancement-plan/meeting-guides/">&larr; Back to meeting guides</a></p>
    <h1>Eagle Progress Tracker</h1>
    <p>
      Each scout's path to Eagle, shown as badge cards.
      Click a scout to see their full journey.
    </p>
    <div class="tracker-legend">
      <span class="legend-chip legend-chip--earned">Earned</span>
      <span class="legend-chip legend-chip--started">In Progress</span>
      <span class="legend-chip legend-chip--missing">Not Started</span>
    </div>
  </section>

  <section id="tracker-root" class="section-block" data-json-url="/data/troop308/scout-tracker-current.json">
    <div id="scout-list"></div>
    <div id="scout-detail" class="scout-detail" hidden></div>
    <p id="tracker-status" class="tracker-status">Loading tracker data…</p>
  </section>

  <script type="module" src="/scripts/troop308-scout-tracker.js"></script>

  <style is:global>
    /* ── legend ── */
    .tracker-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 0.75rem;
    }
    .legend-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      font-family: "Space Grotesk", sans-serif;
      font-size: 0.82rem;
      font-weight: 500;
    }
    .legend-chip::before {
      content: "";
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }
    .legend-chip--earned { background: color-mix(in srgb, #2e7d4f 15%, var(--surface)); color: #2e7d4f; border: 1px solid color-mix(in srgb, #2e7d4f 30%, transparent); }
    .legend-chip--earned::before { background: #2e7d4f; }
    .legend-chip--started { background: color-mix(in srgb, var(--accent) 12%, var(--surface)); color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); }
    .legend-chip--started::before { background: var(--accent); }
    .legend-chip--missing { background: var(--surface); color: var(--muted); border: 1px solid var(--line); }
    .legend-chip--missing::before { background: var(--line); }

    .tracker-status {
      color: var(--muted);
      font-size: 0.86rem;
      font-family: "Space Grotesk", sans-serif;
    }

    /* ── scout row cards ── */
    .scout-row {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.25rem 1.4rem;
      margin-bottom: 1rem;
      cursor: pointer;
      transition: box-shadow 0.2s, border-color 0.2s, transform 0.15s;
    }
    .scout-row:hover {
      border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
      box-shadow: 0 4px 20px color-mix(in srgb, var(--accent) 8%, transparent);
      transform: translateY(-1px);
    }
    .scout-row.is-active {
      border-color: var(--accent);
      box-shadow: 0 6px 28px color-mix(in srgb, var(--accent) 14%, transparent);
    }

    .scout-row-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 0.85rem;
    }
    .scout-name {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
      margin: 0;
    }
    .scout-rank {
      font-family: "Space Grotesk", sans-serif;
      font-size: 0.82rem;
      color: var(--muted);
      background: var(--accent-soft);
      padding: 0.15rem 0.6rem;
      border-radius: 999px;
    }
    .scout-progress-summary {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: "Space Grotesk", sans-serif;
      font-size: 0.84rem;
    }
    .progress-ring {
      position: relative;
      width: 36px;
      height: 36px;
    }
    .progress-ring svg {
      width: 36px;
      height: 36px;
      transform: rotate(-90deg);
    }
    .progress-ring-text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 0.66rem;
      font-weight: 700;
      font-family: "Space Grotesk", sans-serif;
      color: var(--text);
    }

    /* ── badge mini cards ── */
    .badge-card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
      gap: 0.5rem;
    }
    .badge-card {
      position: relative;
      padding: 0.55rem 0.65rem;
      border-radius: 10px;
      font-family: "Space Grotesk", sans-serif;
      font-size: 0.76rem;
      line-height: 1.3;
      font-weight: 500;
      text-align: center;
      transition: transform 0.15s;
      overflow: hidden;
    }
    .badge-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
    }
    .badge-card--earned {
      background: color-mix(in srgb, #2e7d4f 10%, var(--surface));
      border: 1px solid color-mix(in srgb, #2e7d4f 25%, transparent);
      color: #2e7d4f;
    }
    .badge-card--earned::before { background: #2e7d4f; }
    .badge-card--inProgress,
    .badge-card--mbcApproved {
      background: color-mix(in srgb, var(--accent) 8%, var(--surface));
      border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
      color: var(--accent);
    }
    .badge-card--inProgress::before,
    .badge-card--mbcApproved::before { background: var(--accent); }
    .badge-card--missing {
      background: color-mix(in srgb, var(--line) 20%, var(--surface));
      border: 1px solid var(--line);
      color: var(--muted);
      opacity: 0.7;
    }
    .badge-card--missing::before { background: var(--line); }
    .badge-card-label {
      display: block;
    }
    .badge-card-status {
      display: block;
      font-size: 0.64rem;
      font-weight: 400;
      margin-top: 0.2rem;
      opacity: 0.8;
    }

    /* ── detail panel ── */
    .scout-detail { margin-top: 0; }
    .scout-detail[hidden] { display: none; }

    .detail-card {
      background: var(--surface);
      border: 1px solid var(--accent);
      border-radius: var(--radius);
      padding: 1.8rem 2rem;
      margin-bottom: 1rem;
      box-shadow: 0 8px 32px color-mix(in srgb, var(--accent) 10%, transparent);
      animation: slideDown 0.25s ease;
    }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .detail-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.25rem;
    }
    .detail-header h2 {
      margin: 0;
      font-size: 1.4rem;
    }
    .detail-header .detail-rank {
      font-family: "Space Grotesk", sans-serif;
      font-size: 0.88rem;
      color: var(--muted);
      background: var(--accent-soft);
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
    }
    .detail-close {
      margin-left: auto;
      background: none;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.35rem 0.9rem;
      font-family: "Space Grotesk", sans-serif;
      font-size: 0.84rem;
      color: var(--muted);
      cursor: pointer;
      transition: all 0.15s;
    }
    .detail-close:hover {
      background: var(--accent-soft);
      color: var(--accent);
      border-color: var(--accent);
    }

    .detail-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .detail-stat-card {
      background: color-mix(in srgb, var(--accent) 4%, var(--bg));
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 0.75rem 1rem;
      text-align: center;
    }
    .detail-stat-value {
      display: block;
      font-size: 1.5rem;
      font-weight: 700;
      font-family: "Space Grotesk", sans-serif;
      color: var(--accent);
    }
    .detail-stat-label {
      font-size: 0.78rem;
      font-family: "Space Grotesk", sans-serif;
      color: var(--muted);
    }

    .detail-section {
      margin-bottom: 1.25rem;
    }
    .detail-section h3 {
      font-family: "Space Grotesk", sans-serif;
      font-size: 0.92rem;
      margin: 0 0 0.6rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .detail-badge-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .detail-pill {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 0.25rem 0.7rem;
      font-size: 0.78rem;
      font-family: "Space Grotesk", sans-serif;
      font-weight: 500;
    }
    .detail-pill--earned {
      background: color-mix(in srgb, #2e7d4f 14%, var(--surface));
      border: 1px solid color-mix(in srgb, #2e7d4f 28%, transparent);
      color: #2e7d4f;
    }
    .detail-pill--inProgress,
    .detail-pill--mbcApproved {
      background: color-mix(in srgb, var(--accent) 10%, var(--surface));
      border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
      color: var(--accent);
    }
    .detail-pill--missing {
      background: color-mix(in srgb, #c1833a 10%, var(--surface));
      border: 1px solid color-mix(in srgb, #c1833a 24%, transparent);
      color: #c1833a;
    }

    .detail-route {
      margin-top: 1.25rem;
      padding: 1rem 1.15rem;
      background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 6%, var(--surface)), color-mix(in srgb, #2e7d4f 4%, var(--surface)));
      border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--line));
      border-radius: 12px;
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .detail-route strong {
      font-family: "Space Grotesk", sans-serif;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      display: block;
      margin-bottom: 0.35rem;
      color: var(--muted);
    }

    @media (max-width: 640px) {
      .badge-card-grid {
        grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
        gap: 0.4rem;
      }
      .badge-card {
        padding: 0.4rem 0.45rem;
        font-size: 0.7rem;
      }
      .scout-row {
        padding: 1rem;
      }
      .detail-card {
        padding: 1.2rem;
      }
      .scout-progress-summary {
        margin-left: 0;
      }
    }
  </style>
</BaseLayout>
