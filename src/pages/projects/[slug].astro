---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getProjects } from "../../lib/content";
import { getExistingPageImages } from "../../lib/page-images";

export async function getStaticPaths() {
  const projects = getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const pageImages = getExistingPageImages("projects", project.slug, project.title);
---
<BaseLayout
  title={project.title}
  description={project.summary}
  showProgress={true}
>
  <article class={`prose project-page project-${project.slug}`}>
    <p><a href="/projects/">&larr; Back to projects</a></p>
    <h1 transition:name={project.slug}>{project.title}</h1>
    <p class="meta-row">
      <time datetime={project.date}>{formatDate(project.date)}</time>
    </p>
    <ul class="tag-list" aria-label="Tags">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <p>{project.summary}</p>
    {pageImages.length > 0 && (
      <section class="page-image-grid" aria-label="Project illustrations">
        {pageImages.map((image) => (
          <figure class="page-image-card">
            <img src={image.src} alt={image.alt} loading="lazy" />
          </figure>
        ))}
      </section>
    )}
    <hr />
    <Fragment set:html={project.html} />
  </article>
</BaseLayout>
