---
import BaseLayout from "../layouts/BaseLayout.astro";
import WritingCard from "../components/WritingCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getFeaturedWriting, getFeaturedProjects } from "../lib/content";
import fs from "node:fs";
import path from "node:path";

const featuredWriting = getFeaturedWriting(4);
const featuredProjects = getFeaturedProjects(4);
const activeProjects = [
  {
    title: "Gamble Systems",
    url: "https://gamble.systems/",
    summary: "An umbrella brand for the apps, tools, and experiments I am building.",
    linkLabel: "gamble.systems"
  },
  {
    title: "Troop 308 New Scout Advancement Plan",
    url: "/projects/troop-308-new-scout-advancement-plan/",
    summary: "A first-year Scout advancement lane built around Monday meetings, monthly outings, and a dedicated 30-minute merit badge block."
  },
  {
    title: "Take It In",
    url: "/projects/take-it-in/",
    summary: "An iOS app that turns flights into cinematic, offline, chaptered journey stories.",
    linkLabel: "takeitin.app"
  },
  {
    title: "Cozy Cauldron",
    url: "/projects/cozy-cauldron/",
    summary: "An iOS potion-brewing game shaped by ideas from my kids and built with AI."
  },
  {
    title: "Line Starts Here",
    url: "/projects/line-starts-here/",
    summary: "A queue simulator game where you cut through switchback lines before your patience runs out."
  },
  {
    title: "BioGyro",
    url: "https://biogyro.io/",
    summary:
      "A personal metabolic feedback engine that learns how food affects you, and helps you make better decisions in real time."
  },
  {
    title: "AeroVerse",
    url: "https://sim.dustingamble.com/",
    summary: "A multiplayer, cloud-hosted, agent-generated flight simulator launching soon.",
    linkLabel: "sim.dustingamble.com"
  }
];
const publicRoot = path.resolve(process.cwd(), "public");
const mainHeroImage = {
  src: "/images/human_AI_robot.png",
  alt: "Human and AI robotics concept artwork"
};
const heroImageExists = fs.existsSync(path.join(publicRoot, mainHeroImage.src.replace(/^\//, "")));
const lowerHomeImages = [
  {
    src: "/images/aerospace_autonomy.png",
    alt: "Aerospace autonomy concept artwork"
  },
  {
    src: "/images/robot_AI.png",
    alt: "Robot and AI collaboration concept artwork"
  }
].filter((image) => fs.existsSync(path.join(publicRoot, image.src.replace(/^\//, ""))));
---
<BaseLayout
  title="Dustin Gamble"
  description="Autonomous systems, aerospace engineering, and AI-augmented design workflows. Essays and project notes from Dustin Gamble."
>
  <section class="home-hero section-block">
    <h1>Dustin Gamble</h1>
    <p>Autonomous systems, aerospace engineering, and AI-augmented design workflows.</p>
    {heroImageExists && (
      <figure class="home-main-visual">
        <img src={mainHeroImage.src} alt={mainHeroImage.alt} loading="eager" />
      </figure>
    )}
  </section>

  <section class="section-block" aria-labelledby="active-projects-title">
    <h2 id="active-projects-title" class="section-heading">Active Projects</h2>
    <div class="grid cols-2">
      {
        activeProjects.map((project) => (
          <article class="card">
            <h3>
              <a
                href={project.url}
                target={project.url.startsWith("/") ? undefined : "_blank"}
                rel={project.url.startsWith("/") ? undefined : "noopener noreferrer"}
              >
                {project.title}
              </a>
            </h3>
            <p>{project.summary}</p>
            {project.linkLabel && (
              <p>
                <a
                  href={project.url}
                  target={project.url.startsWith("/") ? undefined : "_blank"}
                  rel={project.url.startsWith("/") ? undefined : "noopener noreferrer"}
                >
                  {project.linkLabel}
                </a>
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  {lowerHomeImages.length > 0 && (
    <section class="section-block" aria-labelledby="home-visuals-title">
      <h2 id="home-visuals-title" class="section-heading">Visual Notes</h2>
      <div class="home-support-grid">
        {
          lowerHomeImages.map((image) => (
            <figure class="home-support-card">
              <img src={image.src} alt={image.alt} loading="lazy" />
            </figure>
          ))
        }
      </div>
    </section>
  )}

  <section class="section-block" aria-labelledby="featured-writing-title">
    <h2 id="featured-writing-title" class="section-heading">Featured Writing</h2>
    <div class="grid cols-2">
      {featuredWriting.map((post) => <WritingCard post={post} />)}
    </div>
    <p><a href="/writing/">Browse all essays</a></p>
  </section>

  <section class="section-block" aria-labelledby="selected-projects-title">
    <h2 id="selected-projects-title" class="section-heading">Selected Projects</h2>
    <div class="grid cols-2">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p><a href="/projects/">View project archive</a></p>
  </section>

  <section class="section-block about-teaser" aria-labelledby="about-teaser-title">
    <h2 id="about-teaser-title" class="section-heading">About</h2>
    <p>
      I build practical aerospace systems and the workflows that support them, from prototype concepts to
      simulation-heavy design loops. Most of my writing here is about how teams can move faster without
      losing engineering rigor.
    </p>
    <p><a href="/about/">Read the full about page</a></p>
  </section>

  <section class="section-block about-teaser" aria-labelledby="scouting-teaser-title">
    <h2 id="scouting-teaser-title" class="section-heading">Scouting</h2>
    <p>
      I serve as an Assistant Scoutmaster with Troop 308 (Los Padres Council) and am a registered Merit
      Badge Counselor for Aviation, Robotics, Programming, Artificial Intelligence, Engineering, Inventing,
      Game Design, and Space Exploration. Each badge has a page with the official requirements, pamphlet,
      curated videos, and my counselor plan.
    </p>
    <p><a href="/merit-badges/">Browse the Merit Badge pages</a></p>
  </section>
</BaseLayout>
