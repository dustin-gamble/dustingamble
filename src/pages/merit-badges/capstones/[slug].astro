---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BrainstormMatrix from "../../../components/BrainstormMatrix.astro";
import RocketCalculator from "../../../components/RocketCalculator.astro";
import PatrolBox3D from "../../../components/PatrolBox3D.astro";
import { getCapstones, getCapstoneBySlug, resolveCapstoneCoverage } from "../../../lib/merit-badges.js";

export async function getStaticPaths() {
  const capstones = getCapstones();
  return capstones.map((cap) => ({
    params: { slug: cap.slug },
    props: { capstone: cap }
  }));
}

const { capstone } = Astro.props;
const coverage = resolveCapstoneCoverage(capstone);
const totalItems = coverage.reduce((sum, c) => sum + c.items.length, 0);

// Per-capstone interactive content
const brainstorms: Record<string, any> = {
  "patrol-box-2": {
    id: "patrolbox",
    title: "Brainstorm: what's your patrol's biggest gear pain?",
    intro: "Drag dots to score each idea on impact (vertical) and effort (horizontal). The Quick Wins quadrant is the sweet spot for a 6-week capstone.",
    xAxis: { low: "Quick to build", high: "Big build" },
    yAxis: { low: "Nice to have", high: "Patrol can't function without it" },
    ideas: [
      { text: "Faster chuck-box setup", x: 0.35, y: 0.85 },
      { text: "Stove platform that doesn't wobble", x: 0.25, y: 0.75 },
      { text: "Wind-proof flag stand", x: 0.4, y: 0.55 },
      { text: "Gear sled for parking-lot to camp", x: 0.7, y: 0.7 },
      { text: "Lantern hanging tree", x: 0.2, y: 0.4 },
      { text: "Fold-flat dish-line drying rack", x: 0.55, y: 0.6 },
      { text: "Patrol box rebuilt with drawers", x: 0.85, y: 0.9 },
      { text: "Rope-coil organizer", x: 0.15, y: 0.3 },
    ],
  },
  "troop-toolbox-invention": {
    id: "toolbox",
    title: "Brainstorm: small, real, fixable problems",
    intro: "Watch one campout and write down anything lost, dropped, retied, or cursed at. Score each idea here. Aim for the bottom-left quadrant — that's the badge sweet spot.",
    xAxis: { low: "Cheap + fast", high: "Big project" },
    yAxis: { low: "Mild annoyance", high: "Happens every campout" },
    ideas: [
      { text: "Mess-kit name-tag system", x: 0.15, y: 0.7 },
      { text: "Tent-stake organizer pouch", x: 0.2, y: 0.6 },
      { text: "Flashlight dummy-cord clip", x: 0.1, y: 0.55 },
      { text: "Knot-tying practice board", x: 0.25, y: 0.4 },
      { text: "Color-coded patrol-rope ends", x: 0.1, y: 0.65 },
      { text: "Drying line clip that doesn't snap", x: 0.15, y: 0.5 },
      { text: "Pocket fire-starter dispenser", x: 0.2, y: 0.45 },
      { text: "Reusable propane-bottle handle", x: 0.4, y: 0.55 },
    ],
  },
  "reusable-rocket-recovery": {
    id: "recovery",
    title: "Brainstorm: rocket recovery improvements",
    intro: "Pick one subsystem to improve. Score on Inventing payoff (vertical — does it teach the badge?) vs build effort (horizontal). The telemetry payload from the paired Telemetry Rocket capstone gives you real before/after data on whichever you pick.",
    xAxis: { low: "An afternoon of work", high: "Multi-week build" },
    yAxis: { low: "Marginal improvement", high: "Real flight-day win" },
    ideas: [
      { text: "Streamer→chute reefing mechanism", x: 0.6, y: 0.85 },
      { text: "Tougher shock-cord mount", x: 0.25, y: 0.7 },
      { text: "Quick-swap fin can", x: 0.65, y: 0.6 },
      { text: "Rapid-reload payload bay", x: 0.55, y: 0.8 },
      { text: "Buzzer / LED recovery beacon", x: 0.3, y: 0.65 },
      { text: "Wadding alternative (Nomex pad)", x: 0.2, y: 0.45 },
      { text: "Streamer tape change for visibility", x: 0.1, y: 0.3 },
      { text: "Dual-deploy mod with timer", x: 0.95, y: 0.95 },
    ],
  },
};

const showRocketCalc = capstone.slug === "reusable-rocket-recovery" || capstone.slug === "telemetry-rocket";
const showPatrolBox3D = capstone.slug === "patrol-box-2";
const brainstorm = brainstorms[capstone.slug];
---
<BaseLayout
  title={`${capstone.title} — Merit Badge Capstone`}
  description={`${capstone.title}: a cross-badge capstone project with executive summary, requirement mapping, and full build plan from Dustin Gamble, Scouting America Merit Badge Counselor.`}
>
  <article class="prose mb-page">
    <p><a href="/merit-badges/">&larr; Back to Merit Badge Counselor</a></p>

    <header class="mb-header">
      <span class="mb-icon-lg" aria-hidden="true">{capstone.icon}</span>
      <div>
        <p class="kicker">Merit Badge Capstone Project</p>
        <h1>{capstone.title}</h1>
      </div>
    </header>

    <section aria-labelledby="exec-title" class="mb-section mb-capstone">
      <h2 id="exec-title">Executive Summary</h2>
      <p>{capstone.executiveSummary}</p>
      <p class="muted">
        Covers {totalItems} requirement items across {coverage.length} badges.
      </p>
    </section>

    <section aria-labelledby="coverage-title" class="mb-section">
      <h2 id="coverage-title">Requirements This Project Checks Off</h2>
      <p class="muted">
        Requirement IDs link back to the corresponding badge page, where the full official text and
        checklist live. The counselor note under each badge explains how this project maps onto the
        badge's intent.
      </p>
      {coverage.map((cov) => (
        <div class="mb-capstone-badge">
          <h3>
            <span aria-hidden="true">{cov.badgeIcon}</span>{" "}
            <a href={`/merit-badges/${cov.badgeSlug}/`}>{cov.badgeTitle}</a>
          </h3>
          <p class="muted">{cov.note}</p>
          <ul class="mb-capstone-items">
            {cov.items.map((it) => (
              <li>
                <span class="mb-req-num">{it.id}.</span>{" "}
                <strong>{it.title}</strong>
                {it.text && <div class="mb-capstone-item-text">{it.text}</div>}
                {it.note && <div class="mb-capstone-item-note">Counselor note: {it.note}</div>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section aria-labelledby="detail-title" class="mb-section mb-capstone">
      <h2 id="detail-title">Project Details</h2>
      {capstone.detailSections.map((s) => (
        <div class="mb-capstone-block">
          <h3>{s.heading}</h3>
          {s.body && <p>{s.body}</p>}
          {s.list && (
            <ul>
              {s.list.map((item) => <li>{item}</li>)}
            </ul>
          )}
          {s.footer && <p class="muted">{s.footer}</p>}
        </div>
      ))}
    </section>

    {brainstorm && (
      <section aria-labelledby="brainstorm-title" class="mb-section">
        <h2 id="brainstorm-title">Starting Ideas — Interactive Brainstorm</h2>
        <BrainstormMatrix
          id={brainstorm.id}
          title={brainstorm.title}
          intro={brainstorm.intro}
          xAxis={brainstorm.xAxis}
          yAxis={brainstorm.yAxis}
          ideas={brainstorm.ideas}
        />
      </section>
    )}

    {showRocketCalc && (
      <section aria-labelledby="rocketcalc-title" class="mb-section">
        <h2 id="rocketcalc-title">Rocket Sizing Sandbox</h2>
        <RocketCalculator />
      </section>
    )}

    {showPatrolBox3D && (
      <section aria-labelledby="pb3d-title" class="mb-section">
        <h2 id="pb3d-title">3D Reference Model</h2>
        <PatrolBox3D />
      </section>
    )}

    {capstone.schedule && (
      <section aria-labelledby="schedule-title" class="mb-section">
        <h2 id="schedule-title">Schedule &amp; Time Commitment</h2>
        <p>
          <strong>Total time:</strong> about {capstone.schedule.totalHours} hours of counselor time.
        </p>
        <p>{capstone.schedule.overview}</p>
        <table class="mb-schedule">
          <thead>
            <tr>
              <th>Session</th>
              <th>Hours</th>
              <th>Focus</th>
            </tr>
          </thead>
          <tbody>
            {capstone.schedule.sessions.map((s) => (
              <tr>
                <td>{s.day}</td>
                <td>{s.hours}</td>
                <td>{s.focus}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    <section class="mb-section">
      <p>
        Interested in running this capstone with a Scout? <a href="/contact/">Get in touch</a> or
        go back to the <a href="/merit-badges/">Merit Badge Counselor page</a>.
      </p>
    </section>
  </article>
</BaseLayout>
