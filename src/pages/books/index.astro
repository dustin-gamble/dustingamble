---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCard from "../../components/BookCard.astro";
import { getBooks } from "../../lib/content";

const books = getBooks();
---
<BaseLayout
  title="Books"
  description="Books by Dustin Gamble: Drone Field Guide, out now in paperback; in progress, AI Fusion, Drone Sketchbook, Drone Mechanisms, Drone Underway, Drone Overland, and an Expeditionary Force fan story."
>
  <section class="prose section-block">
    <h1>Books</h1>
    <p>
      My books, one out and the rest in progress — a series of practical engineering books for small
      unmanned machines (the Drone Field Guide for aircraft, now in paperback; two companions of aircraft
      ideas and parts; and field guides for boats and for ground vehicles), a near-future novel, and a
      fan-fiction tribute. Covers, summaries, and a few samples below. None of these are the whole book.
    </p>
  </section>

  <section class="section-block" aria-label="Books">
    <div class="book-grid">
      {books.map((book) => <BookCard book={book} />)}
    </div>
  </section>
</BaseLayout>
