---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCard from "../../components/BookCard.astro";
import BookFan from "../../components/BookFan.astro";
import { getBooks } from "../../lib/content";

const books = getBooks();
---
<BaseLayout
  title="Books"
  description="Books by Dustin Gamble: Drone Field Guide, Drone Sketchbook and Drone Mechanisms, out now in paperback; in progress, the rest of the Drone Field Guide collection, the novel AI Fusion, and an Expeditionary Force fan story."
>
  <section class="prose section-block">
    <h1>Books</h1>
    <p>
      My books, three out and the rest in progress — a series of practical engineering books for small
      unmanned machines (the Drone Field Guide for aircraft and nine companions; the Field Guide, the
      Sketchbook and Mechanisms are in paperback now), a near-future novel, and a fan-fiction tribute. Covers, summaries, and a few samples below. None of
      these are the whole book.
    </p>
  </section>

  <section class="section-block" aria-label="The Drone Field Guide collection">
    <BookFan />
  </section>

  <section class="section-block" aria-label="Books">
    <div class="book-grid">
      {books.map((book) => <BookCard book={book} />)}
    </div>
  </section>
</BaseLayout>
